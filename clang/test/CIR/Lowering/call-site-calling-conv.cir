// RUN: cir-opt %s -cir-to-llvm -o - | FileCheck %s

// A direct call takes the callee's calling convention. A plain C call to a
// spir_func definition is undefined behavior that the optimizer folds away.

!s32i = !cir.int<s, 32>
module {
  cir.func @callee(%arg0: !s32i) -> !s32i cc(spir_function) {
    cir.return %arg0 : !s32i
  }
  // CHECK-LABEL: llvm.func spir_kernelcc @kernel
  // CHECK: llvm.call spir_funccc @callee
  cir.func @kernel(%arg0: !s32i) cc(spir_kernel) {
    %0 = cir.call @callee(%arg0) : (!s32i) -> !s32i
    cir.return
  }
}
