// RUN: cir-opt %s -cir-points-to-verify -test-cir-points-to='mode=bu sycl=1 closed-tu=1 subobjects=1' -o /dev/null 2>&1 | FileCheck %s --check-prefixes=CHECK,BU
// RUN: cir-opt %s -cir-points-to-verify -test-cir-points-to='mode=ci sycl=1 closed-tu=1' -o /dev/null 2>&1 | FileCheck %s
//
// Corpus T29 N (T27): the elements of one container are one array node (a
// cir.ptr_stride of the vector's heap storage), so two accessors to v[0] and
// v[1], or two USM pointers read from p[0] and p[1], are the same memory,
// never noalias:
//  - KVEC: a vector of three buffers built in a loop (emplace_back's shape),
//    accessors to v[0] and v[1]: one handle node, one storage;
//  - KUSMVEC: two USM allocations from one site in a loop, kept in a
//    vector<float *>;
//  - KUSMTWO: two allocation sites, stored at p[0] and p[1]: the stores to
//    one array node merge them;
//  - KCTRL: positive control, two local buffers: noalias.
// Context-insensitively the vec<> members of the three vectors merge too
// (one constructor), so the storages are also unknown there.
//
// The input is generated by /localdisk3/kparasyr/ipo-aa/t27/tests/neg/gen.py
// from containers.cpp (a reduced SYCL host API, sycl-mock.h, and a reduced
// std::vector: a heap array reached by index):
//
//   vec<buffer<float, 1>> v;
//   for (int i = 0; i < 3; ++i)
//     role_buffer_alloc(&v[i], r);
//   role_submit(&q, [&](handler &h) {
//     accessor<float, 1> a, b;
//     role_accessor_from_buffer(&a, &v[0], &h);
//     role_accessor_from_buffer(&b, &v[1], &h);
//     role_parallel_for<KVEC>(&h, [=] { (void)a, (void)b; });
//   });
//   vec<float *> p;
//   for (int i = 0; i < 2; ++i)
//     p.push_back(role_usm_alloc(N, &q));
//   float *p0 = p[0], *p1 = p[1];           // KUSMVEC captures p0, p1
//   vec<float *> u;
//   u.push_back(role_usm_alloc(N, &q));
//   u.push_back(role_usm_alloc(N, &q));
//   float *u0 = u[0], *u1 = u[1];           // KUSMTWO captures u0, u1
//   buffer<float, 1> c, d;                  // KCTRL: accessors ca, da

// CHECK-LABEL: === launches
// CHECK:        kernel _ZTS4KVEC
// BU-NEXT:        field a accessor storage=[[S:n[0-9]+]]+0 [Ghost|External|Summary|Ref] origins=1 host=none complete
// BU-NEXT:        field b accessor storage=[[S]]+0 [Ghost|External|Summary|Ref] origins=1 host=none complete
// CHECK:          same a b
// CHECK-NEXT:     no-alias{{$}}
// CHECK:        kernel _ZTS7KUSMVEC
// BU-NEXT:        field p0 pointer target=[[P:n[0-9]+]]+0 [Heap|External|Summary|Ref|HasUSM] complete
// BU-NEXT:        field p1 pointer target=[[P]]+0 [Heap|External|Summary|Ref|HasUSM] complete
// CHECK:          same p0 p1
// CHECK-NEXT:     no-alias{{$}}
// CHECK:        kernel _ZTS7KUSMTWO
// BU-NEXT:        field u0 pointer target=[[U:n[0-9]+]]+0 [Heap|External|Summary|Ref|HasUSM] complete
// BU-NEXT:        field u1 pointer target=[[U]]+0 [Heap|External|Summary|Ref|HasUSM] complete
// CHECK:          same u0 u1
// CHECK-NEXT:     no-alias{{$}}
// CHECK:        kernel _ZTS5KCTRL
// CHECK-NEXT:     field ca accessor storage={{n[0-9]+}}+0 [Ghost|External|Ref] origins=1 host=none complete
// CHECK-NEXT:     field da accessor storage={{n[0-9]+}}+0 [Ghost|External|Ref] origins=1 host=none complete
// CHECK-NEXT:     no-alias ca da
// CHECK: kernel _ZTS4KVEC: no-alias{{$}}
// CHECK: kernel _ZTS7KUSMVEC: no-alias{{$}}
// CHECK: kernel _ZTS7KUSMTWO: no-alias{{$}}
// CHECK: kernel _ZTS5KCTRL: no-alias ca da

