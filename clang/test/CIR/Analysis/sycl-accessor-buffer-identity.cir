// RUN: cir-opt %s -split-input-file \
// RUN:   -pass-pipeline="builtin.module(test-print-kernel-bindings)" \
// RUN:   -o /dev/null 2>&1 | FileCheck %s
// RUN: cir-opt %s -split-input-file -cir-points-to-verify \
// RUN:   -pass-pipeline="builtin.module(test-print-kernel-bindings{host-facts=ipo})" \
// RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=IPO
// RUN: cir-opt %s -split-input-file -cir-points-to-verify \
// RUN:   -pass-pipeline="builtin.module(test-print-kernel-bindings{host-facts=ipo closed-tu=1})" \
// RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=IPO

// Host-side memory identity of SYCL accessor and USM kernel captures, read by
// KernelBindingTable and printed per kernel: the noalias fields, and for every
// candidate field the memory it resolved to or why it was rejected. Each case
// launches one lambda kernel through the direct path; the host buffer and
// accessor API is reduced to declarations carrying the roles CIRGen tags them
// with (cir.sycl_host_api), and the device kernel to its signature, whose
// cir.sycl_kernel_param attributes name the closure field behind each
// parameter.
//
// The prefix IPO checks the same cases under --cir-offload-host-facts=ipo
// (SYCLHostFacts on the points-to analysis), open and closed-TU (the
// launches are in main, so the two agree). The inputs also carry the roles
// CIRGen gives the launch glue, the USM allocation and getDeviceKernelInfo,
// and a body for std::vector::data, which points-to analyses rather than
// models; the legacy output is the same without them. IPO agrees with the
// legacy verdicts on every case but DISTINCT HOST MEMORY, where it is
// stricter (explained there); it is never looser.

// -----
// DISTINCT: three local buffers, each accessed once.
// buffer(range) buffers own fresh storage, so the three accessors are pairwise
// no-alias; the accessors are built both ways (constructor and get_access).

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!f32 = !cir.float
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_buf = !cir.struct<class "sycl::_V1::buffer<float, 1>" {data !cir.ptr<!s8i>, data !u64i}>
!rec_acc = !cir.struct<class "sycl::_V1::accessor<float, 1>" {data !cir.ptr<!s8i>, data !u64i}>
!rec_range = !cir.struct<class "sycl::_V1::range<1>" {data !u64i}>
!rec_vec = !cir.struct<class "std::vector<float>" {data !cir.ptr<!f32>, data !cir.ptr<!f32>, data !cir.ptr<!f32>}>
!rec_hkrbase = !cir.struct<"hkrbase" {data !u64i}>
!rec_view = !cir.struct<"view" {data !cir.ptr<!u64i>, data !u64i}>
!rec_lam = !cir.struct<"lam" {data !rec_acc, data !rec_acc, data !rec_acc}>
!rec_hkr = !cir.struct<"hkr" {data !rec_hkrbase, data !cir.ptr<!rec_lam>}>

