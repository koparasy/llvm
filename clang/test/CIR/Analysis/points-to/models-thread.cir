// RUN: cir-opt %s -test-cir-points-to='mode=ci closed-tu=1 values=1' -cir-points-to-verify -o /dev/null | FileCheck %s --check-prefixes=CHECK,CI
// RUN: cir-opt %s -test-cir-points-to='mode=bu closed-tu=1 subobjects=1 values=1' -cir-points-to-verify -o /dev/null | FileCheck %s --check-prefixes=CHECK,BU
// RUN: cir-opt %s -test-cir-points-to='mode=ci values=1' -cir-points-to-verify -o /dev/null | FileCheck %s --check-prefix=OPEN
//
// The std::thread model (T27). libstdc++'s std::thread constructor stores the
// callable in a heap _State_impl and hands it to the out-of-line
// _M_start_thread, which runs `state->_M_run()` on the new thread and then
// deletes the state. The model gives that call two virtual calls on the
// state, _M_run (slot 2) and the deleting destructor (slot 1), resolved from
// the vtable of the complete state object, and makes everything the state
// reaches AsyncAccess: the thread runs concurrently with spawn() until the
// join. _State's constructor and destructor are modelled (no link from the
// vptr to _State's own vtable, which would merge every _State_impl's vtable).
//
// The thread reads x through the captured px: x and px are AsyncAccess, so
// the read of x in the thread is not a constant (spawn() may store x after
// the spawn). y is not captured: its read after the join is strong.
// Without closed-tu the vtable's functions may be called from unknown code,
// so the slot nodes are Incomplete and the two calls get the unknown-call
// rule, as the declaration did before the model.
//
// The input is clang -fclangir -emit-cir -O0 of this reduced libstdc++
// (the same classes, members and manglings), with the target attributes and
// locations dropped:
//
//   namespace std {
//   template <class T> struct default_delete {
//     void operator()(T *p) const { delete p; }
//   };
//   template <class T, class D = default_delete<T>> struct unique_ptr {
//     T *p;
//     explicit unique_ptr(T *q) : p(q) {}
//     ~unique_ptr() { if (p) D()(p); }
//   };
//   class thread {
//   public:
//     struct _State {
//       virtual ~_State();
//       virtual void _M_run() = 0;
//     };
//     template <class F> struct _State_impl : _State {
//       F f;
//       _State_impl(F g) : f(g) {}
//       void _M_run() override { f(); }
//     };
//     template <class F> explicit thread(F f) {
//       _M_start_thread(unique_ptr<_State>(new _State_impl<F>(f)), nullptr);
//     }
//     void join();
//     unsigned long id;
//   private:
//     void _M_start_thread(unique_ptr<_State>, void (*)());
//   };
//   } // namespace std
//   void use(int *);
//   void spawn() {
//     int x = 1;
//     int y = 2;
//     int *px = &x;
//     std::thread t([&] {
//       int v = *px;        // xread
//       use(&v);
//     });
//     y = 3;
//     t.join();
//     int ry = y;           // ry
//     use(&ry);
//   }

// CHECK-LABEL: === TU graph
// CHECK-DAG: [[PX:n[0-9]+]] [Stack|Mod|Ref|AsyncAccess] size=8 origins={stack(cir.alloca 'px' {{.*}})} links={0->[[X:n[0-9]+]]+0} reasons={AsyncAccess: {{.*}}"accessed by another thread (std::thread)")}
// CHECK-DAG: [[X]] [Stack|Mod|Ref|AsyncAccess] size=4 origins={stack(cir.alloca 'x' {{.*}})} links={}
// CHECK-DAG: {{n[0-9]+}} [Stack|Mod|Ref] size=4 origins={stack(cir.alloca 'y' {{.*}})} links={}
// CHECK-LABEL: === calls
// CHECK-DAG: @_ZNSt6threadC2IZ5spawnvE3$_0EET_ cir.call @_ZNSt6thread15_M_start_threadESt10unique_ptrINS_6_StateESt14default_deleteIS1_EEPFvvE -> model std-thread-start
// CI-DAG: @_ZNSt6threadC2IZ5spawnvE3$_0EET_ cir.call synthetic -> indirect -> {@_ZNSt6thread11_State_implIZ5spawnvE3$_0E6_M_runEv}
// CI-DAG: @_ZNSt6threadC2IZ5spawnvE3$_0EET_ cir.call synthetic -> indirect -> {@_ZNSt6thread11_State_implIZ5spawnvE3$_0ED0Ev}
// BU-DAG: @_ZNSt6threadC2IZ5spawnvE3$_0EET_ cir.call synthetic -> indirect -> {@_ZNSt6thread11_State_implIZ5spawnvE3$_0E6_M_runEv} [@_ZNSt6thread11_State_implIZ5spawnvE3$_0E6_M_runEv clone #{{[0-9]+}}]
// BU-DAG: @_ZNSt6threadC2IZ5spawnvE3$_0EET_ cir.call synthetic -> indirect -> {@_ZNSt6thread11_State_implIZ5spawnvE3$_0ED0Ev} [@_ZNSt6thread11_State_implIZ5spawnvE3$_0ED0Ev clone #{{[0-9]+}}]
// BU-DAG: @_Z5spawnv cir.call in @_ZNSt6threadC2IZ5spawnvE3$_0EET_ prefix=#{{[0-9]+}} -> indirect -> {@_ZNSt6thread11_State_implIZ5spawnvE3$_0E6_M_runEv}
// CHECK-DAG: @_ZNSt6thread11_State_implIZ5spawnvE3$_0EC2ES1_ cir.call @_ZNSt6thread6_StateC2Ev -> model std-thread-state-ctor
// CHECK-DAG: @_ZNSt6thread11_State_implIZ5spawnvE3$_0ED2Ev cir.call @_ZNSt6thread6_StateD2Ev -> model std-thread-state-dtor
// CHECK-LABEL: === values
// CHECK-NEXT: ry: {#cir.int<3> : !cir.int<s, 32>} defs=0 complete strong
// CHECK-NEXT: xread: {#cir.int<1> : !cir.int<s, 32>} defs=0 incomplete (EscapedTo, "written by code we don't see (AsyncAccess)"){{( contexts=1)?}} weak
//
// OPEN-LABEL: === calls
// OPEN: @_ZNSt6threadC2IZ5spawnvE3$_0EET_ cir.call synthetic -> indirect-unresolved (IndirectUnresolved, "callee node is Incomplete")
// OPEN: @_ZNSt6threadC2IZ5spawnvE3$_0EET_ cir.call synthetic -> indirect-unresolved (IndirectUnresolved, "callee node is Incomplete")
// OPEN-LABEL: === values
// OPEN-NEXT: ry: {#cir.int<2> : !cir.int<s, 32>, #cir.int<3> : !cir.int<s, 32>} defs=0 complete weak
// OPEN-NEXT: xread: {} defs=0 incomplete

