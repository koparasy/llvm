// RUN: cir-opt %s -test-cir-points-to-instrument='table=%t.table print-candidates=1' -o %t.cir
// RUN: FileCheck %s --input-file=%t.table
// RUN: cir-translate --cir-to-llvmir %t.cir -o /dev/null

// A cir.goto has no successor until the goto solver runs, so DominanceInfo
// does not see the edges into a label: code before the label looks as if it
// dominated the code after it, though the goto bypasses it. The instrumenter
// must not place a check whose operand is made on a path the goto skips (V4:
// Csmith seeds 1027 and 1039 failed to lower with "operand #0 does not
// dominate this use"). The last RUN line lowers the instrumented module,
// which runs the goto solver and verifies dominance on the real CFG.
//
// @after_label (the shape of the V4 seeds):
//   if (c) goto lbl;  g = -7;  lbl: return g;
// The store's address (its get_global) is made in ^bb0, which the goto
// skips: the MustAlias pair of the two get_globals has no check point after
// the label (it used to get one at the load there). The accesses after the
// label are still paired with each other and with the entry block's allocas.
// CHECK-NOT: must
// CHECK: @after_label distinct-objects load(cir.get_global @g@{{[^ ]*}}) 4 | store(cir.alloca '__retval'@{{.*}}) 4 at cir.store
// CHECK-NOT: must
//
// @label_in_scope: the label is in a scope between the definition and the
// check point, in the same block: `if (c) goto lbl; g = -7; { lbl: ; }
// return g;`. No check after the scope uses the address made before it.
// CHECK-NOT: must
// CHECK: @label_in_scope distinct-objects load(cir.get_global @g@{{[^ ]*}}) 4 | store(cir.alloca '__retval'@{{.*}}) 4 at cir.store
// CHECK-NOT: must
// CHECK: # functions 3 candidates 20 noalias 20 checks 20 must 0

!s32i = !cir.int<s, 32>
module attributes {cir.int_type_width = 32 : i32, cir.size_type_width = 64 : i32} {
cir.global "private" internal dso_local @g = #cir.int<0> : !s32i
cir.func internal @after_label(%arg0: !s32i) -> !s32i {
  %0 = cir.alloca "c" align(4) init : !cir.ptr<!s32i>
  %1 = cir.alloca "__retval" align(4) : !cir.ptr<!s32i>
  cir.store %arg0, %0 : !s32i, !cir.ptr<!s32i>
  cir.scope {
    %7 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
    %8 = cir.cast int_to_bool %7 : !s32i -> !cir.bool
    cir.if %8 {
      cir.goto "lbl"
    }
  }
  %2 = cir.const #cir.int<-7> : !s32i
  %3 = cir.get_global @g : !cir.ptr<!s32i>
  cir.store align(4) %2, %3 : !s32i, !cir.ptr<!s32i>
  cir.br ^bb1
^bb1:
  cir.label "lbl"
  %4 = cir.get_global @g : !cir.ptr<!s32i>
  %5 = cir.load align(4) %4 : !cir.ptr<!s32i>, !s32i
  cir.store %5, %1 : !s32i, !cir.ptr<!s32i>
  %6 = cir.load %1 : !cir.ptr<!s32i>, !s32i
  cir.return %6 : !s32i
}
cir.func internal @label_in_scope(%arg0: !s32i) -> !s32i {
  %0 = cir.alloca "c" align(4) init : !cir.ptr<!s32i>
  %1 = cir.alloca "__retval" align(4) : !cir.ptr<!s32i>
  cir.store %arg0, %0 : !s32i, !cir.ptr<!s32i>
  cir.scope {
    %7 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
    %8 = cir.cast int_to_bool %7 : !s32i -> !cir.bool
    cir.if %8 {
      cir.goto "lbl"
    }
  }
  %2 = cir.const #cir.int<-7> : !s32i
  %3 = cir.get_global @g : !cir.ptr<!s32i>
  cir.store align(4) %2, %3 : !s32i, !cir.ptr<!s32i>
  cir.scope {
    cir.label "lbl"
  }
  %4 = cir.get_global @g : !cir.ptr<!s32i>
  %5 = cir.load align(4) %4 : !cir.ptr<!s32i>, !s32i
  cir.store %5, %1 : !s32i, !cir.ptr<!s32i>
  %6 = cir.load %1 : !cir.ptr<!s32i>, !s32i
  cir.return %6 : !s32i
}
cir.func @main() -> !s32i {
  %c1 = cir.const #cir.int<1> : !s32i
  %c0 = cir.const #cir.int<0> : !s32i
  %a = cir.call @after_label(%c1) : (!s32i) -> !s32i
  %b = cir.call @after_label(%c0) : (!s32i) -> !s32i
  %c = cir.call @label_in_scope(%c1) : (!s32i) -> !s32i
  %d = cir.call @label_in_scope(%c0) : (!s32i) -> !s32i
  cir.return %a : !s32i
}
}
