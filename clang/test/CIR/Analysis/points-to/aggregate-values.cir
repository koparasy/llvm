// RUN: cir-opt %s -test-cir-points-to -o /dev/null | FileCheck %s

// Every aggregate SSA value that holds pointers has slot records, whatever
// produced it, so storing it links what it carries. The test pass verifies
// that (PointsToVerifier) for every function below.

!s32i = !cir.int<s, 32>
!rec_S = !cir.struct<"S" {data !cir.ptr<!s32i>, data !s32i, data !cir.ptr<!s32i>}>

cir.func private @make() -> !rec_S
cir.func private @take(!rec_S)

// A call returning a record by value: fresh slot nodes, recorded on the
// call-site record; storing the result links them.

// CHECK-LABEL: === @call_result
// CHECK-DAG: [[DST:n[0-9]+]] [Stack|Mod] size=24 origins={stack(cir.alloca 'dst' {{.*}})} links={0->[[T0:n[0-9]+]]+0, 16->[[T1:n[0-9]+]]+0}
// CHECK-DAG: call cir.call @make args={} result=null result.slots={0: [[T0]]+0, 16: [[T1]]+0}
// CHECK-DAG: v -> {0: [[T0]]+0, 16: [[T1]]+0}
cir.func @call_result() {
  %dst = cir.alloca "dst" align(8) : !cir.ptr<!rec_S>
  %v = cir.call @make() : () -> !rec_S
  %v_tag = cir.freeze %v : !rec_S {test.ptr = "v"}
  cir.store %v, %dst : !rec_S, !cir.ptr<!rec_S>
  cir.return
}

// insert_member replaces the member's slot; extract_member reads a slot.
// The record starts as #cir.zero: null slots that link nothing.

// CHECK-LABEL: === @insert_extract
// CHECK-DAG: [[A:n[0-9]+]] [Stack] size=4 origins={stack(cir.alloca 'a' {{.*}})} links={}
// CHECK-DAG: [[DST:n[0-9]+]] [Stack|Mod] size=24 origins={stack(cir.alloca 'dst' {{.*}})} links={16->[[A]]+0}
// CHECK-DAG: zero -> {0: null, 16: null}
// CHECK-DAG: ins -> {0: null, 16: [[A]]+0}
// CHECK-DAG: ext -> [[A]]+0
// CHECK-DAG: call cir.call @take args={} result=null slots={0: {0: null, 16: [[A]]+0}}
cir.func @insert_extract() {
  %a = cir.alloca "a" align(4) : !cir.ptr<!s32i>
  %dst = cir.alloca "dst" align(8) : !cir.ptr<!rec_S>
  %zero = cir.const #cir.zero : !rec_S
  %zero_tag = cir.freeze %zero : !rec_S {test.ptr = "zero"}
  %ins = cir.insert_member %zero[2], %a : !rec_S, !cir.ptr<!s32i>
  %ins_tag = cir.freeze %ins : !rec_S {test.ptr = "ins"}
  %ext = cir.extract_member %ins[2] : !rec_S -> !cir.ptr<!s32i>
  %ext_tag = cir.cast bitcast %ext : !cir.ptr<!s32i> -> !cir.ptr<!s32i> {test.ptr = "ext"}
  cir.store %ins, %dst : !rec_S, !cir.ptr<!rec_S>
  cir.call @take(%ins) : (!rec_S) -> ()
  cir.return
}

// A constant record holding a global_view: the slot points to the global's
// node, the null slot to nothing.

// CHECK-LABEL: === @const_record
// CHECK-DAG: [[G:n[0-9]+]] [Global] size=4 origins={global(@g)} links={}
// CHECK-DAG: [[DST:n[0-9]+]] [Stack|Mod] size=24 origins={stack(cir.alloca 'dst' {{.*}})} links={0->[[G]]+0}
cir.global "private" internal @g = #cir.int<0> : !s32i
cir.func @const_record() {
  %dst = cir.alloca "dst" align(8) : !cir.ptr<!rec_S>
  %c = cir.const #cir.const_record<{#cir.global_view<@g> : !cir.ptr<!s32i>, #cir.int<1> : !s32i, #cir.ptr<null> : !cir.ptr<!s32i>}> : !rec_S
  cir.store %c, %dst : !rec_S, !cir.ptr<!rec_S>
  cir.return
}

// Aggregate block arguments and region results unify slot by slot with
// what flows into them.

// CHECK-LABEL: === @block_args
// CHECK-DAG: [[AB:n[0-9]+]] [Stack] size=4 origins={stack(cir.alloca 'a' {{.*}}), stack(cir.alloca 'b' {{.*}})} links={}
// CHECK-DAG: [[DST:n[0-9]+]] [Stack|Mod] size=24 origins={stack(cir.alloca 'dst' {{.*}})} links={0->[[AB]]+0, 16->[[T:n[0-9]+]]+0}
cir.func @block_args(%c: !cir.bool) {
  %a = cir.alloca "a" align(4) : !cir.ptr<!s32i>
  %b = cir.alloca "b" align(4) : !cir.ptr<!s32i>
  %dst = cir.alloca "dst" align(8) : !cir.ptr<!rec_S>
  %zero = cir.const #cir.zero : !rec_S
  %va = cir.insert_member %zero[0], %a : !rec_S, !cir.ptr<!s32i>
  %vb = cir.insert_member %zero[0], %b : !rec_S, !cir.ptr<!s32i>
  cir.brcond %c ^bb1(%va : !rec_S), ^bb1(%vb : !rec_S)
^bb1(%m: !rec_S):
  cir.store %m, %dst : !rec_S, !cir.ptr<!rec_S>
  cir.return
}

// CHECK-LABEL: === @region_result
// CHECK-DAG: [[AB:n[0-9]+]] [Stack] size=4 origins={stack(cir.alloca 'a' {{.*}}), stack(cir.alloca 'b' {{.*}})} links={}
// CHECK-DAG: [[DST:n[0-9]+]] [Stack|Mod] size=24 origins={stack(cir.alloca 'dst' {{.*}})} links={0->[[AB]]+0, 16->{{n[0-9]+}}+0}
// CHECK-DAG: sel -> {0: [[AB]]+0, 16: {{n[0-9]+}}+0}
cir.func @region_result(%c: !cir.bool) {
  %a = cir.alloca "a" align(4) : !cir.ptr<!s32i>
  %b = cir.alloca "b" align(4) : !cir.ptr<!s32i>
  %dst = cir.alloca "dst" align(8) : !cir.ptr<!rec_S>
  %zero = cir.const #cir.zero : !rec_S
  %va = cir.insert_member %zero[0], %a : !rec_S, !cir.ptr<!s32i>
  %vb = cir.insert_member %zero[0], %b : !rec_S, !cir.ptr<!s32i>
  %r = cir.scope {
    cir.yield %va : !rec_S
  } : !rec_S
  %s = cir.select if %c then %r else %vb : (!cir.bool, !rec_S, !rec_S) -> !rec_S
  %s_tag = cir.freeze %s : !rec_S {test.ptr = "sel"}
  cir.store %s, %dst : !rec_S, !cir.ptr<!rec_S>
  cir.return
}

// An aggregate formal gets fresh Incomplete slot nodes.

// CHECK-LABEL: === @formal
// CHECK-DAG: [[F0:n[0-9]+]] [Incomplete] size=0 origins={} links={} reasons={Incomplete: UnknownCaller(cir.func {{.*}}, "formal #0")}
// CHECK-DAG: [[DST:n[0-9]+]] [Stack|Mod] size=24 origins={stack(cir.alloca 'dst' {{.*}})} links={0->[[F0]]+0, 16->{{n[0-9]+}}+0}
// CHECK-DAG: formal #0 -> {0: [[F0]]+0, 16: {{n[0-9]+}}+0}
// CHECK-DAG: return -> {0: [[F0]]+0, 16: {{n[0-9]+}}+0}
cir.func @formal(%s: !rec_S) -> !rec_S {
  %dst = cir.alloca "dst" align(8) : !cir.ptr<!rec_S>
  cir.store %s, %dst : !rec_S, !cir.ptr<!rec_S>
  cir.return %s : !rec_S
}
