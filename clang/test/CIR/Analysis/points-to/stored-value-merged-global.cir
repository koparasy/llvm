// RUN: cir-opt %s -test-cir-points-to='mode=ci values=1 print-graphs=0' -cir-points-to-verify -o /dev/null | FileCheck %s
// RUN: cir-opt %s -test-cir-points-to='mode=bu values=1 print-graphs=0' -cir-points-to-verify -o /dev/null | FileCheck %s
// RUN: cir-opt %s -test-cir-points-to='mode=bu closed-tu=1 subobjects=1 values=1 print-graphs=0' -cir-points-to-verify -o /dev/null | FileCheck %s

// A global unified into another global's node (V4fix, Csmith seed 100570):
//   static short g = 4; static struct S { long a; short b; long c; } s =
//   {7, 3, 9}; static short *p = &s.b; ... if (c) p = &g; ... = g;
// p's pointee unifies g with s.b: g's storage starts at offset 8 of s's
// node. Its initializer is a write there, not at offset 0 (where it used to
// be put, so that a read of g saw only s.b's 3 and was called constant 3,
// and a read of s.a overlapped g's 4 and was incomplete).
// CHECK-LABEL: === values
// CHECK-NEXT: g: {#cir.int<4> : !cir.int<s, 16>, #cir.int<3> : !cir.int<s, 16>} defs=0 complete
// CHECK-NEXT: s.a: {#cir.int<7> : !cir.int<s, 64>} defs=0 complete

!s16i = !cir.int<s, 16>
!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>
!rec_S = !cir.struct<"S" {data !s64i, data !s16i, data !s64i}>
module attributes {cir.int_type_width = 32 : i32, cir.size_type_width = 64 : i32} {
cir.global "private" internal dso_local @g = #cir.int<4> : !s16i
cir.global "private" internal dso_local @s = #cir.const_record<{#cir.int<7> : !s64i, #cir.int<3> : !s16i, #cir.int<9> : !s64i}> : !rec_S
cir.global "private" internal dso_local @p = #cir.global_view<@s, [1 : i32]> : !cir.ptr<!s16i>
cir.func @main(%c: !cir.bool) -> !s16i {
  cir.if %c {
    %g = cir.get_global @g : !cir.ptr<!s16i>
    %p = cir.get_global @p : !cir.ptr<!cir.ptr<!s16i>>
    cir.store %g, %p : !cir.ptr<!s16i>, !cir.ptr<!cir.ptr<!s16i>>
  }
  %g2 = cir.get_global @g : !cir.ptr<!s16i>
  %v = cir.load %g2 : !cir.ptr<!s16i>, !s16i {test.load = "g"}
  %s = cir.get_global @s : !cir.ptr<!rec_S>
  %a = cir.get_member %s[0] {name = "a"} : !cir.ptr<!rec_S> -> !cir.ptr<!s64i>
  %va = cir.load %a : !cir.ptr<!s64i>, !s64i {test.load = "s.a"}
  cir.return %v : !s16i
}
}
