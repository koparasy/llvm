// RUN: cir-opt %s -test-cir-points-to='mode=ci values=1 print-graphs=0' -cir-points-to-verify -o /dev/null | FileCheck %s
// RUN: cir-opt %s -test-cir-points-to='mode=bu closed-tu=1 subobjects=1 values=1 print-graphs=0' -cir-points-to-verify -o /dev/null | FileCheck %s
// RUN: cir-opt %s -test-cir-points-to='mode=ci values=1 strong-updates=0 print-graphs=0' -cir-points-to-verify -o /dev/null | FileCheck %s --check-prefix=WEAK

// Stored values at a load, strong updates (T24): a local of the function
// whose every write is an op of the function gets the value of the one store
// that must have written the bytes last before the load ("strong"), found by
// a backward walk over the structured CIR. Otherwise the answer is the union
// of every write ("weak").
//  - store 1; store 2; load: {2}.
//  - a store in one branch of an if: {1, 2}.
//  - a store in a loop body read after the loop: {1, 2}; with a store after
//    the loop that dominates the load: that store's value.
//  - a load in a loop body before the store of the body: {1, 2}; a loop that
//    does not write: the store before it.
//  - a load in a cir.scope or in the then-region of a cir.if after the store.
//  - a member: a store to the other member does not count.
//  - a function with a label: never strong (here a goto back to a label
//    between the store and the load bypasses the store).

// CHECK-LABEL: === values
// CHECK-NEXT: seq: {#cir.int<2> : !cir.int<s, 32>} defs=0 complete strong
// CHECK-NEXT: branch: {#cir.int<1> : !cir.int<s, 32>, #cir.int<2> : !cir.int<s, 32>} defs=0 complete weak
// CHECK-NEXT: loop.after: {#cir.int<1> : !cir.int<s, 32>, #cir.int<2> : !cir.int<s, 32>} defs=0 complete weak
// CHECK-NEXT: loop.final: {#cir.int<3> : !cir.int<s, 32>} defs=0 complete strong
// CHECK-NEXT: loop.inside: {#cir.int<1> : !cir.int<s, 32>, #cir.int<2> : !cir.int<s, 32>} defs=0 complete weak
// CHECK-NEXT: loop.invariant: {#cir.int<1> : !cir.int<s, 32>} defs=0 complete strong
// CHECK-NEXT: scope: {#cir.int<2> : !cir.int<s, 32>} defs=0 complete strong
// CHECK-NEXT: then: {#cir.int<2> : !cir.int<s, 32>} defs=0 complete strong
// CHECK-NEXT: member: {#cir.int<2> : !cir.int<s, 32>} defs=0 complete strong
// CHECK-NEXT: label: {#cir.int<1> : !cir.int<s, 32>, #cir.int<2> : !cir.int<s, 32>} defs=0 complete weak
//
// WEAK-LABEL: === values
// WEAK-NEXT: seq: {#cir.int<1> : !cir.int<s, 32>, #cir.int<2> : !cir.int<s, 32>} defs=0 complete weak
// WEAK: loop.final: {#cir.int<1> : !cir.int<s, 32>, #cir.int<2> : !cir.int<s, 32>, #cir.int<3> : !cir.int<s, 32>} defs=0 complete weak

!s32i = !cir.int<s, 32>
!rec_P = !cir.struct<"P" {data !s32i, data !s32i}>

module {
cir.func @seq() -> !s32i {
  %x = cir.alloca "x" align(4) : !cir.ptr<!s32i>
  %c1 = cir.const #cir.int<1> : !s32i
  %c2 = cir.const #cir.int<2> : !s32i
  cir.store %c1, %x : !s32i, !cir.ptr<!s32i>
  cir.store %c2, %x : !s32i, !cir.ptr<!s32i>
  %v = cir.load %x : !cir.ptr<!s32i>, !s32i {test.load = "seq"}
  cir.return %v : !s32i
}
cir.func @branch(%c: !cir.bool) -> !s32i {
  %x = cir.alloca "x" align(4) : !cir.ptr<!s32i>
  %c1 = cir.const #cir.int<1> : !s32i
  cir.store %c1, %x : !s32i, !cir.ptr<!s32i>
  cir.if %c {
    %c2 = cir.const #cir.int<2> : !s32i
    cir.store %c2, %x : !s32i, !cir.ptr<!s32i>
  }
  %v = cir.load %x : !cir.ptr<!s32i>, !s32i {test.load = "branch"}
  cir.return %v : !s32i
}
cir.func @loop_after(%c: !cir.bool) -> !s32i {
  %x = cir.alloca "x" align(4) : !cir.ptr<!s32i>
  %c1 = cir.const #cir.int<1> : !s32i
  cir.store %c1, %x : !s32i, !cir.ptr<!s32i>
  cir.while {
    cir.condition(%c)
  } do {
    %c2 = cir.const #cir.int<2> : !s32i
    cir.store %c2, %x : !s32i, !cir.ptr<!s32i>
    cir.yield
  }
  %v = cir.load %x : !cir.ptr<!s32i>, !s32i {test.load = "loop.after"}
  cir.return %v : !s32i
}
cir.func @loop_final(%c: !cir.bool) -> !s32i {
  %x = cir.alloca "x" align(4) : !cir.ptr<!s32i>
  %c1 = cir.const #cir.int<1> : !s32i
  cir.store %c1, %x : !s32i, !cir.ptr<!s32i>
  cir.while {
    cir.condition(%c)
  } do {
    %c2 = cir.const #cir.int<2> : !s32i
    cir.store %c2, %x : !s32i, !cir.ptr<!s32i>
    cir.yield
  }
  %c3 = cir.const #cir.int<3> : !s32i
  cir.store %c3, %x : !s32i, !cir.ptr<!s32i>
  %v = cir.load %x : !cir.ptr<!s32i>, !s32i {test.load = "loop.final"}
  cir.return %v : !s32i
}
cir.func @loop_inside(%c: !cir.bool) -> !s32i {
  %x = cir.alloca "x" align(4) : !cir.ptr<!s32i>
  %r = cir.alloca "r" align(4) : !cir.ptr<!s32i>
  %c1 = cir.const #cir.int<1> : !s32i
  cir.store %c1, %x : !s32i, !cir.ptr<!s32i>
  cir.while {
    cir.condition(%c)
  } do {
    %v = cir.load %x : !cir.ptr<!s32i>, !s32i {test.load = "loop.inside"}
    cir.store %v, %r : !s32i, !cir.ptr<!s32i>
    %c2 = cir.const #cir.int<2> : !s32i
    cir.store %c2, %x : !s32i, !cir.ptr<!s32i>
    cir.yield
  }
  %w = cir.load %r : !cir.ptr<!s32i>, !s32i
  cir.return %w : !s32i
}
cir.func @loop_invariant(%c: !cir.bool) -> !s32i {
  %x = cir.alloca "x" align(4) : !cir.ptr<!s32i>
  %r = cir.alloca "r" align(4) : !cir.ptr<!s32i>
  %c1 = cir.const #cir.int<1> : !s32i
  %c2 = cir.const #cir.int<2> : !s32i
  cir.store %c2, %r : !s32i, !cir.ptr<!s32i>
  cir.store %c1, %x : !s32i, !cir.ptr<!s32i>
  cir.while {
    cir.condition(%c)
  } do {
    %v = cir.load %x : !cir.ptr<!s32i>, !s32i {test.load = "loop.invariant"}
    cir.store %v, %r : !s32i, !cir.ptr<!s32i>
    cir.yield
  }
  %w = cir.load %r : !cir.ptr<!s32i>, !s32i
  cir.return %w : !s32i
}
cir.func @scope() -> !s32i {
  %x = cir.alloca "x" align(4) : !cir.ptr<!s32i>
  %r = cir.alloca "r" align(4) : !cir.ptr<!s32i>
  %c1 = cir.const #cir.int<1> : !s32i
  %c2 = cir.const #cir.int<2> : !s32i
  cir.store %c1, %x : !s32i, !cir.ptr<!s32i>
  cir.store %c2, %x : !s32i, !cir.ptr<!s32i>
  cir.scope {
    %v = cir.load %x : !cir.ptr<!s32i>, !s32i {test.load = "scope"}
    cir.store %v, %r : !s32i, !cir.ptr<!s32i>
  }
  %w = cir.load %r : !cir.ptr<!s32i>, !s32i
  cir.return %w : !s32i
}
cir.func @then(%c: !cir.bool) -> !s32i {
  %x = cir.alloca "x" align(4) : !cir.ptr<!s32i>
  %r = cir.alloca "r" align(4) : !cir.ptr<!s32i>
  %c1 = cir.const #cir.int<1> : !s32i
  %c2 = cir.const #cir.int<2> : !s32i
  cir.store %c1, %r : !s32i, !cir.ptr<!s32i>
  cir.store %c1, %x : !s32i, !cir.ptr<!s32i>
  cir.store %c2, %x : !s32i, !cir.ptr<!s32i>
  cir.if %c {
    %v = cir.load %x : !cir.ptr<!s32i>, !s32i {test.load = "then"}
    cir.store %v, %r : !s32i, !cir.ptr<!s32i>
  } else {
    cir.store %c1, %x : !s32i, !cir.ptr<!s32i>
  }
  %w = cir.load %r : !cir.ptr<!s32i>, !s32i
  cir.return %w : !s32i
}
cir.func @member() -> !s32i {
  %p = cir.alloca "p" align(4) : !cir.ptr<!rec_P>
  %a = cir.get_member %p[0] {name = "a"} : !cir.ptr<!rec_P> -> !cir.ptr<!s32i>
  %b = cir.get_member %p[1] {name = "b"} : !cir.ptr<!rec_P> -> !cir.ptr<!s32i>
  %c1 = cir.const #cir.int<1> : !s32i
  %c2 = cir.const #cir.int<2> : !s32i
  %c3 = cir.const #cir.int<3> : !s32i
  cir.store %c1, %a : !s32i, !cir.ptr<!s32i>
  cir.store %c2, %a : !s32i, !cir.ptr<!s32i>
  cir.store %c3, %b : !s32i, !cir.ptr<!s32i>
  %v = cir.load %a : !cir.ptr<!s32i>, !s32i {test.load = "member"}
  cir.return %v : !s32i
}
cir.func @label(%c: !cir.bool) -> !s32i {
  %x = cir.alloca "x" align(4) : !cir.ptr<!s32i>
  %c1 = cir.const #cir.int<1> : !s32i
  %c2 = cir.const #cir.int<2> : !s32i
  cir.store %c1, %x : !s32i, !cir.ptr<!s32i>
  cir.scope {
    cir.label "again"
  }
  %v = cir.load %x : !cir.ptr<!s32i>, !s32i {test.load = "label"}
  cir.store %c2, %x : !s32i, !cir.ptr<!s32i>
  cir.if %c {
    cir.goto "again"
  }
  cir.return %v : !s32i
}
}
