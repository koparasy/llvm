// RUN: cir-opt %s -test-cir-points-to='mode=ci closed-tu=1' -cir-points-to-verify -o /dev/null | FileCheck %s
// RUN: cir-opt %s -test-cir-points-to=mode=ci -cir-points-to-verify -o /dev/null | FileCheck %s --check-prefix=OPEN

// Reduced from polybench gemm (std::make_shared<sycl::buffer<float, 2>>):
// std::_Sp_counted_base::_M_release calls _M_dispose and _M_destroy through
// the vtable. The control block is made by operator new and constructed by
// the _Sp_counted_ptr_inplace constructor, which first runs the base
// constructor (storing the base vtable's address point into the vptr) and
// then stores its own. Flow-insensitively the vptr holds both, so the two
// vtables are unified slot by slot: _M_dispose (slot 2 after the address
// point) has the one target _Sp_counted_ptr_inplace::_M_dispose (the base's
// slot holds __cxa_pure_virtual, which GlobalNodes does not link: calling it
// is undefined); _M_destroy (slot 3) has both classes' _M_destroy. The bodies are bound with `this` = the control block.
// Everything is linkonce_odr, so only closed-tu makes the formals complete.

!s32i = !cir.int<s, 32>
!u8i = !cir.int<u, 8>
!u64i = !cir.int<u, 64>
!void = !cir.void
!rec_base = !cir.struct<class "std::_Sp_counted_base<__gnu_cxx::_S_atomic>" {data !cir.vptr, data !s32i, data !s32i}>
!rec_impl = !cir.struct<class "std::_Sp_counted_ptr_inplace<...>::_Impl" {data !cir.array<!u8i x 48>}>
!rec_inplace = !cir.struct<class "std::_Sp_counted_ptr_inplace<...>" {data !rec_base, data !rec_impl}>
!rec_vt = !cir.struct<{data !cir.array<!cir.ptr<!u8i> x 7>}>
!vfn = !cir.func<(!cir.ptr<!rec_base>)>

// CHECK-LABEL: === TU graph
// CHECK-DAG: [[CB:n[0-9]+]] [Heap|Mod|Ref] size=64 origins={heap(cir.call {{.*}})} links={0->[[VT:n[0-9]+]]+16}
// CHECK-DAG: [[VT]] [Global|Summary|Ref] size=56 origins={global(@_ZTVSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EE), global(@_ZTVSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EE)} links={16->{{n[0-9]+}}+0, 24->{{n[0-9]+}}+0, 32->[[DISPOSE:n[0-9]+]]+0, 40->[[DESTROY:n[0-9]+]]+0, 48->[[DELETER:n[0-9]+]]+0}
// CHECK-DAG: [[DISPOSE]] [Function] size=0 origins={func(@_ZNSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EE10_M_disposeEv)} links={}
// CHECK-DAG: [[DESTROY]] [Function|Summary] size=0 origins={func(@_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EE10_M_destroyEv), func(@_ZNSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EE10_M_destroyEv)} links={}
// CHECK-DAG: [[DELETER]] [Function] size=0 origins={func(@_ZNSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EE14_M_get_deleterERKSt9type_info)} links={}
// CHECK-LABEL: === @_ZNSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EE10_M_disposeEv formals=complete
// CHECK-NEXT: formal #0 -> [[CB]]+0
// CHECK-LABEL: === calls
// CHECK-DAG: @_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EE10_M_releaseEv cir.call -> indirect -> {@_ZNSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EE10_M_disposeEv}
// CHECK-DAG: @_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EE10_M_releaseEv cir.call -> indirect -> {@_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EE10_M_destroyEv, @_ZNSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EE10_M_destroyEv}

// Without closed-tu, _M_release's `this` is Incomplete (linkonce_odr: it may
// have callers in other TUs), and so are its vptr and the slots read from
// it: neither call is resolved.
// OPEN-LABEL: === calls
// OPEN-DAG: @_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EE10_M_releaseEv cir.call -> indirect-unresolved (IndirectUnresolved, "callee node is Incomplete")

module {
cir.func private @_Znwm(!u64i) -> !cir.ptr<!void>
cir.func private @_ZdlPv(!cir.ptr<!void>)
cir.func private @__cxa_pure_virtual()
cir.func private @_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EED2Ev(!cir.ptr<!rec_base>)
cir.func private @_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EED0Ev(!cir.ptr<!rec_base>)

cir.global "private" constant linkonce_odr @_ZTVSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EE = #cir.vtable<{#cir.const_array<[#cir.ptr<null> : !cir.ptr<!u8i>, #cir.ptr<null> : !cir.ptr<!u8i>, #cir.global_view<@_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EED2Ev> : !cir.ptr<!u8i>, #cir.global_view<@_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EED0Ev> : !cir.ptr<!u8i>, #cir.global_view<@__cxa_pure_virtual> : !cir.ptr<!u8i>, #cir.global_view<@_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EE10_M_destroyEv> : !cir.ptr<!u8i>, #cir.global_view<@__cxa_pure_virtual> : !cir.ptr<!u8i>]> : !cir.array<!cir.ptr<!u8i> x 7>}> : !rec_vt
cir.global "private" constant linkonce_odr @_ZTVSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EE = #cir.vtable<{#cir.const_array<[#cir.ptr<null> : !cir.ptr<!u8i>, #cir.ptr<null> : !cir.ptr<!u8i>, #cir.global_view<@_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EED2Ev> : !cir.ptr<!u8i>, #cir.global_view<@_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EED0Ev> : !cir.ptr<!u8i>, #cir.global_view<@_ZNSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EE10_M_disposeEv> : !cir.ptr<!u8i>, #cir.global_view<@_ZNSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EE10_M_destroyEv> : !cir.ptr<!u8i>, #cir.global_view<@_ZNSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EE14_M_get_deleterERKSt9type_info> : !cir.ptr<!u8i>]> : !cir.array<!cir.ptr<!u8i> x 7>}> : !rec_vt

// _Sp_counted_base::_Sp_counted_base(): vptr = base vtable, counts = 1.
cir.func linkonce_odr @_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EEC2Ev(%this: !cir.ptr<!rec_base>) {
  %vp = cir.vtable.address_point(@_ZTVSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EE, address_point = <index = 0, offset = 2>) : !cir.vptr
  %slot = cir.vtable.get_vptr %this : !cir.ptr<!rec_base> -> !cir.ptr<!cir.vptr>
  cir.store %vp, %slot : !cir.vptr, !cir.ptr<!cir.vptr>
  %one = cir.const #cir.int<1> : !s32i
  %use = cir.get_member %this[1] {name = "_M_use_count"} : !cir.ptr<!rec_base> -> !cir.ptr<!s32i>
  cir.store %one, %use : !s32i, !cir.ptr<!s32i>
  cir.return
}
// _Sp_counted_base::_M_destroy(): delete this.
cir.func linkonce_odr @_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EE10_M_destroyEv(%this: !cir.ptr<!rec_base>) {
  %p = cir.cast bitcast %this : !cir.ptr<!rec_base> -> !cir.ptr<!void>
  cir.call @_ZdlPv(%p) : (!cir.ptr<!void>) -> ()
  cir.return
}
// _Sp_counted_base::_M_release(): the two virtual calls.
cir.func linkonce_odr @_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EE10_M_releaseEv(%this: !cir.ptr<!rec_base>) {
  %s1 = cir.vtable.get_vptr %this : !cir.ptr<!rec_base> -> !cir.ptr<!cir.vptr>
  %v1 = cir.load %s1 : !cir.ptr<!cir.vptr>, !cir.vptr
  %a1 = cir.vtable.get_virtual_fn_addr %v1[2] : !cir.vptr -> !cir.ptr<!cir.ptr<!vfn>>
  %f1 = cir.load %a1 : !cir.ptr<!cir.ptr<!vfn>>, !cir.ptr<!vfn>
  cir.call %f1(%this) : (!cir.ptr<!vfn>, !cir.ptr<!rec_base>) -> ()
  %s2 = cir.vtable.get_vptr %this : !cir.ptr<!rec_base> -> !cir.ptr<!cir.vptr>
  %v2 = cir.load %s2 : !cir.ptr<!cir.vptr>, !cir.vptr
  %a2 = cir.vtable.get_virtual_fn_addr %v2[3] : !cir.vptr -> !cir.ptr<!cir.ptr<!vfn>>
  %f2 = cir.load %a2 : !cir.ptr<!cir.ptr<!vfn>>, !cir.ptr<!vfn>
  cir.call %f2(%this) : (!cir.ptr<!vfn>, !cir.ptr<!rec_base>) -> ()
  cir.return
}
// _Sp_counted_ptr_inplace::_Sp_counted_ptr_inplace(...): base ctor, then
// its own vptr.
cir.func linkonce_odr @_ZNSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EEC2Ev(%this: !cir.ptr<!rec_inplace>) {
  %base = cir.base_class_addr nonnull %this [0] : !cir.ptr<!rec_inplace> -> !cir.ptr<!rec_base>
  cir.call @_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EEC2Ev(%base) : (!cir.ptr<!rec_base>) -> ()
  %vp = cir.vtable.address_point(@_ZTVSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EE, address_point = <index = 0, offset = 2>) : !cir.vptr
  %slot = cir.vtable.get_vptr %this : !cir.ptr<!rec_inplace> -> !cir.ptr<!cir.vptr>
  cir.store %vp, %slot : !cir.vptr, !cir.ptr<!cir.vptr>
  cir.return
}
// _Sp_counted_ptr_inplace::_M_dispose(): reads the stored object.
cir.func linkonce_odr @_ZNSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EE10_M_disposeEv(%this: !cir.ptr<!rec_base>) {
  %d = cir.cast bitcast %this : !cir.ptr<!rec_base> -> !cir.ptr<!rec_inplace>
  %impl = cir.get_member %d[1] {name = "_M_impl"} : !cir.ptr<!rec_inplace> -> !cir.ptr<!rec_impl>
  %b = cir.cast bitcast %impl : !cir.ptr<!rec_impl> -> !cir.ptr<!u8i>
  %v = cir.load %b : !cir.ptr<!u8i>, !u8i
  cir.return
}
// _Sp_counted_ptr_inplace::_M_get_deleter(const type_info&) (reduced).
cir.func linkonce_odr @_ZNSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EE14_M_get_deleterERKSt9type_info(%this: !cir.ptr<!rec_base>) {
  cir.return
}
// _Sp_counted_ptr_inplace::_M_destroy(): delete this.
cir.func linkonce_odr @_ZNSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EE10_M_destroyEv(%this: !cir.ptr<!rec_base>) {
  %p = cir.cast bitcast %this : !cir.ptr<!rec_base> -> !cir.ptr<!void>
  cir.call @_ZdlPv(%p) : (!cir.ptr<!void>) -> ()
  cir.return
}
cir.func @main() {
  %size = cir.const #cir.int<64> : !u64i
  %mem = cir.call @_Znwm(%size) : (!u64i) -> !cir.ptr<!void>
  %cb = cir.cast bitcast %mem : !cir.ptr<!void> -> !cir.ptr<!rec_inplace>
  cir.call @_ZNSt23_Sp_counted_ptr_inplaceIN4sycl3_V16bufferIfLi2ENS1_6detail17aligned_allocatorIfEEvEESaIvELN9__gnu_cxx12_Lock_policyE2EEC2Ev(%cb) : (!cir.ptr<!rec_inplace>) -> ()
  %base = cir.base_class_addr nonnull %cb [0] : !cir.ptr<!rec_inplace> -> !cir.ptr<!rec_base>
  cir.call @_ZNSt16_Sp_counted_baseILN9__gnu_cxx12_Lock_policyE2EE10_M_releaseEv(%base) : (!cir.ptr<!rec_base>) -> ()
  cir.return
}
