// RUN: cir-opt %s -verify-diagnostics -o /dev/null \
// RUN:   -pass-pipeline="builtin.module(cir-offload-host-diagnostics{checks=sycl-host-deref-device-usm})"
// RUN: cir-opt %s -verify-diagnostics -o /dev/null \
// RUN:   -pass-pipeline="builtin.module(cir-offload-host-diagnostics{host-facts-closed-tu=true})"
//
// The same input without the expectations: with the check off (or only the
// other checks), or no host facts, nothing is reported; the pass changes
// nothing.
// RUN: sed 's/expected-/xpected-/' %s > %t.cir
// RUN: cir-opt %t.cir -o %t.none.cir \
// RUN:   -pass-pipeline="builtin.module(cir-offload-host-diagnostics{checks=none})" 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NONE --allow-empty
// RUN: cir-opt %t.cir -o /dev/null \
// RUN:   -pass-pipeline="builtin.module(cir-offload-host-diagnostics{checks=sycl-host-ptr-in-kernel,sycl-host-heap-ptr-in-kernel})" 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NONE --allow-empty
// RUN: cir-opt %t.cir -o /dev/null \
// RUN:   -pass-pipeline="builtin.module(cir-offload-host-diagnostics{host-facts=none})" 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NONE --allow-empty
// RUN: cir-opt %t.cir -o %t.all.cir 2>&1 \
// RUN:   -pass-pipeline="builtin.module(cir-offload-host-diagnostics{checks=all})" \
// RUN:   | FileCheck %s --check-prefix=ALL
// RUN: diff %t.none.cir %t.all.cir
// RUN: not cir-opt %t.cir -o /dev/null \
// RUN:   -pass-pipeline="builtin.module(cir-offload-host-diagnostics{checks=bogus})" 2>&1 \
// RUN:   | FileCheck %s --check-prefix=BAD

// `all` includes the check: the 8 warnings below.
// ALL-COUNT-8: warning: host access to device USM memory allocated at
// ALL-NOT: warning:
// NONE-NOT: warning
// BAD: unknown host diagnostic 'bogus' (expected all, none or one of: sycl-host-ptr-in-kernel, sycl-host-heap-ptr-in-kernel, sycl-host-deref-device-usm, sycl-buffer-same-host-ptr, sycl-mismatched-free, sycl-nd-range-geometry, sycl-closure-layout-mismatch)

// sycl-host-deref-device-usm (cir-offload-host-diagnostics,
// HostDiagnostics.cpp): a host load, store, copy or libc memory access
// through a pointer that must point into device USM memory, which the host
// cannot access (SYCL 2020 sec:usm, table.usm.allocs). The USM API is
// reduced to its role-tagged declarations; the kind of an allocation is the
// callee's cir.sycl_usm_kind or its constant usm::alloc operand
// (cir.sycl_usm_kind_arg). The diagnostics hold with and without closed-tu.
//
// Positive:
//  - DEV: a store through malloc_device's result.
//  - KINDARG: a load through sycl::malloc(n, q, usm::alloc::device).
//  - ALIGNED: a cir.copy of a record out of aligned_alloc_device memory.
//  - LIBC: cir.libc.memcpy from device memory, and a call of the memset
//    declaration on it.
//  - CALLEE: an internal function called with a device pointer only.
//  - MEMBER: through a pointer member of a local struct.
//  - VALUETYPE: a method of a SYCL value type (sycl::vec's operator=, exempt
//    as the SYCL implementation) stores through its `this`, spilled and
//    reloaded: the warning is at the call, with a note at the access.
// Negative (silent):
//  - SHARED / HOST: malloc_shared, malloc_host (accessible on the host).
//  - KINDVAR / KINDUNKNOWN: sycl::malloc with a kind that is not a constant,
//    or usm::alloc::unknown.
//  - SELECT: a select between a local array and a device pointer.
//  - MIXED: an internal function called with a local array and a device
//    pointer.
//  - UNKNOWN: opaque(), memory code we don't see allocated.
//  - ESCAPE: the slot holding the device pointer escapes to a declaration,
//    which may store another pointer there.
//  - PARAM: @ext_access, which nothing calls, accesses its parameter.
//  - MEMCMD / FREE: queue::memcpy and sycl::free of a device pointer are
//    calls of the runtime, not host accesses.
//  - SYCLIMPL: a function of namespace sycl (and one with a role) accessing
//    device memory: the runtime's business.
//  - KERNELBODY: @op_host, a method of the closure type of a recorded launch
//    (the host instantiation of a kernel body, which the host never runs),
//    and @kernel_helper, which only it calls.
//  - ASKKIND: a function that calls sycl::get_pointer_type: its accesses may
//    be guarded by the answer.

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!f32 = !cir.float
!void = !cir.void
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_handler = !cir.struct<class "sycl::_V1::handler" {data !cir.ptr<!s8i>}>
!rec_queue = !cir.struct<class "sycl::_V1::queue" {data !cir.ptr<!s8i>}>
!rec_lam = !cir.struct<"lam" {data !cir.ptr<!f32>}>
!rec_pair = !cir.struct<"pair" {data !f32, data !f32}>
!rec_holder = !cir.struct<"holder" {data !cir.ptr<!f32>, data !s32i}>

module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>, cir.triple = "x86_64-unknown-linux-gnu"} {
    cir.global "private" constant cir_private @s_k = #cir.const_array<"_ZTS2KK" : !cir.array<!s8i x 7>, trailing_zeros> : !cir.array<!s8i x 8>
    cir.global "private" constant internal @i_k = #cir.const_record<{#cir.const_record<{#cir.global_view<@s_k> : !cir.ptr<!s8i>, #cir.int<7> : !u64i}> : !rec_sv}> : !rec_ctki

    cir.func private @opaque() -> !cir.ptr<!f32>
    cir.func private @escape(!cir.ptr<!cir.ptr<!f32>>)
    cir.func private @memset(!cir.ptr<!s8i>, !s32i, !u64i) -> !cir.ptr<!s8i>
    cir.func private @malloc_device(!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32> attributes {cir.sycl_host_api = "usm.alloc", cir.sycl_host_api_arg = 0 : i32, cir.sycl_usm_kind = "device"}
    cir.func private @aligned_alloc_device(!u64i, !u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!rec_pair> attributes {cir.sycl_host_api = "usm.alloc", cir.sycl_host_api_arg = 1 : i32, cir.sycl_usm_kind = "device"}
    cir.func private @malloc_shared(!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32> attributes {cir.sycl_host_api = "usm.alloc", cir.sycl_host_api_arg = 0 : i32, cir.sycl_usm_kind = "shared"}
    cir.func private @malloc_host(!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32> attributes {cir.sycl_host_api = "usm.alloc", cir.sycl_host_api_arg = 0 : i32, cir.sycl_usm_kind = "host"}
    cir.func private @usm_malloc(!u64i, !cir.ptr<!rec_queue>, !s32i) -> !cir.ptr<!f32> attributes {cir.sycl_host_api = "usm.alloc", cir.sycl_host_api_arg = 0 : i32, cir.sycl_usm_kind_arg = 2 : i32}
    cir.func private @usm_free(!cir.ptr<!f32>, !cir.ptr<!rec_queue>) attributes {cir.sycl_host_api = "usm.free", cir.sycl_host_api_arg = 0 : i32}
    cir.func private @queue_memcpy(!cir.ptr<!rec_queue>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !u64i) attributes {cir.sycl_host_api = "queue.memcpy", cir.sycl_host_api_arg = 0 : i32, cir.sycl_host_api_arg2 = 1 : i32}
    cir.func private @_ZN4sycl3_V116get_pointer_typeEPKvRKNS0_7contextE(!cir.ptr<!s8i>, !cir.ptr<!s8i>) -> !s32i

    cir.func internal @info_k() -> !cir.ptr<!s8i> attributes {cir.sycl_host_api = "kernel.info", cir.sycl_host_api_arg = 0 : i32} {
      %0 = cir.get_global @i_k : !cir.ptr<!rec_ctki>
      %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
    cir.func internal @launch_k(%h: !cir.ptr<!rec_handler>, %k: !cir.ptr<!rec_lam>) attributes {cir.sycl_host_api = "handler.kernel", cir.sycl_host_api_arg = 0 : i32} {
      %info = cir.call @info_k() : () -> !cir.ptr<!s8i>
      cir.return
    }

    // CALLEE
    cir.func internal @touch(%p: !cir.ptr<!f32>) {
      %one = cir.const #cir.fp<1.0> : !f32
      // expected-warning @below {{host access to device USM memory allocated at}}
      cir.store %one, %p : !f32, !cir.ptr<!f32>
      cir.return
    }
    // MIXED
    cir.func internal @touch_mixed(%p: !cir.ptr<!f32>) {
      %one = cir.const #cir.fp<1.0> : !f32
      cir.store %one, %p : !f32, !cir.ptr<!f32>
      cir.return
    }
    // PARAM
    cir.func @ext_access(%p: !cir.ptr<!f32>) {
      %one = cir.const #cir.fp<1.0> : !f32
      cir.store %one, %p : !f32, !cir.ptr<!f32>
      cir.return
    }
    // SYCLIMPL
    cir.func internal @_ZN4sycl3_V16detail4fillEPf(%p: !cir.ptr<!f32>) {
      %one = cir.const #cir.fp<1.0> : !f32
      cir.store %one, %p : !f32, !cir.ptr<!f32>
      cir.return
    }
    cir.func internal @role_body(%p: !cir.ptr<!f32>) attributes {cir.sycl_host_api = "handler.fill", cir.sycl_host_api_arg = 0 : i32} {
      %one = cir.const #cir.fp<1.0> : !f32
      cir.store %one, %p : !f32, !cir.ptr<!f32>
      cir.return
    }
    // VALUETYPE
    cir.func internal @_ZN4sycl3_V13vecIfLi4EEaSERKf(%this: !cir.ptr<!f32>, %v: !cir.ptr<!f32>) -> !cir.ptr<!f32> {
      %slot = cir.alloca "this" align(8) : !cir.ptr<!cir.ptr<!f32>>
      cir.store %this, %slot : !cir.ptr<!f32>, !cir.ptr<!cir.ptr<!f32>>
      %t = cir.load %slot : !cir.ptr<!cir.ptr<!f32>>, !cir.ptr<!f32>
      %x = cir.load %v : !cir.ptr<!f32>, !f32
      // expected-note @below {{the called function accesses the memory here}}
      cir.store %x, %t : !f32, !cir.ptr<!f32>
      cir.return %t : !cir.ptr<!f32>
    }
    // KERNELBODY
    cir.func internal @kernel_helper(%p: !cir.ptr<!f32>) {
      %one = cir.const #cir.fp<1.0> : !f32
      cir.store %one, %p : !f32, !cir.ptr<!f32>
      cir.return
    }
    cir.func internal @op_host(%this: !cir.ptr<!rec_lam>) {
      %m = cir.get_member %this[0] {name = "P"} : !cir.ptr<!rec_lam> -> !cir.ptr<!cir.ptr<!f32>>
      %p = cir.load %m : !cir.ptr<!cir.ptr<!f32>>, !cir.ptr<!f32>
      %one = cir.const #cir.fp<1.0> : !f32
      cir.store %one, %p : !f32, !cir.ptr<!f32>
      cir.call @kernel_helper(%p) : (!cir.ptr<!f32>) -> ()
      cir.return
    }
    // ASKKIND
    cir.func internal @ask_kind(%p: !cir.ptr<!f32>, %ctx: !cir.ptr<!s8i>) {
      %raw = cir.cast bitcast %p : !cir.ptr<!f32> -> !cir.ptr<!s8i>
      %k = cir.call @_ZN4sycl3_V116get_pointer_typeEPKvRKNS0_7contextE(%raw, %ctx) : (!cir.ptr<!s8i>, !cir.ptr<!s8i>) -> !s32i
      %one = cir.const #cir.fp<1.0> : !f32
      cir.store %one, %p : !f32, !cir.ptr<!f32>
      cir.return
    }

    cir.func @main(%h: !cir.ptr<!rec_handler>, %q: !cir.ptr<!rec_queue>, %n: !u64i, %c: !cir.bool, %kind: !s32i, %ctx: !cir.ptr<!s8i>) {
      %one = cir.const #cir.fp<1.0> : !f32
      %arr = cir.alloca "arr" align(16) : !cir.ptr<!cir.array<!f32 x 64>>
      %local = cir.cast array_to_ptrdecay %arr : !cir.ptr<!cir.array<!f32 x 64>> -> !cir.ptr<!f32>

      // DEV
      // expected-note @below {{the device USM memory is allocated here; device allocations are not accessible on the host (SYCL 2020 sec:usm)}}
      %d = cir.call @malloc_device(%n, %q) : (!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32>
      // expected-warning @below {{host access to device USM memory allocated at sycl-diag-sycl-host-deref-device-usm.cir:}}
      cir.store %one, %d : !f32, !cir.ptr<!f32>

      // KINDARG
      %kdev = cir.const #cir.int<1> : !s32i
      // expected-note @below {{the device USM memory is allocated here}}
      %g = cir.call @usm_malloc(%n, %q, %kdev) : (!u64i, !cir.ptr<!rec_queue>, !s32i) -> !cir.ptr<!f32>
      %i3 = cir.const #cir.int<3> : !s32i
      %g3 = cir.ptr_stride %g, %i3 : (!cir.ptr<!f32>, !s32i) -> !cir.ptr<!f32>
      // expected-warning @below {{host access to device USM memory}}
      %gv = cir.load %g3 : !cir.ptr<!f32>, !f32

      // ALIGNED
      %al = cir.const #cir.int<64> : !u64i
      // expected-note @below {{the device USM memory is allocated here}}
      %ap = cir.call @aligned_alloc_device(%al, %n, %q) : (!u64i, !u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!rec_pair>
      %pv = cir.alloca "pv" align(4) : !cir.ptr<!rec_pair>
      // expected-warning @below {{host access to device USM memory}}
      cir.copy %ap to %pv : !cir.ptr<!rec_pair>

      // LIBC
      // expected-note @below {{the device USM memory is allocated here}}
      %d2 = cir.call @malloc_device(%n, %q) : (!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32>
      %dst = cir.cast bitcast %local : !cir.ptr<!f32> -> !cir.ptr<!void>
      %src = cir.cast bitcast %d2 : !cir.ptr<!f32> -> !cir.ptr<!void>
      // expected-warning @below {{host access to device USM memory}}
      cir.libc.memcpy %n bytes from %src to %dst : !u64i, !cir.ptr<!void> -> !cir.ptr<!void>
      // expected-note @below {{the device USM memory is allocated here}}
      %d2b = cir.call @malloc_device(%n, %q) : (!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32>
      %raw2 = cir.cast bitcast %d2b : !cir.ptr<!f32> -> !cir.ptr<!s8i>
      %zero = cir.const #cir.int<0> : !s32i
      // expected-warning @below {{host access to device USM memory}}
      %ms = cir.call @memset(%raw2, %zero, %n) : (!cir.ptr<!s8i>, !s32i, !u64i) -> !cir.ptr<!s8i>

      // CALLEE
      // expected-note @below {{the device USM memory is allocated here}}
      %d3 = cir.call @malloc_device(%n, %q) : (!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32>
      cir.call @touch(%d3) : (!cir.ptr<!f32>) -> ()

      // MEMBER
      // expected-note @below {{the device USM memory is allocated here}}
      %d4 = cir.call @malloc_device(%n, %q) : (!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32>
      %hold = cir.alloca "hold" align(8) : !cir.ptr<!rec_holder>
      %hm = cir.get_member %hold[0] {name = "p"} : !cir.ptr<!rec_holder> -> !cir.ptr<!cir.ptr<!f32>>
      cir.store %d4, %hm : !cir.ptr<!f32>, !cir.ptr<!cir.ptr<!f32>>
      %hl = cir.load %hm : !cir.ptr<!cir.ptr<!f32>>, !cir.ptr<!f32>
      // expected-warning @below {{host access to device USM memory}}
      cir.store %one, %hl : !f32, !cir.ptr<!f32>

      // VALUETYPE
      // expected-note @below {{the device USM memory is allocated here}}
      %dv = cir.call @malloc_device(%n, %q) : (!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32>
      // expected-warning @below {{host access to device USM memory}}
      %asg = cir.call @_ZN4sycl3_V13vecIfLi4EEaSERKf(%dv, %local) : (!cir.ptr<!f32>, !cir.ptr<!f32>) -> !cir.ptr<!f32>

      // SHARED, HOST
      %s = cir.call @malloc_shared(%n, %q) : (!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32>
      cir.store %one, %s : !f32, !cir.ptr<!f32>
      %hh = cir.call @malloc_host(%n, %q) : (!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32>
      cir.store %one, %hh : !f32, !cir.ptr<!f32>

      // KINDVAR, KINDUNKNOWN
      %kv = cir.call @usm_malloc(%n, %q, %kind) : (!u64i, !cir.ptr<!rec_queue>, !s32i) -> !cir.ptr<!f32>
      cir.store %one, %kv : !f32, !cir.ptr<!f32>
      %kunk = cir.const #cir.int<3> : !s32i
      %ku = cir.call @usm_malloc(%n, %q, %kunk) : (!u64i, !cir.ptr<!rec_queue>, !s32i) -> !cir.ptr<!f32>
      cir.store %one, %ku : !f32, !cir.ptr<!f32>

      // SELECT
      %d5 = cir.call @malloc_device(%n, %q) : (!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32>
      %sel = cir.select if %c then %local else %d5 : (!cir.bool, !cir.ptr<!f32>, !cir.ptr<!f32>) -> !cir.ptr<!f32>
      cir.store %one, %sel : !f32, !cir.ptr<!f32>

      // MIXED
      %d6 = cir.call @malloc_device(%n, %q) : (!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32>
      cir.call @touch_mixed(%local) : (!cir.ptr<!f32>) -> ()
      cir.call @touch_mixed(%d6) : (!cir.ptr<!f32>) -> ()

      // UNKNOWN
      %u = cir.call @opaque() : () -> !cir.ptr<!f32>
      cir.store %one, %u : !f32, !cir.ptr<!f32>

      // ESCAPE
      %d7 = cir.call @malloc_device(%n, %q) : (!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32>
      %slot = cir.alloca "slot" align(8) : !cir.ptr<!cir.ptr<!f32>>
      cir.store %d7, %slot : !cir.ptr<!f32>, !cir.ptr<!cir.ptr<!f32>>
      cir.call @escape(%slot) : (!cir.ptr<!cir.ptr<!f32>>) -> ()
      %e = cir.load %slot : !cir.ptr<!cir.ptr<!f32>>, !cir.ptr<!f32>
      cir.store %one, %e : !f32, !cir.ptr<!f32>

      // MEMCMD, FREE
      %d8 = cir.call @malloc_device(%n, %q) : (!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32>
      %raw8 = cir.cast bitcast %d8 : !cir.ptr<!f32> -> !cir.ptr<!s8i>
      %rawl = cir.cast bitcast %local : !cir.ptr<!f32> -> !cir.ptr<!s8i>
      cir.call @queue_memcpy(%q, %rawl, %raw8, %n) : (!cir.ptr<!rec_queue>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !u64i) -> ()
      cir.call @usm_free(%d8, %q) : (!cir.ptr<!f32>, !cir.ptr<!rec_queue>) -> ()

      // SYCLIMPL
      %d9 = cir.call @malloc_device(%n, %q) : (!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32>
      cir.call @_ZN4sycl3_V16detail4fillEPf(%d9) : (!cir.ptr<!f32>) -> ()
      cir.call @role_body(%d9) : (!cir.ptr<!f32>) -> ()

      // KERNELBODY: a launch with the closure, and the host running its
      // operator() (as the host instantiation would).
      %d10 = cir.call @malloc_device(%n, %q) : (!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32>
      %lam = cir.alloca "lam" align(8) : !cir.ptr<!rec_lam>
      %lf = cir.get_member %lam[0] {name = "P"} : !cir.ptr<!rec_lam> -> !cir.ptr<!cir.ptr<!f32>>
      cir.store %d10, %lf : !cir.ptr<!f32>, !cir.ptr<!cir.ptr<!f32>>
      cir.call @launch_k(%h, %lam) : (!cir.ptr<!rec_handler>, !cir.ptr<!rec_lam>) -> ()
      cir.call @op_host(%lam) : (!cir.ptr<!rec_lam>) -> ()

      // ASKKIND
      %d11 = cir.call @malloc_device(%n, %q) : (!u64i, !cir.ptr<!rec_queue>) -> !cir.ptr<!f32>
      cir.call @ask_kind(%d11, %ctx) : (!cir.ptr<!f32>, !cir.ptr<!s8i>) -> ()
      cir.return
    }
  }

  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>, cir.triple = "spir64-unknown-unknown"} {
  }
}
