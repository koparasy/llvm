// RUN: cir-opt %s -verify-diagnostics -o /dev/null \
// RUN:   -pass-pipeline="builtin.module(cir-offload-host-diagnostics{checks=sycl-nd-range-geometry host-facts-closed-tu=true})"
// RUN: sed 's/MAX-xpected-/expected-/' %s > %t.max.cir
// RUN: cir-opt %t.max.cir -verify-diagnostics -o /dev/null \
// RUN:   -pass-pipeline="builtin.module(cir-offload-host-diagnostics{checks=sycl-nd-range-geometry host-facts-closed-tu=true max-work-group-size=1024})"
//
// The same input without the expectations: with the check off (or only the
// other checks), or no host facts, nothing is reported; the pass changes
// nothing.
// RUN: sed 's/expected-/xpected-/' %s > %t.cir
// RUN: cir-opt %t.cir -o %t.none.cir \
// RUN:   -pass-pipeline="builtin.module(cir-offload-host-diagnostics{checks=none host-facts-closed-tu=true})" 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NONE --allow-empty
// RUN: cir-opt %t.cir -o /dev/null \
// RUN:   -pass-pipeline="builtin.module(cir-offload-host-diagnostics{checks=sycl-host-ptr-in-kernel,sycl-host-heap-ptr-in-kernel,sycl-host-deref-device-usm,sycl-buffer-same-host-ptr,sycl-mismatched-free host-facts-closed-tu=true})" 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NONE --allow-empty
// RUN: cir-opt %t.cir -o /dev/null \
// RUN:   -pass-pipeline="builtin.module(cir-offload-host-diagnostics{host-facts=none host-facts-closed-tu=true})" 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NONE --allow-empty
// RUN: cir-opt %t.cir -o %t.all.cir 2>&1 \
// RUN:   -pass-pipeline="builtin.module(cir-offload-host-diagnostics{checks=all host-facts-closed-tu=true})" \
// RUN:   | FileCheck %s --check-prefix=ALL
// RUN: diff %t.none.cir %t.all.cir
// Open mode: the same warnings (the constants are main's own).
// RUN: cir-opt %s -verify-diagnostics -o /dev/null \
// RUN:   -pass-pipeline="builtin.module(cir-offload-host-diagnostics{checks=sycl-nd-range-geometry})"

// `all` includes the check: the 4 warnings below (not the opt-in maximum).
// ALL-COUNT-4: warning: nd_range {{.*}} [sycl-nd-range-geometry]
// ALL-NOT: warning:
// NONE-NOT: warning

// sycl-nd-range-geometry (cir-offload-host-diagnostics,
// HostDiagnostics.cpp): a launch whose constant nd_range throws
// errc::nd_range in every calling context (SYCL 2020 sec:handlerClass,
// parallel_for; sec:kernel.attributes). The launch API is reduced to its
// role-tagged declarations (the handler.kernel model; the shapes of
// sycl-host-facts-values.cir).
//
// Positive (closed-tu and open):
//  - K1 nd_range<1>(1000, 256): not a multiple;
//  - K2 nd_range<1>(1024, 0): a zero local size;
//  - K3 nd_range<2>({64, 30}, {8, 16}): not a multiple in dimension 1;
//  - K4 nd_range<1>(1024, 128) of a kernel with reqd_work_group_size [64];
//  - K5 nd_range<1>(4096, 2048): only with max-work-group-size=1024 (MAX).
// Negative (silent):
//  - K6 a helper launching nd_range(g, l), called with (1000, 100) and
//    (1000, 300): bad in one calling context only;
//  - K7 nd_range<1>(0, 64): an empty index space;
//  - K8 nd_range<1>(1024, 256) with reqd_work_group_size [256]: correct;
//  - K9 a local size an unknown call returns.
!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>
!u64i = !cir.int<u, 64>
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_arr = !cir.struct<class "sycl::_V1::detail::array<1>" {data !cir.array<!u64i x 1>}>
