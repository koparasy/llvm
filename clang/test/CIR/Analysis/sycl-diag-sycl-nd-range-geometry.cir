      %la = cir.get_member %ls[0] {name = "common_array"} : !cir.ptr<!rec_range2> -> !cir.ptr<!rec_arr2>
      %lv = cir.get_member %la[0] {name = "common_array"} : !cir.ptr<!rec_arr2> -> !cir.ptr<!cir.array<!u64i x 2>>
      %cl0 = cir.const #cir.int<0> : !s64i
      %lp0 = cir.get_element %lv[%cl0 : !s64i] : !cir.ptr<!cir.array<!u64i x 2>> -> !cir.ptr<!u64i>
