      // expected-warning @+1 {{nd_range local size is 0 in dimension 0 (global size 1024) [sycl-nd-range-geometry]}}
      cir.call @pf_K2(%h, %ndr2, %lam2) : (!cir.ptr<!rec_handler>, !cir.ptr<!rec_ndr>, !cir.ptr<!rec_lam>) -> ()

      // K3: nd_range<2>({64, 30}, {8, 16}).
      %lam3 = cir.alloca "lam3" align(4) : !cir.ptr<!rec_lam>
      %ndr3 = cir.alloca "ndr3" align(8) : !cir.ptr<!rec_ndr2>
      cir.call @ndr2_ctor(%ndr3, %c64, %c30, %c8, %c16) : (!cir.ptr<!rec_ndr2>, !u64i, !u64i, !u64i, !u64i) -> ()
      // expected-warning @+1 {{nd_range global size 30 is not a multiple of local size 16 in dimension 1 [sycl-nd-range-geometry]}}
      cir.call @pf_K3(%h, %ndr3, %lam3) : (!cir.ptr<!rec_handler>, !cir.ptr<!rec_ndr2>, !cir.ptr<!rec_lam>) -> ()

      // K4: nd_range<1>(1024, 128), reqd_work_group_size [64].
      %lam4 = cir.alloca "lam4" align(4) : !cir.ptr<!rec_lam>
      %ndr4 = cir.alloca "ndr4" align(8) : !cir.ptr<!rec_ndr>
      cir.call @ndr_ctor(%ndr4, %c1024, %c128) : (!cir.ptr<!rec_ndr>, !u64i, !u64i) -> ()
      // expected-warning @+1 {{nd_range local size 128 does not match the kernel's reqd_work_group_size(64) [sycl-nd-range-geometry]}}
      cir.call @pf_K4(%h, %ndr4, %lam4) : (!cir.ptr<!rec_handler>, !cir.ptr<!rec_ndr>, !cir.ptr<!rec_lam>) -> ()

      // K5: nd_range<1>(4096, 2048): only with a maximum of 1024.
      %lam5 = cir.alloca "lam5" align(4) : !cir.ptr<!rec_lam>
      %ndr5 = cir.alloca "ndr5" align(8) : !cir.ptr<!rec_ndr>
      cir.call @ndr_ctor(%ndr5, %c4096, %c2048) : (!cir.ptr<!rec_ndr>, !u64i, !u64i) -> ()
      // MAX-xpected-warning @+1 {{nd_range work-group size 2048 (2048 work-items) exceeds the maximum work-group size 1024 given by --cir-offload-max-work-group-size [sycl-nd-range-geometry]}}
      cir.call @pf_K5(%h, %ndr5, %lam5) : (!cir.ptr<!rec_handler>, !cir.ptr<!rec_ndr>, !cir.ptr<!rec_lam>) -> ()

      // K6: launch(h, 1000, 100) and launch(h, 1000, 300).
      cir.call @launch(%h, %c1000, %c100) : (!cir.ptr<!rec_handler>, !u64i, !u64i) -> ()
      cir.call @launch(%h, %c1000, %c300) : (!cir.ptr<!rec_handler>, !u64i, !u64i) -> ()

      // K7: nd_range<1>(0, 64): an empty index space.
      %lam7 = cir.alloca "lam7" align(4) : !cir.ptr<!rec_lam>
      %ndr7 = cir.alloca "ndr7" align(8) : !cir.ptr<!rec_ndr>
      cir.call @ndr_ctor(%ndr7, %c0, %c64) : (!cir.ptr<!rec_ndr>, !u64i, !u64i) -> ()
      cir.call @pf_K7(%h, %ndr7, %lam7) : (!cir.ptr<!rec_handler>, !cir.ptr<!rec_ndr>, !cir.ptr<!rec_lam>) -> ()

      // K8: nd_range<1>(1024, 256), reqd_work_group_size [256].
      %lam8 = cir.alloca "lam8" align(4) : !cir.ptr<!rec_lam>
      %ndr8 = cir.alloca "ndr8" align(8) : !cir.ptr<!rec_ndr>
      cir.call @ndr_ctor(%ndr8, %c1024, %c256) : (!cir.ptr<!rec_ndr>, !u64i, !u64i) -> ()
      cir.call @pf_K8(%h, %ndr8, %lam8) : (!cir.ptr<!rec_handler>, !cir.ptr<!rec_ndr>, !cir.ptr<!rec_lam>) -> ()

      %unk = cir.call @opaque_size() : () -> !u64i
      // K9: nd_range<1>(1024, opaque_size()).
      %lam9 = cir.alloca "lam9" align(4) : !cir.ptr<!rec_lam>
      %ndr9 = cir.alloca "ndr9" align(8) : !cir.ptr<!rec_ndr>
      cir.call @ndr_ctor(%ndr9, %c1024, %unk) : (!cir.ptr<!rec_ndr>, !u64i, !u64i) -> ()
      cir.call @pf_K9(%h, %ndr9, %lam9) : (!cir.ptr<!rec_handler>, !cir.ptr<!rec_ndr>, !cir.ptr<!rec_lam>) -> ()

      cir.return
    }
