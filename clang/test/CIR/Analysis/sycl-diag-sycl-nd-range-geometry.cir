!rec_id = !cir.struct<class "sycl::_V1::id<1>" {data !rec_arr}>
!rec_ndr = !cir.struct<class "sycl::_V1::nd_range<1>" {data !rec_range, data !rec_range, data !rec_id}>
!rec_arr2 = !cir.struct<class "sycl::_V1::detail::array<2>" {data !cir.array<!u64i x 2>}>
!rec_range2 = !cir.struct<class "sycl::_V1::range<2>" {data !rec_arr2}>
