      %oa = cir.get_member %os[0] {name = "common_array"} : !cir.ptr<!rec_id2> -> !cir.ptr<!rec_arr2>
      %ov = cir.get_member %oa[0] {name = "common_array"} : !cir.ptr<!rec_arr2> -> !cir.ptr<!cir.array<!u64i x 2>>
      %zero = cir.const #cir.int<0> : !u64i
