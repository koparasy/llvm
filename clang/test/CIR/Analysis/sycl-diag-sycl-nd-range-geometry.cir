!rec_ndr2 = !cir.struct<class "sycl::_V1::nd_range<2>" {data !rec_range2, data !rec_range2, data !rec_id2}>
!rec_handler = !cir.struct<class "sycl::_V1::handler" {data !cir.ptr<!s8i>}>
!rec_lam = !cir.struct<"lam" {data !s32i}>
