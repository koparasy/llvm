!u64i = !cir.int<u, 64>
!rec_outer = !cir.struct<"outer" {data !cir.ptr<!cir.ptr<!cir.float>>, data !cir.ptr<!cir.ptr<!cir.float>>}>
!rec_clos = !cir.struct<"clos" {data !cir.ptr<!cir.float>, data !cir.ptr<!cir.float>}>
