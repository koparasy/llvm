// RUN: cir-opt %s -split-input-file \
// RUN:   -pass-pipeline="builtin.module(test-print-kernel-bindings)" \
// RUN:   2>&1 | FileCheck %s

// SYCL has no host device-stub and no cu.kernel_name: the host<->device link is
// the kernel's mangled-name string constant. A device spir_kernel binds to the
// host string equal to its symbol, counted only if that string is referenced by
// host code. Each binding records whether no other TU can launch the kernel
// (tu-unique: an internalized copy, a closure call operator with local linkage,
// or only local kernel.info getters; else shared) and whether it is registered.
// Launches are recognized by the host-API roles (cir.sycl_host_api) of the
// kernel.info marker and the launch call it feeds. The table has no host facts
// here (test-print-kernel-bindings without host-facts=ipo).

!s8i = !cir.int<s, 8>

// A named free-function kernel (FFK): nameable across TUs, so shared.
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_Z21__sycl_kernel_vec_addPKfS0_Pf" : !cir.array<!s8i x 33>, trailing_zeros> : !cir.array<!s8i x 34>
    cir.func @getName() -> !cir.ptr<!s8i> {
      %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 34>>
      %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 34>> -> !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func @_Z21__sycl_kernel_vec_addPKfS0_Pf() cc(spir_kernel) {
      cir.return
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK: - kernel _Z21__sycl_kernel_vec_addPKfS0_Pf
// CHECK-NEXT: host-name @.str (sycl, shared)
// CHECK-NEXT: device @device_sycl_spir64 : @_Z21__sycl_kernel_vec_addPKfS0_Pf
// CHECK-NEXT: <no launch site>

// -----

// An unnamed-lambda kernel with no closure call and no kernel.info getter in
// the fixture: nothing shows that no other TU can launch it, so shared (a
// lambda in an inline function has one closure type in every TU).
!s8i = !cir.int<s, 8>
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_ZTSZZ4mainENKUlRN4sycl3_V17handlerEE_clES2_EUlNS0_2idILi1EEEE_" : !cir.array<!s8i x 63>, trailing_zeros> : !cir.array<!s8i x 64>
    cir.func @getName() -> !cir.ptr<!s8i> {
      %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 64>>
      %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 64>> -> !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func @_ZTSZZ4mainENKUlRN4sycl3_V17handlerEE_clES2_EUlNS0_2idILi1EEEE_() cc(spir_kernel) {
      cir.return
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK: - kernel _ZTSZZ4mainENKUlRN4sycl3_V17handlerEE_clES2_EUlNS0_2idILi1EEEE_
// CHECK-NEXT: host-name @.str (sycl, shared)
// CHECK-NEXT: device @device_sycl_spir64 : @_ZTSZZ4mainENKUlRN4sycl3_V17handlerEE_clES2_EUlNS0_2idILi1EEEE_
// CHECK-NEXT: <no launch site>

// -----

// An anonymous-closure kernel that IS registered by name: reachable by name /
// bundle across TUs.
!s8i = !cir.int<s, 8>
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_ZTSZ4mainEUlvE_" : !cir.array<!s8i x 16>, trailing_zeros> : !cir.array<!s8i x 17>
    cir.func @getName() -> !cir.ptr<!s8i> {
      %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 17>>
      %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 17>> -> !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>, cir.sycl_registered_kernels = [["my_kernel", "_ZTSZ4mainEUlvE_"]]} {
    cir.func @_ZTSZ4mainEUlvE_() cc(spir_kernel) {
      cir.return
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK: - kernel _ZTSZ4mainEUlvE_
// CHECK-NEXT: host-name @.str (sycl, shared, registered)
// CHECK-NEXT: device @device_sycl_spir64 : @_ZTSZ4mainEUlvE_
// CHECK-NEXT: <no launch site>

// -----

// A device spir_kernel whose mangled-name string is never referenced by host
// code binds nothing: the string exists but has no host use.
!s8i = !cir.int<s, 8>
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_Z21__sycl_kernel_vec_addPKfS0_Pf" : !cir.array<!s8i x 33>, trailing_zeros> : !cir.array<!s8i x 34>
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func @_Z21__sycl_kernel_vec_addPKfS0_Pf() cc(spir_kernel) {
      cir.return
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 0 empty true

// -----

// A launched anonymous-lambda kernel. The host reaches it through the
// `getDeviceKernelInfo<Kernel>()` marker, whose callee body names a
// CompileTimeKernelInfo global embedding the kernel's _ZTS string (the same
// string bindSYCLKernels binds). The DeviceKernelInfo* result is spilled to a
// slot and reloaded, then fed to the runtime launch
// `submit_kernel_direct_with_event_impl` (launch.direct_impl); the recorder
// walks that chain and records the launch. The closure operand is a parameter
// here, not a HostKernelRef the function constructs (hostkernel.ctor), so it is
// not traced. The getter is internal: the kernel is tu-unique.
!s8i = !cir.int<s, 8>
!u64i = !cir.int<u, 64>
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_ZTSZ4mainEUlvE_" : !cir.array<!s8i x 16>, trailing_zeros> : !cir.array<!s8i x 17>
    // First field is the kernel-name string_view {@.str, len}.
    cir.global "private" constant internal @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE = #cir.const_record<{#cir.const_record<{#cir.global_view<@".str"> : !cir.ptr<!s8i>, #cir.int<16> : !u64i}> : !rec_sv}> : !rec_ctki
    cir.func private @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>) attributes {cir.sycl_host_api = "launch.direct_impl", cir.sycl_host_api_arg = 2 : i32}
    // The templated marker: template-args follow the name, no operands.
    cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() -> !cir.ptr<!s8i> attributes {cir.sycl_host_api = "kernel.info"} {
      %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE : !cir.ptr<!rec_ctki>
      %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
    // Mimics submit_kernel_direct: geometry + closure in, DeviceKernelInfo*
    // spilled to a slot and reloaded before the runtime launch.
    cir.func @launch(%geom: !cir.ptr<!s8i>, %clos: !cir.ptr<!s8i>, %queue: !cir.ptr<!s8i>, %event: !cir.ptr<!s8i>) {
      %slot = cir.alloca "DeviceKernelInfoPtr" align(8) : !cir.ptr<!cir.ptr<!s8i>>
      %dki = cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() : () -> !cir.ptr<!s8i>
      cir.store %dki, %slot : !cir.ptr<!s8i>, !cir.ptr<!cir.ptr<!s8i>>
      %reload = cir.load %slot : !cir.ptr<!cir.ptr<!s8i>>, !cir.ptr<!s8i>
      cir.call @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(%event, %queue, %geom, %clos, %reload) : (!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>) -> ()
      cir.return
    }
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func @_ZTSZ4mainEUlvE_() cc(spir_kernel) {
      cir.return
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK: - kernel _ZTSZ4mainEUlvE_
// CHECK-NEXT: host-name @.str (sycl, tu-unique)
// CHECK-NEXT: device @device_sycl_spir64 : @_ZTSZ4mainEUlvE_
// CHECK-NEXT: launch in @launch (sycl), closure none, geometry none

// -----

// A NAMED-TAG-over-lambda kernel: `parallel_for<class NamedTag>(lambda)`. The
// closure call operator is not in the fixture and no kernel.info getter names
// the kernel, so nothing shows that it is TU-unique: shared.
!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!rec_anon = !cir.struct<class "__cir_lowered.anon.0" {data !cir.ptr<!s32i>}>
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_ZTS8NamedTag" : !cir.array<!s8i x 13>, trailing_zeros> : !cir.array<!s8i x 14>
    cir.func @getName() -> !cir.ptr<!s8i> {
      %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 14>>
      %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 14>> -> !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>} {
    // The kernel entry reconstructs its closure (a lambda: anon record) and
    // invokes operator() with the closure object as receiver (operand 0).
    cir.func private @_ZZ4mainENKUlvE_clEv(!cir.ptr<!rec_anon>)
    cir.func @_ZTS8NamedTag() cc(spir_kernel) {
      %0 = cir.alloca "__SYCLKernel" align(8) : !cir.ptr<!rec_anon>
      cir.call @_ZZ4mainENKUlvE_clEv(%0) : (!cir.ptr<!rec_anon>) -> ()
      cir.return
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK: - kernel _ZTS8NamedTag
// CHECK-NEXT: host-name @.str (sycl, shared)
// CHECK-NEXT: device @device_sycl_spir64 : @_ZTS8NamedTag
// CHECK-NEXT: <no launch site>

// -----

// A genuine FUNCTOR kernel: a named struct with operator(), possibly defined in
// a header and launchable from other TUs: shared.
!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!rec_func = !cir.struct<class "MyFunctor" {data !cir.ptr<!s32i>}>
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_ZTS9MyFunctor" : !cir.array<!s8i x 14>, trailing_zeros> : !cir.array<!s8i x 15>
    cir.func @getName() -> !cir.ptr<!s8i> {
      %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 15>>
      %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 15>> -> !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func private @_ZNK9MyFunctorclEv(!cir.ptr<!rec_func>)
    cir.func @_ZTS9MyFunctor() cc(spir_kernel) {
      %0 = cir.alloca "MyFunctor" align(8) : !cir.ptr<!rec_func>
      cir.call @_ZNK9MyFunctorclEv(%0) : (!cir.ptr<!rec_func>) -> ()
      cir.return
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK: - kernel _ZTS9MyFunctor
// CHECK-NEXT: host-name @.str (sycl, shared)
// CHECK-NEXT: device @device_sycl_spir64 : @_ZTS9MyFunctor
// CHECK-NEXT: <no launch site>

// -----

// A HANDLER-submit launch: `q.submit([&](handler& h){ h.parallel_for(...) })`.
// This is the far more common launch form; unlike the direct
// `q.parallel_for` shortcut it does not launch through
// submit_kernel_direct_with_event_impl but through a set of handler methods
// tied by the shared `handler* this`:
//   %dki = detail::getDeviceKernelInfo<K>()        -- SAME name marker
//   handler::setDeviceKernelInfoPtr(this, %dki)    -- the dki sink the marker feeds
//   handler::setNDRangeDescriptor(this, view)      -- the geometry sink
// The user lambda is wrapped by StoreLambda as
// `this->MHostKernel.reset(new detail::HostKernel<KernelType,...>(lambda))`, so
// the closure is recovered structurally through the handler: the reset writing
// this handler's MHostKernel member gives the new HostKernel object (reached
// through its HostKernelBase base pointer, spilled and reloaded), and that
// object's HostKernel constructor (hostkernel.ctor) took the user lambda as
// arg1: the marker anchors the name, setDeviceKernelInfoPtr
// (handler.set_kernel_info) is the launch sink, and the closure is traced.
!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!rec_arr = !cir.struct<"arr" {data !cir.array<!u64i x 1>}>
!rec_range = !cir.struct<"range" {data !rec_arr}>
!rec_ndr = !cir.struct<"ndr" {data !rec_range, data !rec_range}>
!rec_view = !cir.struct<"view" {data !cir.ptr<!u64i>, data !cir.ptr<!u64i>, data !cir.ptr<!u64i>, data !u64i}>
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_clos = !cir.struct<"clos" {data !cir.ptr<!cir.float>, data !cir.ptr<!cir.float>, data !s32i}>
!rec_hkbase = !cir.struct<"hkbase" {data !cir.ptr<!s8i>}>
!rec_hk = !cir.struct<"hk" {data !rec_hkbase, data !rec_clos}>
!rec_handler = !cir.struct<"handler" {data !cir.ptr<!rec_hkbase>}>
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_ZTSZ4mainEUlvE_" : !cir.array<!s8i x 16>, trailing_zeros> : !cir.array<!s8i x 17>
    cir.global "private" constant internal @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE = #cir.const_record<{#cir.const_record<{#cir.global_view<@".str"> : !cir.ptr<!s8i>, #cir.int<16> : !u64i}> : !rec_sv}> : !rec_ctki
    // Handler-method sinks: __SYCL_EXPORT decl-only ABI boundaries, so they
    // survive as calls and their operands are read directly.
    cir.func private @_ZN4sycl3_V17handler22setDeviceKernelInfoPtrEPNS0_6detail16DeviceKernelInfoE(!cir.ptr<!rec_handler>, !cir.ptr<!s8i>) attributes {cir.sycl_host_api = "handler.set_kernel_info", cir.sycl_host_api_arg = 0 : i32}
    cir.func private @_ZN4sycl3_V17handler20setNDRangeDescriptorENS0_6detail13nd_range_viewEb(!cir.ptr<!rec_handler>, !cir.ptr<!rec_view>) attributes {cir.sycl_host_api = "handler.set_ndrange", cir.sycl_host_api_arg = 0 : i32}
    // The HostKernel wrapper ctor: its arg1 is the user lambda closure.
    cir.func private @_ZN4sycl3_V16detail10HostKernelIZ4mainEUlvE_S2_Li1EEC2ES2_(!cir.ptr<!rec_hk>, !cir.ptr<!rec_clos>) attributes {cir.sycl_host_api = "hostkernel.ctor", cir.sycl_host_api_arg = 0 : i32}
    // unique_ptr<HostKernelBase>::reset installs the wrapped kernel into
    // handler.MHostKernel; arg1 is the HostKernel object as a base pointer.
    cir.func private @_ZNSt10unique_ptrIN4sycl3_V16detail14HostKernelBaseESt14default_deleteIS3_EE5resetEPS3_(!cir.ptr<!cir.ptr<!rec_hkbase>>, !cir.ptr<!rec_hkbase>)
    // Two distinct USM allocations backing the two pointer captures.
    cir.func private @_ZN4sycl3_V113malloc_deviceIfEEPvm(!u64i) -> !cir.ptr<!cir.float>
    cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() -> !cir.ptr<!s8i> attributes {cir.sycl_host_api = "kernel.info"} {
      %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE : !cir.ptr<!rec_ctki>
      %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
    // The command-group body after the launch-shim chain is collapsed into it:
    // the nd_range_view, the closure capture stores, the HostKernel wrap, and
    // the handler-method sinks all co-located and tied by the handler %h.
    cir.func @cg(%h: !cir.ptr<!rec_handler>) {
      %n = cir.const #cir.int<8> : !u64i
      %g = cir.const #cir.int<512> : !u64i
      %l = cir.const #cir.int<128> : !u64i
      %one = cir.const #cir.int<1> : !u64i
      %seven = cir.const #cir.int<7> : !s32i
      // --- geometry: nd_range with const global=512, local=128 ---
      %ndr = cir.alloca "ndr" align(8) : !cir.ptr<!rec_ndr>
      %view = cir.alloca "view" align(8) : !cir.ptr<!rec_view>
      %ng = cir.get_member %ndr[0] {name = "globalSize"} : !cir.ptr<!rec_ndr> -> !cir.ptr<!rec_range>
      %nga = cir.base_class_addr nonnull %ng [0] : !cir.ptr<!rec_range> -> !cir.ptr<!rec_arr>
      %ngc = cir.get_member %nga[0] {name = "common_array"} : !cir.ptr<!rec_arr> -> !cir.ptr<!cir.array<!u64i x 1>>
      %ngp = cir.cast array_to_ptrdecay %ngc : !cir.ptr<!cir.array<!u64i x 1>> -> !cir.ptr<!u64i>
      cir.store %g, %ngp : !u64i, !cir.ptr<!u64i>
      %nl = cir.get_member %ndr[1] {name = "localSize"} : !cir.ptr<!rec_ndr> -> !cir.ptr<!rec_range>
      %nla = cir.base_class_addr nonnull %nl [0] : !cir.ptr<!rec_range> -> !cir.ptr<!rec_arr>
      %nlc = cir.get_member %nla[0] {name = "common_array"} : !cir.ptr<!rec_arr> -> !cir.ptr<!cir.array<!u64i x 1>>
      %nlp = cir.cast array_to_ptrdecay %nlc : !cir.ptr<!cir.array<!u64i x 1>> -> !cir.ptr<!u64i>
      cir.store %l, %nlp : !u64i, !cir.ptr<!u64i>
      %mg = cir.get_member %view[0] {name = "MGlobalSize"} : !cir.ptr<!rec_view> -> !cir.ptr<!cir.ptr<!u64i>>
      cir.store %ngp, %mg : !cir.ptr<!u64i>, !cir.ptr<!cir.ptr<!u64i>>
      %ml = cir.get_member %view[1] {name = "MLocalSize"} : !cir.ptr<!rec_view> -> !cir.ptr<!cir.ptr<!u64i>>
      cir.store %nlp, %ml : !cir.ptr<!u64i>, !cir.ptr<!cir.ptr<!u64i>>
      %md = cir.get_member %view[3] {name = "MDims"} : !cir.ptr<!rec_view> -> !cir.ptr<!u64i>
      cir.store %one, %md : !u64i, !cir.ptr<!u64i>
      // --- closure: two distinct USM captures + one const scalar capture ---
      %clos = cir.alloca "clos" align(8) : !cir.ptr<!rec_clos>
      %p0 = cir.call @_ZN4sycl3_V113malloc_deviceIfEEPvm(%n) : (!u64i) -> !cir.ptr<!cir.float>
      %p1 = cir.call @_ZN4sycl3_V113malloc_deviceIfEEPvm(%n) : (!u64i) -> !cir.ptr<!cir.float>
      %f0 = cir.get_member %clos[0] {name = "f0"} : !cir.ptr<!rec_clos> -> !cir.ptr<!cir.ptr<!cir.float>>
      cir.store %p0, %f0 : !cir.ptr<!cir.float>, !cir.ptr<!cir.ptr<!cir.float>>
      %f1 = cir.get_member %clos[1] {name = "f1"} : !cir.ptr<!rec_clos> -> !cir.ptr<!cir.ptr<!cir.float>>
      cir.store %p1, %f1 : !cir.ptr<!cir.float>, !cir.ptr<!cir.ptr<!cir.float>>
      %fs = cir.get_member %clos[2] {name = "s"} : !cir.ptr<!rec_clos> -> !cir.ptr<!s32i>
      cir.store %seven, %fs : !s32i, !cir.ptr<!s32i>
      // --- wrap: new HostKernel(lambda), spill+reload, reset into MHostKernel ---
      %hkobj = cir.alloca "hk" align(8) : !cir.ptr<!rec_hk>
      %hkslot = cir.alloca "hkslot" align(8) : !cir.ptr<!cir.ptr<!rec_hk>>
      cir.call @_ZN4sycl3_V16detail10HostKernelIZ4mainEUlvE_S2_Li1EEC2ES2_(%hkobj, %clos) : (!cir.ptr<!rec_hk>, !cir.ptr<!rec_clos>) -> ()
      cir.store %hkobj, %hkslot : !cir.ptr<!rec_hk>, !cir.ptr<!cir.ptr<!rec_hk>>
      %hkreload = cir.load %hkslot : !cir.ptr<!cir.ptr<!rec_hk>>, !cir.ptr<!rec_hk>
      %hkbaseptr = cir.base_class_addr nonnull %hkreload [0] : !cir.ptr<!rec_hk> -> !cir.ptr<!rec_hkbase>
      %mh = cir.get_member %h[0] {name = "MHostKernel"} : !cir.ptr<!rec_handler> -> !cir.ptr<!cir.ptr<!rec_hkbase>>
      cir.call @_ZNSt10unique_ptrIN4sycl3_V16detail14HostKernelBaseESt14default_deleteIS3_EE5resetEPS3_(%mh, %hkbaseptr) : (!cir.ptr<!cir.ptr<!rec_hkbase>>, !cir.ptr<!rec_hkbase>) -> ()
      // --- launch sinks tied by the handler %h ---
      %slot = cir.alloca "dki" align(8) : !cir.ptr<!cir.ptr<!s8i>>
      %dki = cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() : () -> !cir.ptr<!s8i>
      cir.store %dki, %slot : !cir.ptr<!s8i>, !cir.ptr<!cir.ptr<!s8i>>
      %r = cir.load %slot : !cir.ptr<!cir.ptr<!s8i>>, !cir.ptr<!s8i>
      cir.call @_ZN4sycl3_V17handler22setDeviceKernelInfoPtrEPNS0_6detail16DeviceKernelInfoE(%h, %r) : (!cir.ptr<!rec_handler>, !cir.ptr<!s8i>) -> ()
      cir.call @_ZN4sycl3_V17handler20setNDRangeDescriptorENS0_6detail13nd_range_viewEb(%h, %view) : (!cir.ptr<!rec_handler>, !cir.ptr<!rec_view>) -> ()
      cir.return
    }
