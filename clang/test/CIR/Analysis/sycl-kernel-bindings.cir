      %or0 = cir.get_member %outer[0] {name = "f0"} : !cir.ptr<!rec_outer> -> !cir.ptr<!cir.ptr<!cir.ptr<!cir.float>>>
      cir.store %loc0, %or0 : !cir.ptr<!cir.ptr<!cir.float>>, !cir.ptr<!cir.ptr<!cir.ptr<!cir.float>>>
      %or1 = cir.get_member %outer[1] {name = "f1"} : !cir.ptr<!rec_outer> -> !cir.ptr<!cir.ptr<!cir.ptr<!cir.float>>>
      cir.store %loc1, %or1 : !cir.ptr<!cir.ptr<!cir.float>>, !cir.ptr<!cir.ptr<!cir.ptr<!cir.float>>>
