    cir.func private @_ZN4sycl3_V113malloc_deviceIfEEPvm(!u64i) -> !cir.ptr<!cir.float>
    cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() -> !cir.ptr<!s8i> {
      %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE : !cir.ptr<!rec_ctki>
      %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
    cir.func @cg(%h: !cir.ptr<!s8i>, %hk: !cir.ptr<!s8i>) {
      %n = cir.const #cir.int<8> : !u64i
      // Two distinct USM allocations, held in caller locals (loc0/loc1).
      %m0 = cir.call @_ZN4sycl3_V113malloc_deviceIfEEPvm(%n) : (!u64i) -> !cir.ptr<!cir.float>
