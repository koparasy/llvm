    cir.func @main(%h: !cir.ptr<!rec_handler>, %r: !cir.ptr<!rec_range>) {
      %c4096 = cir.const #cir.int<4096> : !u64i
      %p = cir.call @malloc_device(%c4096) : (!u64i) -> !cir.ptr<!f32>
      %c7 = cir.const #cir.int<7> : !s32i
      %c8 = cir.const #cir.int<8> : !s32i
      %c64 = cir.const #cir.int<64> : !u64i
      %c128 = cir.const #cir.int<128> : !u64i
      %c1024 = cir.const #cir.int<1024> : !u64i

      // K1, launched twice with n = 7 over nd_range(1024, 64).
      %lam1 = cir.alloca "lam1" align(8) : !cir.ptr<!rec_lam>
      %f1n = cir.get_member %lam1[0] {name = "n"} : !cir.ptr<!rec_lam> -> !cir.ptr<!s32i>
      cir.store %c7, %f1n : !s32i, !cir.ptr<!s32i>
