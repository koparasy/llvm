      %lam1b = cir.alloca "lam1b" align(8) : !cir.ptr<!rec_lam>
      %f1bn = cir.get_member %lam1b[0] {name = "n"} : !cir.ptr<!rec_lam> -> !cir.ptr<!s32i>
      cir.store %c7, %f1bn : !s32i, !cir.ptr<!s32i>
      %ndr1b = cir.alloca "ndr1b" align(8) : !cir.ptr<!rec_ndr>
      cir.call @ndr_ctor(%ndr1b, %c1024, %c64) : (!cir.ptr<!rec_ndr>, !u64i, !u64i) -> ()
      cir.call @pf_K1(%h, %ndr1b, %lam1b) : (!cir.ptr<!rec_handler>, !cir.ptr<!rec_ndr>, !cir.ptr<!rec_lam>) -> ()

      // K2, launched with n = 7 over nd_range(1024, 64) and with n = 8 over
      // nd_range(1024, 128): the launches disagree.
      %lam2 = cir.alloca "lam2" align(8) : !cir.ptr<!rec_lam>
      %f2n = cir.get_member %lam2[0] {name = "n"} : !cir.ptr<!rec_lam> -> !cir.ptr<!s32i>
      cir.store %c7, %f2n : !s32i, !cir.ptr<!s32i>
      %ndr2 = cir.alloca "ndr2" align(8) : !cir.ptr<!rec_ndr>
      cir.call @ndr_ctor(%ndr2, %c1024, %c64) : (!cir.ptr<!rec_ndr>, !u64i, !u64i) -> ()
      cir.call @pf_K2(%h, %ndr2, %lam2) : (!cir.ptr<!rec_handler>, !cir.ptr<!rec_ndr>, !cir.ptr<!rec_lam>) -> ()
      %lam2b = cir.alloca "lam2b" align(8) : !cir.ptr<!rec_lam>
      %f2bn = cir.get_member %lam2b[0] {name = "n"} : !cir.ptr<!rec_lam> -> !cir.ptr<!s32i>
      cir.store %c8, %f2bn : !s32i, !cir.ptr<!s32i>
      %ndr2b = cir.alloca "ndr2b" align(8) : !cir.ptr<!rec_ndr>
      cir.call @ndr_ctor(%ndr2b, %c1024, %c128) : (!cir.ptr<!rec_ndr>, !u64i, !u64i) -> ()
      cir.call @pf_K2(%h, %ndr2b, %lam2b) : (!cir.ptr<!rec_handler>, !cir.ptr<!rec_ndr>, !cir.ptr<!rec_lam>) -> ()

      // K3: Bench b(42, 2048); b.run(h, p).
      %bench = cir.alloca "bench" align(8) : !cir.ptr<!rec_bench>
      %c42 = cir.const #cir.int<42> : !s32i
      %c2048 = cir.const #cir.int<2048> : !u64i
      cir.call @bench_ctor(%bench, %c42, %c2048) : (!cir.ptr<!rec_bench>, !s32i, !u64i) -> ()
      cir.call @bench_run(%bench, %h, %p) : (!cir.ptr<!rec_bench>, !cir.ptr<!rec_handler>, !cir.ptr<!f32>) -> ()

      // K4: a model call (buffer::get_range, through sret) overwrites a range
      // that held 9 before its first element is captured, and the global
      // range of the nd_range.
      %buf = cir.alloca "buf" align(8) : !cir.ptr<!rec_buf>
      cir.call @buffer_alloc(%buf, %r) : (!cir.ptr<!rec_buf>, !cir.ptr<!rec_range>) -> ()
      %rr = cir.alloca "rr" align(8) : !cir.ptr<!rec_range>
      %ra = cir.get_member %rr[0] {name = "common_array"} : !cir.ptr<!rec_range> -> !cir.ptr<!rec_arr>
      %rv = cir.get_member %ra[0] {name = "common_array"} : !cir.ptr<!rec_arr> -> !cir.ptr<!cir.array<!u64i x 1>>
      %r0 = cir.cast array_to_ptrdecay %rv : !cir.ptr<!cir.array<!u64i x 1>> -> !cir.ptr<!u64i>
      %c9 = cir.const #cir.int<9> : !u64i
      cir.store %c9, %r0 : !u64i, !cir.ptr<!u64i>
