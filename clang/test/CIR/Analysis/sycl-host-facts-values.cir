    // handler::parallel_for<K5>(nd_range, lambda): replaced by the launch model.
    cir.func internal @pf_K5(%h: !cir.ptr<!rec_handler>, %r: !cir.ptr<!rec_ndr>, %k: !cir.ptr<!rec_lam>) attributes {cir.sycl_host_api = "handler.kernel", cir.sycl_host_api_arg = 1 : i32} {
      %dki = cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoIK5EEPv() : () -> !cir.ptr<!s8i>
      cir.call @_ZN4sycl3_V17handler22setDeviceKernelInfoPtrEPv(%h, %dki) : (!cir.ptr<!rec_handler>, !cir.ptr<!s8i>) -> ()
      cir.return
    }
    // nd_range(range<1> global, range<1> local) with the ranges coerced to
    // integers: analysed, not modelled.
    cir.func internal @ndr_ctor(%this: !cir.ptr<!rec_ndr>, %g: !u64i, %l: !u64i) attributes {cir.sycl_host_api = "ndrange.ctor", cir.sycl_host_api_arg = 0 : i32} {
      %gs = cir.get_member %this[0] {name = "globalSize"} : !cir.ptr<!rec_ndr> -> !cir.ptr<!rec_range>
      %ga = cir.get_member %gs[0] {name = "common_array"} : !cir.ptr<!rec_range> -> !cir.ptr<!rec_arr>
      %gv = cir.get_member %ga[0] {name = "common_array"} : !cir.ptr<!rec_arr> -> !cir.ptr<!cir.array<!u64i x 1>>
      %g0 = cir.cast array_to_ptrdecay %gv : !cir.ptr<!cir.array<!u64i x 1>> -> !cir.ptr<!u64i>
      cir.store %g, %g0 : !u64i, !cir.ptr<!u64i>
      %ls = cir.get_member %this[1] {name = "localSize"} : !cir.ptr<!rec_ndr> -> !cir.ptr<!rec_range>
      %la = cir.get_member %ls[0] {name = "common_array"} : !cir.ptr<!rec_range> -> !cir.ptr<!rec_arr>
      %lv = cir.get_member %la[0] {name = "common_array"} : !cir.ptr<!rec_arr> -> !cir.ptr<!cir.array<!u64i x 1>>
      %l0 = cir.cast array_to_ptrdecay %lv : !cir.ptr<!cir.array<!u64i x 1>> -> !cir.ptr<!u64i>
      cir.store %l, %l0 : !u64i, !cir.ptr<!u64i>
      %os = cir.get_member %this[2] {name = "offset"} : !cir.ptr<!rec_ndr> -> !cir.ptr<!rec_id>
      %oa = cir.get_member %os[0] {name = "common_array"} : !cir.ptr<!rec_id> -> !cir.ptr<!rec_arr>
      %ov = cir.get_member %oa[0] {name = "common_array"} : !cir.ptr<!rec_arr> -> !cir.ptr<!cir.array<!u64i x 1>>
      %o0 = cir.cast array_to_ptrdecay %ov : !cir.ptr<!cir.array<!u64i x 1>> -> !cir.ptr<!u64i>
      %zero = cir.const #cir.int<0> : !u64i
      cir.store %zero, %o0 : !u64i, !cir.ptr<!u64i>
      cir.return
