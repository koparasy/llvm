      %m = cir.load %r0 : !cir.ptr<!u64i>, !u64i
      %lam4 = cir.alloca "lam4" align(8) : !cir.ptr<!rec_lam4>
      %f4m = cir.get_member %lam4[0] {name = "m"} : !cir.ptr<!rec_lam4> -> !cir.ptr<!u64i>
      cir.store %m, %f4m : !u64i, !cir.ptr<!u64i>
      %ndr4 = cir.alloca "ndr4" align(8) : !cir.ptr<!rec_ndr>
      cir.call @ndr_ctor(%ndr4, %c1024, %c64) : (!cir.ptr<!rec_ndr>, !u64i, !u64i) -> ()
      %g4 = cir.get_member %ndr4[0] {name = "globalSize"} : !cir.ptr<!rec_ndr> -> !cir.ptr<!rec_range>
      cir.call @buffer_get_range(%g4, %buf) : (!cir.ptr<!rec_range>, !cir.ptr<!rec_buf>) -> ()
      cir.call @pf_K4(%h, %ndr4, %lam4) : (!cir.ptr<!rec_handler>, !cir.ptr<!rec_ndr>, !cir.ptr<!rec_lam4>) -> ()

      // K5: like K1, but the launch function takes the nd_range by address,
      // not by value: it may write it.
      %lam5 = cir.alloca "lam5" align(8) : !cir.ptr<!rec_lam>
      %f5n = cir.get_member %lam5[0] {name = "n"} : !cir.ptr<!rec_lam> -> !cir.ptr<!s32i>
      cir.store %c7, %f5n : !s32i, !cir.ptr<!s32i>
      %ndr5 = cir.alloca "ndr5" align(8) : !cir.ptr<!rec_ndr>
      cir.call @ndr_ctor(%ndr5, %c1024, %c64) : (!cir.ptr<!rec_ndr>, !u64i, !u64i) -> ()
      cir.call @pf_K5(%h, %ndr5, %lam5) : (!cir.ptr<!rec_handler>, !cir.ptr<!rec_ndr>, !cir.ptr<!rec_lam>) -> ()
      cir.return
    }
  }
