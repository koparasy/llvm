    cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIK4EEPv() -> !cir.ptr<!s8i> attributes {cir.sycl_host_api = "kernel.info", cir.sycl_host_api_arg = 0 : i32} {
      %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIK4EE : !cir.ptr<!rec_ctki>
