    // Bench(int n, size_t g) : size(n), geo(g, 64) {}
    cir.func @bench_ctor(%this: !cir.ptr<!rec_bench>, %n: !s32i, %g: !u64i) {
      %size = cir.get_member %this[0] {name = "size"} : !cir.ptr<!rec_bench> -> !cir.ptr<!s32i>
      cir.store %n, %size : !s32i, !cir.ptr<!s32i>
      %geo = cir.get_member %this[1] {name = "geo"} : !cir.ptr<!rec_bench> -> !cir.ptr<!rec_ndr>
      %c64 = cir.const #cir.int<64> : !u64i
      cir.call @ndr_ctor(%geo, %g, %c64) : (!cir.ptr<!rec_ndr>, !u64i, !u64i) -> ()
      cir.return
    }
    // Bench::run(handler &h): h.parallel_for<K3>(geo, [=, s = size] { ... }).
    cir.func @bench_run(%this: !cir.ptr<!rec_bench>, %h: !cir.ptr<!rec_handler>, %p: !cir.ptr<!f32>) {
      %lam = cir.alloca "lam3" align(8) : !cir.ptr<!rec_lam>
      %size = cir.get_member %this[0] {name = "size"} : !cir.ptr<!rec_bench> -> !cir.ptr<!s32i>
      %s = cir.load %size : !cir.ptr<!s32i>, !s32i
      %fn = cir.get_member %lam[0] {name = "n"} : !cir.ptr<!rec_lam> -> !cir.ptr<!s32i>
      cir.store %s, %fn : !s32i, !cir.ptr<!s32i>
      %fp = cir.get_member %lam[1] {name = "p"} : !cir.ptr<!rec_lam> -> !cir.ptr<!cir.ptr<!f32>>
      cir.store %p, %fp : !cir.ptr<!f32>, !cir.ptr<!cir.ptr<!f32>>
      // The by-value nd_range argument: a copy of this->geo.
      %tmp = cir.alloca "agg.tmp" align(8) : !cir.ptr<!rec_ndr>
      %geo = cir.get_member %this[1] {name = "geo"} : !cir.ptr<!rec_bench> -> !cir.ptr<!rec_ndr>
      cir.copy %geo to %tmp : !cir.ptr<!rec_ndr>
      cir.call @pf_K3(%h, %tmp, %lam) : (!cir.ptr<!rec_handler>, !cir.ptr<!rec_ndr>, !cir.ptr<!rec_lam>) -> ()
