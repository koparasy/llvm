    // handler::parallel_for<K3>(nd_range, lambda): replaced by the launch model.
    cir.func internal @pf_K3(%h: !cir.ptr<!rec_handler>, %r: !cir.ptr<!rec_ndr> {llvm.byval = !rec_ndr}, %k: !cir.ptr<!rec_lam>) attributes {cir.sycl_host_api = "handler.kernel", cir.sycl_host_api_arg = 1 : i32} {
      %dki = cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoIK3EEPv() : () -> !cir.ptr<!s8i>
      cir.call @_ZN4sycl3_V17handler22setDeviceKernelInfoPtrEPv(%h, %dki) : (!cir.ptr<!rec_handler>, !cir.ptr<!s8i>) -> ()
      cir.return
