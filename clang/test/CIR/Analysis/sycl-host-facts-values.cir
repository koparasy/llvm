// RUN: cir-opt %s -cir-points-to-verify -pass-pipeline="builtin.module(test-print-kernel-bindings{host-facts=both closed-tu=1})" \
// RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=BOTH
// RUN: cir-opt %s -cir-points-to-verify -pass-pipeline="builtin.module(test-print-kernel-bindings{host-facts=both closed-tu=1 subobjects=0})" \
// RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=BOTH
// RUN: cir-opt %s -cir-points-to-verify -pass-pipeline="builtin.module(test-print-kernel-bindings{host-facts=both})" \
// RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=OPEN
// RUN: cir-opt %s -cir-points-to-verify -pass-pipeline="builtin.module(test-print-kernel-bindings{host-facts=both closed-tu=1 bu=0 subobjects=0})" \
// RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=CI
// RUN: cir-opt %s -pass-pipeline="builtin.module(test-print-kernel-bindings{host-facts=ipo closed-tu=1})" \
// RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=TABLE-IPO
// RUN: cir-opt %s -cir-offload-propagate-sycl-kernel-args='host-facts=ipo host-facts-closed-tu=1' \
// RUN:   | FileCheck %s --check-prefix=PROP-IPO
// RUN: cir-opt %s -cir-offload-propagate-sycl-kernel-args \
// RUN:   | FileCheck %s --check-prefix=PROP-LEGACY
// RUN: cir-opt %s -cir-offload-propagate-sycl-kernel-args='host-facts=both host-facts-closed-tu=1' \
// RUN:   2>&1 | FileCheck %s --check-prefix=PROP-BOTH
// RUN: cir-opt %s -cir-offload-stamp-reqd-work-group-size='host-facts=ipo host-facts-closed-tu=1' \
// RUN:   | FileCheck %s --check-prefix=STAMP-IPO
// RUN: cir-opt %s -cir-offload-stamp-reqd-work-group-size \
// RUN:   | FileCheck %s --check-prefix=STAMP-LEGACY
// RUN: cir-opt %s -cir-offload-stamp-reqd-work-group-size='host-facts=both host-facts-closed-tu=1 host-facts-census=1' \
// RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=STAMP-BOTH

// Kernel-argument constants and launch geometry from the stored-value
// queries (T23, SYCLHostFacts::constantField and geometry), behind
// --cir-offload-host-facts: ipo replaces KernelBinding::syclConstArgs and the
// launch sites' syclNDRange, both keeps the legacy ones and remarks where
// they differ. The legacy trace recovers neither here (the closure and the
// geometry of the handler path are inside the launch functions' bodies).
//
//  - K1: launched twice with n = 7 over nd_range(1024, 64): the constant 7
//    and the geometry, every launch agreeing (stamped, propagated);
//  - K2: launched with n = 7 over (1024, 64) and n = 8 over (1024, 128): no
//    constant, no local size (the launches disagree);
//  - K3: Bench(int n, size_t g) : size(n), geo(g, 64) {} built by @main with
//    (42, 2048), and Bench::run(h) launching over this->geo with the capture
//    s = this->size: 42 and global=[2048] local=[64] under bottom-up with
//    closed-TU (the record of @bench_run is replaced by its copy in @main's
//    graph, every caller of @bench_run having copied it); open, @bench_run and
//    @bench_ctor may have other callers: neither is known (the "geometry
//    none" case);
//  - K4: a model call (buffer::get_range, through sret) overwrites the range
//    whose element is then captured (9 before the call), and the global range
//    of the nd_range (1024 before the call): neither is known, the local size
//    is;
//  - K5: like K1, but the launch function takes the nd_range by address (no
//    llvm.byval): it may write it, so no geometry.
// In the CI mode (bu=0), @ndr_ctor's formals hold every caller's operands
// and one node stands for every nd_range: no geometry.

// BOTH-LABEL: // - kernel _ZTSZ4mainEUlvE_
// BOTH:   host-facts const-arg n: legacy=none ipo=#cir.int<7> : !cir.int<s, 32>
// BOTH-NEXT:   host-facts geometry: legacy=none ipo=global=[1024] local=[64]
// BOTH-LABEL: // - kernel _ZTSZ4mainEUlvE0_
// BOTH:   host-facts const-arg n: legacy=none ipo=none (the launches disagree: 7 at {{.*}}, 8 at {{.*}})
// BOTH-NEXT:   host-facts geometry: legacy=none ipo=global=[1024] local=[?] (the launches disagree on the local size at {{.*}})
// BOTH-LABEL: // - kernel _ZTSZ4mainEUlvE1_
// BOTH:   host-facts const-arg n: legacy=none ipo=#cir.int<42> : !cir.int<s, 32>
// BOTH-NEXT:   host-facts geometry: legacy=none ipo=global=[2048] local=[64]
// BOTH-LABEL: // - kernel _ZTSZ4mainEUlvE2_
// BOTH:   host-facts const-arg m: legacy=none ipo=none ('m' at the launch at {{.*}}: it holds a value computed at run time ({{.*}}): it is an escaped pointer ("written with an unknown value") ({{.*}}))
// BOTH-NEXT:   host-facts geometry: legacy=none ipo=global=[?] local=[64] (component 0: it may hold a value the analysis does not know: it is an escaped pointer ("written with an unknown value") ({{.*}}))
// BOTH-LABEL: // - kernel _ZTSZ4mainEUlvE3_
// BOTH:   host-facts const-arg n: legacy=none ipo=#cir.int<7> : !cir.int<s, 32>
// BOTH-NEXT:   host-facts geometry: legacy=none ipo=global=[?] local=[?] (component 0: {{.*}}"written with an unknown value"{{.*}})
// BOTH: // host-facts-disagreement: kernel _ZTSZ4mainEUlvE_ const-arg n legacy=none ipo=#cir.int<7> : !cir.int<s, 32>
// BOTH-NEXT: // host-facts-disagreement: kernel _ZTSZ4mainEUlvE1_ const-arg n legacy=none ipo=#cir.int<42> : !cir.int<s, 32>
// BOTH-NEXT: // host-facts-disagreement: kernel _ZTSZ4mainEUlvE3_ const-arg n legacy=none ipo=#cir.int<7> : !cir.int<s, 32>
// BOTH-NEXT: // host-facts-disagreement: kernel _ZTSZ4mainEUlvE_ geometry legacy=none ipo=global=[1024] local=[64]
// BOTH: // host-facts-const-arg-disagreements: 3 of 5 scalar fields
// BOTH-NEXT: // host-facts-geometry-disagreements: 5 of 5 kernels

// OPEN-LABEL: // - kernel _ZTSZ4mainEUlvE_
// OPEN:   host-facts const-arg n: legacy=none ipo=#cir.int<7> : !cir.int<s, 32>
// OPEN-NEXT:   host-facts geometry: legacy=none ipo=global=[1024] local=[64]
// OPEN-LABEL: // - kernel _ZTSZ4mainEUlvE1_
// OPEN:   host-facts const-arg n: legacy=none ipo=none ('n' at the launch at {{.*}}: it holds a value computed at run time ({{.*}}): it is parameter #0 of @bench_run, which may have callers that are not analysed ({{.*}}))
// OPEN-NEXT:   host-facts geometry: legacy=none ipo=global=[?] local=[?] (component 0: it may hold a value the analysis does not know: it is parameter #0 of @bench_run, which may have callers that are not analysed ({{.*}}))

// CI-LABEL: // - kernel _ZTSZ4mainEUlvE_
// CI:   host-facts const-arg n: legacy=none ipo=#cir.int<7> : !cir.int<s, 32>
// CI-NEXT:   host-facts geometry: legacy=none ipo=global=[?] local=[?] ({{.*}})
// CI-LABEL: // - kernel _ZTSZ4mainEUlvE1_
// CI:   host-facts const-arg n: legacy=none ipo=none ({{.*}})
// CI-NEXT:   host-facts geometry: legacy=none ipo=global=[?] local=[?] ({{.*}})

// The ipo table: the constants and the geometry of every launch site.
// TABLE-IPO-LABEL: // - kernel _ZTSZ4mainEUlvE_
// TABLE-IPO:   const-args n=#cir.int<7> : !cir.int<s, 32>
// TABLE-IPO:   launch in @pf_K1 (sycl, all-visible), closure none, global=[1024], local=[64]
// TABLE-IPO-LABEL: // - kernel _ZTSZ4mainEUlvE0_
// TABLE-IPO-NOT: const-args
// TABLE-IPO:   launch in @pf_K2 (sycl, all-visible), closure none, global=[1024], local=[?]

// PROP-IPO-LABEL: cir.func @_ZTSZ4mainEUlvE_(
// PROP-IPO-NEXT:    %[[C:.*]] = cir.const #cir.int<7> : !s32i
// PROP-IPO:         cir.store %[[C]], {{.*}} : !s32i, !cir.ptr<!s32i>
// PROP-IPO-LABEL: cir.func @_ZTSZ4mainEUlvE0_(
// PROP-IPO:         cir.store %arg0, {{.*}} : !s32i, !cir.ptr<!s32i>
// PROP-IPO-LABEL: cir.func @_ZTSZ4mainEUlvE1_(
// PROP-IPO-NEXT:    %[[C:.*]] = cir.const #cir.int<42> : !s32i
// PROP-IPO-LABEL: cir.func @_ZTSZ4mainEUlvE2_(
// PROP-IPO:         cir.store %arg0, {{.*}} : !u64i, !cir.ptr<!u64i>

// PROP-LEGACY-LABEL: module @device_sycl_spir64
// PROP-LEGACY-NOT: cir.const #cir.int<7>
// PROP-LEGACY-NOT: cir.const #cir.int<42>

// PROP-BOTH: remark: host-facts-disagreement: kernel _ZTSZ4mainEUlvE_ const-arg n legacy=none ipo=#cir.int<7> : !cir.int<s, 32>
// PROP-BOTH: remark: host-facts-disagreement: kernel _ZTSZ4mainEUlvE1_ const-arg n legacy=none ipo=#cir.int<42> : !cir.int<s, 32>
// PROP-BOTH: remark: host-facts-disagreement: kernel _ZTSZ4mainEUlvE3_ const-arg n legacy=none ipo=#cir.int<7> : !cir.int<s, 32>
// PROP-BOTH: remark: host-facts-disagreements: 3 of 5 scalar capture fields (closed-tu, bu, subobjects)
// PROP-BOTH-LABEL: module @device_sycl_spir64
// PROP-BOTH-NOT: cir.const #cir.int<7>

// STAMP-IPO: cir.func @_ZTSZ4mainEUlvE_({{.*}}cir.reqd_work_group_size = [64 : i32]
// STAMP-IPO-NOT: reqd_work_group_size
// STAMP-IPO: cir.func @_ZTSZ4mainEUlvE1_({{.*}}cir.reqd_work_group_size = [64 : i32]
// STAMP-IPO: cir.func @_ZTSZ4mainEUlvE2_({{.*}}cir.reqd_work_group_size = [64 : i32]
// STAMP-IPO-NOT: reqd_work_group_size

// STAMP-LEGACY-NOT: reqd_work_group_size

// STAMP-BOTH: remark: host-facts-disagreement: kernel _ZTSZ4mainEUlvE_ geometry legacy=none ipo=global=[1024] local=[64]
// STAMP-BOTH: remark: host-facts: kernel _ZTSZ4mainEUlvE_ reqd-work-group-size legacy=none ipo=[64]
// STAMP-BOTH: remark: host-facts: kernel _ZTSZ4mainEUlvE0_ reqd-work-group-size legacy=none ipo=none
// STAMP-BOTH: remark: host-facts: kernel _ZTSZ4mainEUlvE1_ reqd-work-group-size legacy=none ipo=[64]
// STAMP-BOTH: remark: host-facts: kernel _ZTSZ4mainEUlvE3_ reqd-work-group-size legacy=none ipo=none
// STAMP-BOTH: remark: host-facts-disagreements: 5 of 5 kernel geometries (closed-tu, bu, subobjects)

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!f32 = !cir.float
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_arr = !cir.struct<class "sycl::_V1::detail::array<1>" {data !cir.array<!u64i x 1>}>
!rec_range = !cir.struct<class "sycl::_V1::range<1>" {data !rec_arr}>
!rec_id = !cir.struct<class "sycl::_V1::id<1>" {data !rec_arr}>
!rec_ndr = !cir.struct<class "sycl::_V1::nd_range<1>" {data !rec_range, data !rec_range, data !rec_id}>
!rec_handler = !cir.struct<class "sycl::_V1::handler" {data !cir.ptr<!s8i>}>
!rec_buf = !cir.struct<class "sycl::_V1::buffer<float, 1>" {data !cir.ptr<!s8i>, data !u64i}>
!rec_lam = !cir.struct<"lam" {data !s32i, data !cir.ptr<!f32>}>
!rec_lam4 = !cir.struct<"lam4" {data !u64i}>
!rec_bench = !cir.struct<class "Bench" {data !s32i, data !rec_ndr}>

module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.func private @malloc_device(!u64i) -> !cir.ptr<!f32> attributes {cir.sycl_host_api = "usm.alloc", cir.sycl_host_api_arg = 0 : i32}
    cir.func private @buffer_alloc(!cir.ptr<!rec_buf>, !cir.ptr<!rec_range>) attributes {cir.sycl_host_api = "buffer.alloc", cir.sycl_host_api_arg = 0 : i32}
    cir.func private @buffer_get_range(!cir.ptr<!rec_range> {llvm.sret = !rec_range}, !cir.ptr<!rec_buf>) attributes {cir.sycl_host_api = "buffer.query", cir.sycl_host_api_arg = 0 : i32}
    cir.func private @_ZN4sycl3_V17handler22setDeviceKernelInfoPtrEPv(!cir.ptr<!rec_handler>, !cir.ptr<!s8i>) attributes {cir.sycl_host_api = "handler.set_kernel_info", cir.sycl_host_api_arg = 0 : i32}
    cir.global "private" constant cir_private @".strK1" = #cir.const_array<"_ZTSZ4mainEUlvE_" : !cir.array<!s8i x 16>, trailing_zeros> : !cir.array<!s8i x 17>
    cir.global "private" constant internal @_ZN4sycl3_V16detail21CompileTimeKernelInfoIK1EE = #cir.const_record<{#cir.const_record<{#cir.global_view<@".strK1"> : !cir.ptr<!s8i>, #cir.int<16> : !u64i}> : !rec_sv}> : !rec_ctki
    cir.global "private" constant cir_private @".strK2" = #cir.const_array<"_ZTSZ4mainEUlvE0_" : !cir.array<!s8i x 17>, trailing_zeros> : !cir.array<!s8i x 18>
    cir.global "private" constant internal @_ZN4sycl3_V16detail21CompileTimeKernelInfoIK2EE = #cir.const_record<{#cir.const_record<{#cir.global_view<@".strK2"> : !cir.ptr<!s8i>, #cir.int<17> : !u64i}> : !rec_sv}> : !rec_ctki
    cir.global "private" constant cir_private @".strK3" = #cir.const_array<"_ZTSZ4mainEUlvE1_" : !cir.array<!s8i x 17>, trailing_zeros> : !cir.array<!s8i x 18>
    cir.global "private" constant internal @_ZN4sycl3_V16detail21CompileTimeKernelInfoIK3EE = #cir.const_record<{#cir.const_record<{#cir.global_view<@".strK3"> : !cir.ptr<!s8i>, #cir.int<17> : !u64i}> : !rec_sv}> : !rec_ctki
    cir.global "private" constant cir_private @".strK4" = #cir.const_array<"_ZTSZ4mainEUlvE2_" : !cir.array<!s8i x 17>, trailing_zeros> : !cir.array<!s8i x 18>
    cir.global "private" constant internal @_ZN4sycl3_V16detail21CompileTimeKernelInfoIK4EE = #cir.const_record<{#cir.const_record<{#cir.global_view<@".strK4"> : !cir.ptr<!s8i>, #cir.int<17> : !u64i}> : !rec_sv}> : !rec_ctki
    cir.global "private" constant cir_private @".strK5" = #cir.const_array<"_ZTSZ4mainEUlvE3_" : !cir.array<!s8i x 17>, trailing_zeros> : !cir.array<!s8i x 18>
    cir.global "private" constant internal @_ZN4sycl3_V16detail21CompileTimeKernelInfoIK5EE = #cir.const_record<{#cir.const_record<{#cir.global_view<@".strK5"> : !cir.ptr<!s8i>, #cir.int<17> : !u64i}> : !rec_sv}> : !rec_ctki
    cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIK1EEPv() -> !cir.ptr<!s8i> attributes {cir.sycl_host_api = "kernel.info", cir.sycl_host_api_arg = 0 : i32} {
      %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIK1EE : !cir.ptr<!rec_ctki>
      %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
    // handler::parallel_for<K1>(nd_range, lambda): replaced by the launch model.
    cir.func internal @pf_K1(%h: !cir.ptr<!rec_handler>, %r: !cir.ptr<!rec_ndr> {llvm.byval = !rec_ndr}, %k: !cir.ptr<!rec_lam>) attributes {cir.sycl_host_api = "handler.kernel", cir.sycl_host_api_arg = 1 : i32} {
      %dki = cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoIK1EEPv() : () -> !cir.ptr<!s8i>
      cir.call @_ZN4sycl3_V17handler22setDeviceKernelInfoPtrEPv(%h, %dki) : (!cir.ptr<!rec_handler>, !cir.ptr<!s8i>) -> ()
      cir.return
    }
    cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIK2EEPv() -> !cir.ptr<!s8i> attributes {cir.sycl_host_api = "kernel.info", cir.sycl_host_api_arg = 0 : i32} {
      %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIK2EE : !cir.ptr<!rec_ctki>
      %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
