      cir.return %1 : !cir.ptr<!s8i>
    }
    // handler::parallel_for<K4>(nd_range, lambda): replaced by the launch model.
    cir.func internal @pf_K4(%h: !cir.ptr<!rec_handler>, %r: !cir.ptr<!rec_ndr> {llvm.byval = !rec_ndr}, %k: !cir.ptr<!rec_lam4>) attributes {cir.sycl_host_api = "handler.kernel", cir.sycl_host_api_arg = 1 : i32} {
      %dki = cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoIK4EEPv() : () -> !cir.ptr<!s8i>
      cir.call @_ZN4sycl3_V17handler22setDeviceKernelInfoPtrEPv(%h, %dki) : (!cir.ptr<!rec_handler>, !cir.ptr<!s8i>) -> ()
      cir.return
    }
    cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIK5EEPv() -> !cir.ptr<!s8i> attributes {cir.sycl_host_api = "kernel.info", cir.sycl_host_api_arg = 0 : i32} {
      %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIK5EE : !cir.ptr<!rec_ctki>
      %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
