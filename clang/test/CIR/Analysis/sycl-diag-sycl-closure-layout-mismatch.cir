// one `long` (equal size): the offset 0 kinds differ and the leaf counts differ.

!s8i = !cir.int<s, 8>
!s16i = !cir.int<s, 16>
!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>
