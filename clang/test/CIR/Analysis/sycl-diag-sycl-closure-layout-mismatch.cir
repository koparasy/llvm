// RUN: cir-opt %s -split-input-file -verify-diagnostics \
// RUN:   -pass-pipeline="builtin.module(cir-offload-detect-host-device-closure-layout-mismatch)"
// RUN: cir-opt %s -split-input-file \
// RUN:   -pass-pipeline="builtin.module(cir-offload-detect-host-device-closure-layout-mismatch{report-unchecked=true})" \
// RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=UNCHECKED

// [sycl-closure-layout-mismatch]: a SYCL kernel lambda is compiled for the host
// and for the device; `#ifdef __SYCL_DEVICE_ONLY__` or divergent `[=]` captures
// can give the two closures different layouts of the same total size, which the
// `sizeof(KernelType) == KernelSize` static_assert does not catch. The check
// pairs the host closure (the record the host HostKernelRef/HostKernel
// constructor wraps) with the device closure (the cir.sycl_kernel_object
// alloca) by kernel binding, flattens both with their module's DataLayout and
// compares offset, size and kind of each leaf. Record names, pointer address
// spaces and pointees, padding, and the representation of SYCL library types
// are ignored. Captured accessors are checked against the kernel parameters
// they decompose into. Each case below is one container.

// -----
// POSITIVE: int vs float of the same size. Field 'b' is `int` on the host
// and `float` on the device (#ifdef __SYCL_DEVICE_ONLY__ around its declaration).

!s8i = !cir.int<s, 8>
!s16i = !cir.int<s, 16>
!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>
!u8i = !cir.int<u, 8>
!u16i = !cir.int<u, 16>
!u64i = !cir.int<u, 64>
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_hkrbase = !cir.struct<"hkrbase" {data !u64i}>
!rec_hlam = !cir.struct<"anon.0" {data !cir.ptr<!s32i>, data !s32i}>
!rec_dlam = !cir.struct<"__cir_lowered.anon.0" {data !cir.ptr<!s32i, target_address_space(4)>, data !cir.float}>
!rec_hkr = !cir.struct<"hkr" {data !rec_hkrbase, data !cir.ptr<!rec_hlam>}>
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_ZTSZ4mainEUlvE_" : !cir.array<!s8i x 16>, trailing_zeros> : !cir.array<!s8i x 17>
    cir.global "private" constant internal @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE = #cir.const_record<{#cir.const_record<{#cir.global_view<@".str"> : !cir.ptr<!s8i>, #cir.int<16> : !u64i}> : !rec_sv}> : !rec_ctki
    cir.func private @_ZN4sycl3_V16detail13HostKernelRefC2E(!cir.ptr<!rec_hkr>, !cir.ptr<!rec_hlam>) attributes {cir.sycl_host_api = "hostkernel.ctor", cir.sycl_host_api_arg = 0 : i32}
    cir.func private @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>) attributes {cir.sycl_host_api = "launch.direct_impl", cir.sycl_host_api_arg = 2 : i32}
    cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() -> !cir.ptr<!s8i> attributes {cir.sycl_host_api = "kernel.info"} {
      %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE : !cir.ptr<!rec_ctki>
      %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
    cir.func @main(%ev: !cir.ptr<!s8i>, %q: !cir.ptr<!s8i>, %geom: !cir.ptr<!s8i>) {
      %lam = cir.alloca "lam" align(8) : !cir.ptr<!rec_hlam>
      %hkr = cir.alloca "hkr" align(8) : !cir.ptr<!rec_hkr>
      cir.call @_ZN4sycl3_V16detail13HostKernelRefC2E(%hkr, %lam) : (!cir.ptr<!rec_hkr>, !cir.ptr<!rec_hlam>) -> ()
      %base = cir.base_class_addr nonnull %hkr [0] : !cir.ptr<!rec_hkr> -> !cir.ptr<!rec_hkrbase>
      %dki = cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() : () -> !cir.ptr<!s8i>
      cir.call @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(%ev, %q, %geom, %base, %dki) : (!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>) -> ()
      cir.return
    }
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>} {
    // expected-note@+1 {{in the SYCL kernel defined here}}
    cir.func @_ZTSZ4mainEUlvE_(%p: !cir.ptr<!s32i, target_address_space(1)>, %b: !cir.float) cc(spir_kernel) {
      %clos = cir.alloca "clos" align(8) : !cir.ptr<!rec_dlam> {cir.sycl_kernel_object}
      %f0 = cir.get_member %clos[0] {name = "out"} : !cir.ptr<!rec_dlam> -> !cir.ptr<!cir.ptr<!s32i, target_address_space(4)>>
      // expected-warning@+1 {{SYCL kernel captured-closure layout differs between host and device (captured field 'b': host: int32 at offset 8, device: float at offset 8); likely a #ifdef __SYCL_DEVICE_ONLY__ or divergent [=] capture -- undefined behavior [sycl-closure-layout-mismatch]}}
      %f1 = cir.get_member %clos[1] {name = "b"} : !cir.ptr<!rec_dlam> -> !cir.ptr<!cir.float>
      cir.return
    }
  }
}

// -----
// POSITIVE: a pointer on the host, a 64-bit integer on the device.

!s8i = !cir.int<s, 8>
!s16i = !cir.int<s, 16>
!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>
!u8i = !cir.int<u, 8>
!u16i = !cir.int<u, 16>
!u64i = !cir.int<u, 64>
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_hkrbase = !cir.struct<"hkrbase" {data !u64i}>
!rec_hlam = !cir.struct<"anon.0" {data !cir.ptr<!cir.float>, data !s32i}>
!rec_dlam = !cir.struct<"__cir_lowered.anon.0" {data !s64i, data !s32i}>
!rec_hkr = !cir.struct<"hkr" {data !rec_hkrbase, data !cir.ptr<!rec_hlam>}>
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_ZTSZ4mainEUlvE_" : !cir.array<!s8i x 16>, trailing_zeros> : !cir.array<!s8i x 17>
    cir.global "private" constant internal @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE = #cir.const_record<{#cir.const_record<{#cir.global_view<@".str"> : !cir.ptr<!s8i>, #cir.int<16> : !u64i}> : !rec_sv}> : !rec_ctki
    cir.func private @_ZN4sycl3_V16detail13HostKernelRefC2E(!cir.ptr<!rec_hkr>, !cir.ptr<!rec_hlam>) attributes {cir.sycl_host_api = "hostkernel.ctor", cir.sycl_host_api_arg = 0 : i32}
    cir.func private @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>) attributes {cir.sycl_host_api = "launch.direct_impl", cir.sycl_host_api_arg = 2 : i32}
    cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() -> !cir.ptr<!s8i> attributes {cir.sycl_host_api = "kernel.info"} {
      %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE : !cir.ptr<!rec_ctki>
      %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
    cir.func @main(%ev: !cir.ptr<!s8i>, %q: !cir.ptr<!s8i>, %geom: !cir.ptr<!s8i>) {
      %lam = cir.alloca "lam" align(8) : !cir.ptr<!rec_hlam>
      %hkr = cir.alloca "hkr" align(8) : !cir.ptr<!rec_hkr>
      cir.call @_ZN4sycl3_V16detail13HostKernelRefC2E(%hkr, %lam) : (!cir.ptr<!rec_hkr>, !cir.ptr<!rec_hlam>) -> ()
      %base = cir.base_class_addr nonnull %hkr [0] : !cir.ptr<!rec_hkr> -> !cir.ptr<!rec_hkrbase>
      %dki = cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() : () -> !cir.ptr<!s8i>
      cir.call @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(%ev, %q, %geom, %base, %dki) : (!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>) -> ()
      cir.return
    }
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>} {
    // expected-note@+1 {{in the SYCL kernel defined here}}
    cir.func @_ZTSZ4mainEUlvE_(%p: !s64i, %b: !s32i) cc(spir_kernel) {
      %clos = cir.alloca "clos" align(8) : !cir.ptr<!rec_dlam> {cir.sycl_kernel_object}
      // expected-warning@+1 {{SYCL kernel captured-closure layout differs between host and device (captured field 'p': host: pointer at offset 0, device: int64 at offset 0); likely a #ifdef __SYCL_DEVICE_ONLY__ or divergent [=] capture -- undefined behavior [sycl-closure-layout-mismatch]}}
      %f0 = cir.get_member %clos[0] {name = "p"} : !cir.ptr<!rec_dlam> -> !cir.ptr<!s64i>
      %f1 = cir.get_member %clos[1] {name = "b"} : !cir.ptr<!rec_dlam> -> !cir.ptr<!s32i>
      cir.return
    }
  }
}

// -----
// POSITIVE: a member of a captured struct diverges: S::y is `float` on the
// host and `int` on the device. The records are recursed into by structure.

!s8i = !cir.int<s, 8>
!s16i = !cir.int<s, 16>
!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>
!u8i = !cir.int<u, 8>
!u16i = !cir.int<u, 16>
!u64i = !cir.int<u, 64>
