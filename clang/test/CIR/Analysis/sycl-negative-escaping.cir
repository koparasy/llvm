// RUN: cir-opt %s -cir-points-to-verify -test-cir-points-to='mode=bu sycl=1 closed-tu=1 subobjects=1' -o /dev/null 2>&1 | FileCheck %s
// RUN: cir-opt %s -cir-points-to-verify -test-cir-points-to='mode=bu sycl=1' -o /dev/null 2>&1 | FileCheck %s --check-prefix=OPEN
//
// Corpus T30 N (T27): buffers whose handles come from outside or escape
// before the launch.
//  - KPARAM: the buffers are parameters of the externally visible
//    launch_param. Without closed-tu another TU may pass any buffers (the
//    same one twice): unknown. Under closed-tu every caller is in the
//    module (entry passes two local buffers): noalias.
//  - KINTEROP: an interop buffer (make_buffer, buffer.other): its storage is
//    the backend's, unknown.
//  - KGLOBAL: &A is stored into a global visible to other TUs before the
//    launch: code we don't see may assign the handle (External), unknown.
//  - KUNKNOWN: &A is passed to a declaration before the launch: the same.
//  - KLOCAL: positive control, two local buffers.
// In every case the other buffer (b) stays complete.
//
// The input is generated by /localdisk3/kparasyr/ipo-aa/t27/tests/neg/gen.py
// from escaping.cpp (a reduced SYCL host API, sycl-mock.h):
//
//   template <class K> static void launch2(queue &q, buffer<float, 1> &A,
//                                          buffer<float, 1> &B);
//                       // submit, accessors a(A), b(B), role_parallel_for<K>
//   void launch_param(queue &q, buffer<float, 1> &A, buffer<float, 1> &B) {
//     launch2<KPARAM>(q, A, B);
//   }
//   static void launch_interop(...) { role_buffer_other(&A, mem); ... }
//   static void launch_global(...)  { ...; G = &A; launch2<KGLOBAL>(q, A, B); }
//   static void launch_unknown(...) { ...; ext_keep(&A); launch2<KUNKNOWN>(...); }
//   static void launch_local(...)   { ...; launch2<KLOCAL>(q, A, B); }
//   void entry(queue &q, const range<1> &r, void *mem);  // calls all five

// CHECK-LABEL: === launches
// CHECK:        kernel _ZTS6KPARAM
// CHECK-NEXT:     field a accessor storage={{n[0-9]+}}+0 [Ghost|External|Ref] origins=1 host=none complete
// CHECK-NEXT:     field b accessor storage={{n[0-9]+}}+0 [Ghost|External|Ref] origins=1 host=none complete
// CHECK-NEXT:     no-alias a b
// CHECK:        kernel _ZTS8KINTEROP
// CHECK-NEXT:     field a accessor {{.*}} unknown (accessor 'a': the storage {{n[0-9]+}} is made by buffer.other, which the analysis cannot place)
// CHECK-NEXT:     field b accessor {{.*}} complete
// CHECK-NEXT:     no-alias{{$}}
// CHECK:        kernel _ZTS7KGLOBAL
// CHECK-NEXT:     field a accessor storage={{n[0-9]+}}+0 [Ghost|Incomplete|External|Ref] {{.*}} unknown (accessor 'a': a handle of storage {{n[0-9]+}} ({{n[0-9]+}}) may be assigned by code we don't see: it is reachable from an escaped pointer stored in a global visible to other translation units ({{.*}}))
// CHECK-NEXT:     field b accessor {{.*}} complete
// CHECK-NEXT:     no-alias{{$}}
// CHECK:        kernel _ZTS8KUNKNOWN
// CHECK-NEXT:     field a accessor {{.*}} unknown (accessor 'a': a handle of storage {{n[0-9]+}} ({{n[0-9]+}}) may be assigned by code we don't see: it is an escaped pointer passed to @_Z8ext_keepPN4sycl3_V16bufferIfLi1EEE ({{.*}}))
// CHECK-NEXT:     field b accessor {{.*}} complete
// CHECK-NEXT:     no-alias{{$}}
// CHECK:        kernel _ZTS6KLOCAL
// CHECK-NEXT:     field a accessor {{.*}} complete
// CHECK-NEXT:     field b accessor {{.*}} complete
// CHECK-NEXT:     no-alias a b
// CHECK: kernel _ZTS6KPARAM: no-alias a b
// CHECK: kernel _ZTS8KINTEROP: no-alias{{$}}
// CHECK: kernel _ZTS7KGLOBAL: no-alias{{$}}
// CHECK: kernel _ZTS8KUNKNOWN: no-alias{{$}}
// CHECK: kernel _ZTS6KLOCAL: no-alias a b
//
// OPEN-LABEL: === launches
// OPEN:        kernel _ZTS6KPARAM
// OPEN-NEXT:     field a accessor {{.*}} unknown (accessor 'a': {{n[0-9]+}} has no allocation site the analysis sees)
// OPEN: kernel _ZTS6KPARAM: no-alias{{$}}
// OPEN: kernel _ZTS8KINTEROP: no-alias{{$}}
// OPEN: kernel _ZTS7KGLOBAL: no-alias{{$}}
// OPEN: kernel _ZTS8KUNKNOWN: no-alias{{$}}

