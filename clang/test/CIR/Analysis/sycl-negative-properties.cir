// RUN: cir-opt %s -cir-points-to-verify -test-cir-points-to='mode=bu sycl=1 closed-tu=1 subobjects=1 values=1' -o /dev/null 2>&1 | FileCheck %s
// RUN: cir-opt %s -cir-points-to-verify -test-cir-points-to='mode=ci sycl=1 closed-tu=1 values=1' -o /dev/null 2>&1 | FileCheck %s
//
// use_mutex, set_final_data and host_access keep the host memory written
// (T27). Every host value below was stored a constant before the buffers
// were made, and none may be read back as that constant:
//  - in (h1[0], buffer A with a use_mutex property): the runtime keeps the
//    property list and the mutex it names (PI 5904-5912), and may write h1
//    while the buffer lives (AsyncAccess on buffer.host_ptr's host memory;
//    h2 and h4, whose lists are built from no property, are not);
//  - ms (m.state): the mutex is written by the runtime (the property list's
//    reach gets the unknown-call rule);
//  - r4 (h4[0], after a host_accessor of D): the host accessor makes the
//    buffer's data available on the host;
//  - r2 (fin[0], after B's destructor, set_final_data(fin)): the write-back
//    destination;
//  - c0: a local no buffer reaches: still a strong constant (control).
// The two accessors stay noalias: what the runtime does with the host
// memory says nothing about the storages.
//
// The input is generated by /localdisk3/kparasyr/ipo-aa/t27/tests/neg/gen.py
// from props.cpp (a reduced SYCL host API, sycl-mock.h):
//
//   float h1[16], h2[16], h4[16], fin[16];
//   std::mutex m;                  // struct mutex { int state; }
//   m.state = 0; h1[0] = 1; h4[0] = 1; fin[0] = 1; int c0 = 7;
//   use_mutex um{&m};
//   property_list withMutex{um}, none{}, none2{};  // property_list<Ps...>(Ps...)
//   buffer<float, 1> A, B, D;
//   role_buffer_host_ptr(&A, h1, r, withMutex);
//   role_buffer_host_ptr(&B, h2, r, none);
//   role_buffer_set_final_data(&B, fin);
//   role_buffer_host_ptr(&D, h4, r, none2);
//   role_submit(&q, ...);          // KPROPS: accessors a(A), b(B)
//   float in = h1[0];
//   { host_accessor<float, 1> ha = role_buffer_host_access(&D); }
//   float r4 = h4[0];
//   role_buffer_dtor(&B);
//   float r2 = fin[0];
//   int ms = m.state;
//   return (int)(in + r2 + r4) + ms + c0;

// CHECK-LABEL: === TU graph
// CHECK-DAG: [Stack|External|Mod|Ref|AsyncAccess] size=64 origins={stack(cir.alloca 'h1'
// CHECK-DAG: [Stack|External|Mod|Ref] size=64 origins={stack(cir.alloca 'h2'
// CHECK-DAG: [Stack|Mod|Ref] size=64 origins={stack(cir.alloca 'h4'
// CHECK-DAG: [Stack|External|Mod|Ref] size=4 origins={stack(cir.alloca 'm'
// CHECK-LABEL: === values
// CHECK-NEXT: in: {#cir.fp<1.000000e+00> : !cir.float} defs=0 incomplete
// CHECK-NEXT: r4: {#cir.fp<1.000000e+00> : !cir.float} defs=0 incomplete
// CHECK-NEXT: r2: {#cir.fp<1.000000e+00> : !cir.float} defs=0 incomplete
// CHECK-NEXT: ms: {#cir.int<0> : !cir.int<s, 32>} defs=0 incomplete
// CHECK-NEXT: c0: {#cir.int<7> : !cir.int<s, 32>} defs=0 complete strong
// CHECK-LABEL: === launches
// CHECK:        kernel _ZTS6KPROPS
// CHECK-NEXT:     field a accessor storage={{n[0-9]+}}+0 {{.*}} host={{n[0-9]+}}+0 [Stack|External|Mod|Ref|AsyncAccess] complete
// CHECK-NEXT:     field b accessor storage={{n[0-9]+}}+0 {{.*}} host={{n[0-9]+}}+0 [Stack|External|Mod|Ref] complete
// CHECK-NEXT:     no-alias a b
// CHECK: kernel _ZTS6KPROPS: no-alias a b

