// RUN: cir-opt %s -cir-points-to-verify -test-cir-points-to='mode=ci sycl=1 closed-tu=1' -o /dev/null 2>&1 | FileCheck %s --check-prefix=CHECK
// RUN: cir-opt %s -cir-points-to-verify -test-cir-points-to='mode=bu sycl=1 closed-tu=1 subobjects=1' -o /dev/null 2>&1 | FileCheck %s --check-prefix=CHECK
// RUN: cir-opt %s -cir-points-to-verify -test-cir-points-to='mode=ci sycl=1' -o /dev/null 2>&1 | FileCheck %s --check-prefix=OPEN
//
// Corpus T31 P/N (T27): a handler-submit launch inside a std::thread lambda,
// ced's shape, and the same launch through an external thread pool.
//  - KTHREAD: run_thread's three buffers reach the launch through the
//    thread's lambda, its _State_impl (the std::thread model resolves
//    _M_start_thread's _M_run from the state's vtable), queue::submit's
//    cgfo invoker and the CGF. Under closed-tu the three storages are
//    complete and distinct: noalias. They are AsyncAccess (the thread runs
//    concurrently with run_thread), which says nothing about aliasing.
//  - KPOOL: pool_enqueue is a declaration: the task and what it reaches
//    escape, and pool_body, whose address is taken, has incomplete
//    formals. The storages have no allocation site the analysis sees.
//  - Without closed-tu, the functions of the CGF invoker and of the vtable
//    may have unknown callers: neither kernel's storages are known.
//
// The input is generated by /localdisk3/kparasyr/ipo-aa/t27/tests/neg/gen.py
// from thread.cpp: clang -fclangir -emit-cir -O0 of a reduced SYCL host API
// (sycl-mock.h: the role_* functions are tagged with their
// cir.sycl_host_api role) and a reduced libstdc++ std::thread (the classes,
// members and manglings of <bits/std_thread.h>):
//
//   static void run_thread(queue &q, const range<1> &r) {
//     buffer<float, 1> A, B, C;           // role_buffer_alloc(&A, r), ...
//     std::thread t([&] {
//       role_submit(&q, [&](handler &h) {
//         accessor<float, 1> a, b, c;     // role_accessor_from_buffer(&a, &A, &h)
//         role_parallel_for<KTHREAD>(&h, [=] { (void)a, (void)b, (void)c; });
//       });
//     });
//     t.join();
//   }
//   struct PoolTask { queue *q; buffer<float, 1> *A, *B, *C; };
//   static void pool_body(void *p) { ... the same submit, KPOOL, on *p ... }
//   static void run_pool(queue &q, const range<1> &r) {
//     buffer<float, 1> A, B, C;
//     PoolTask task{&q, &A, &B, &C};
//     pool_enqueue(&pool_body, &task);    // a declaration
//   }

// CHECK-LABEL: === launches
// CHECK: launch @{{.*}}run_thread{{.*}} handler.kernel {{.*}}kernels={_ZTS7KTHREAD}
// CHECK-NEXT:   kernel _ZTS7KTHREAD
// CHECK-NEXT:     field a accessor storage=[[SA:n[0-9]+]]+0 [Ghost|External|Ref|AsyncAccess] origins=1 host=none complete
// CHECK-NEXT:     field b accessor storage=[[SB:n[0-9]+]]+0 [Ghost|External|Ref|AsyncAccess] origins=1 host=none complete
// CHECK-NEXT:     field c accessor storage=[[SC:n[0-9]+]]+0 [Ghost|External|Ref|AsyncAccess] origins=1 host=none complete
// CHECK-NEXT:     no-alias a b c
// CHECK: launch @_ZZL9pool_bodyPvENK3$_0clERN4sycl3_V17handlerE handler.kernel {{.*}}kernels={_ZTS5KPOOL}
// CHECK-NEXT:   kernel _ZTS5KPOOL
// CHECK-NEXT:     field a accessor {{.*}} unknown (accessor 'a': {{n[0-9]+}} has no allocation site the analysis sees)
// CHECK-NEXT:     field b accessor {{.*}} unknown (accessor 'b': {{n[0-9]+}} has no allocation site the analysis sees)
// CHECK-NEXT:     field c accessor {{.*}} unknown (accessor 'c': {{n[0-9]+}} has no allocation site the analysis sees)
// CHECK-NEXT:     no-alias{{$}}
// CHECK: kernel _ZTS7KTHREAD: no-alias a b c
// CHECK: kernel _ZTS5KPOOL: no-alias{{$}}
//
// OPEN-LABEL: === launches
// OPEN: kernel _ZTS7KTHREAD: no-alias{{$}}
// OPEN: kernel _ZTS5KPOOL: no-alias{{$}}

