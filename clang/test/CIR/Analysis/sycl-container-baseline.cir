// RUN: cir-opt %s \
// RUN:   -pass-pipeline="builtin.module(test-print-kernel-bindings)" \
// RUN:   2>&1 | FileCheck %s --check-prefix=BIND
// RUN: cir-opt %s \
// RUN:   -pass-pipeline="builtin.module(cir-offload-dead-kernel-elimination)" \
// RUN:   | FileCheck %s --check-prefix=DKE

// SYCL binding: the KernelBindingTable now recognizes SYCL kernels. A device
// spir_kernel binds to the host string constant equal to its mangled name (the
// FreeFunctionInfoData::getFunctionName string), counted because host code
// references that string. This FFK is a named free function, so it is marked
// conservative (cross-TU / by-name reachable). DKE is still CUDA-shaped
// (isDeviceKernel matches PTX/AMDGPU, not SpirKernel) and leaves SYCL kernels
// untouched -- SYCL launch-discovery + DKE land later.

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>, cir.triple = "x86_64-unknown-linux-gnu"} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_Z21__sycl_kernel_vec_addPKfS0_Pf" : !cir.array<!s8i x 33>, trailing_zeros> : !cir.array<!s8i x 34>
    cir.func @getFunctionName() -> !cir.ptr<!s8i> {
      %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 34>>
      %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 34>> -> !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
    cir.func @main() -> !s32i {
      %0 = cir.const #cir.int<0> : !s32i
      cir.return %0 : !s32i
    }
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>, cir.triple = "spir64-unknown-unknown"} {
    cir.func @_Z21__sycl_kernel_vec_addPKfS0_Pf(
        %arg0: !cir.ptr<!cir.float, target_address_space(1)>,
        %arg1: !cir.ptr<!cir.float, target_address_space(1)>,
        %arg2: !cir.ptr<!cir.float, target_address_space(1)>) cc(spir_kernel) {
      cir.return
    }
  }
}

// The SYCL FFK binds to its host name string and is classified conservative.
// BIND: KernelBindingTable
// BIND-NEXT: size 1 empty false
// BIND-NEXT: kernel _Z21__sycl_kernel_vec_addPKfS0_Pf
// BIND-NEXT: host-name @.str (sycl, conservative)
// BIND-NEXT: device @device_sycl_spir64 : @_Z21__sycl_kernel_vec_addPKfS0_Pf
// BIND-NEXT: <no launch site>

// DKE does not yet touch SYCL kernels, so it survives untouched.
// DKE-LABEL: cir.offload.container
// DKE: cir.func @_Z21__sycl_kernel_vec_addPKfS0_Pf({{.*}}) cc(spir_kernel)
