  cir.call @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(%ev, %q, %view, %base, %dki) : (!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_view>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>) -> ()
  cir.return
}
cir.func @main(%ev: !cir.ptr<!s8i>, %q: !cir.ptr<!s8i>, %h: !cir.ptr<!s8i>, %r: !cir.ptr<!rec_range>, %n: !u64i) {
  %bench = cir.alloca "bench" align(8) : !cir.ptr<!rec_bench>
  cir.call @setup(%bench, %r, %n) : (!cir.ptr<!rec_bench>, !cir.ptr<!rec_range>, !u64i) -> ()
  cir.call @run(%bench, %ev, %q, %h) : (!cir.ptr<!rec_bench>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>) -> ()
  cir.return
}
}

