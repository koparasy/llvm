// Bench::setup(): constructs both member buffers and allocates both
// member USM pointers.
cir.func @setup(%this: !cir.ptr<!rec_bench>, %r: !cir.ptr<!rec_range>, %n: !u64i) {
  %a = cir.get_member %this[0] {name = "a"} : !cir.ptr<!rec_bench> -> !cir.ptr<!rec_buf>
  cir.call @buffer_alloc(%a, %r) : (!cir.ptr<!rec_buf>, !cir.ptr<!rec_range>) -> ()
  %b = cir.get_member %this[1] {name = "b"} : !cir.ptr<!rec_bench> -> !cir.ptr<!rec_buf>
  cir.call @buffer_alloc(%b, %r) : (!cir.ptr<!rec_buf>, !cir.ptr<!rec_range>) -> ()
  %p = cir.get_member %this[2] {name = "p"} : !cir.ptr<!rec_bench> -> !cir.ptr<!cir.ptr<!f32>>
  %pv = cir.call @_ZN4sycl3_V113malloc_deviceIfEEPv(%n) : (!u64i) -> !cir.ptr<!f32>
  cir.store %pv, %p : !cir.ptr<!f32>, !cir.ptr<!cir.ptr<!f32>>
  %q = cir.get_member %this[3] {name = "q"} : !cir.ptr<!rec_bench> -> !cir.ptr<!cir.ptr<!f32>>
  %qv = cir.call @_ZN4sycl3_V113malloc_deviceIfEEPv(%n) : (!u64i) -> !cir.ptr<!f32>
  cir.store %qv, %q : !cir.ptr<!f32>, !cir.ptr<!cir.ptr<!f32>>
  cir.return
}
// Bench::run(): launches the kernel on accessors to this->a and this->b,
// and on this->p and this->q.
cir.func @run(%this: !cir.ptr<!rec_bench>, %ev: !cir.ptr<!s8i>, %q: !cir.ptr<!s8i>, %h: !cir.ptr<!s8i>) {
  %view = cir.alloca "view" align(8) : !cir.ptr<!rec_view>
  %lam = cir.alloca "lam" align(8) : !cir.ptr<!rec_lam>
  %a = cir.get_member %this[0] {name = "a"} : !cir.ptr<!rec_bench> -> !cir.ptr<!rec_buf>
  %b = cir.get_member %this[1] {name = "b"} : !cir.ptr<!rec_bench> -> !cir.ptr<!rec_buf>
  %f0 = cir.get_member %lam[0] {name = "A"} : !cir.ptr<!rec_lam> -> !cir.ptr<!rec_acc>
  cir.call @accessor_from_buffer(%f0, %a, %h) : (!cir.ptr<!rec_acc>, !cir.ptr<!rec_buf>, !cir.ptr<!s8i>) -> ()
  %f1 = cir.get_member %lam[1] {name = "B"} : !cir.ptr<!rec_lam> -> !cir.ptr<!rec_acc>
  cir.call @accessor_from_buffer(%f1, %b, %h) : (!cir.ptr<!rec_acc>, !cir.ptr<!rec_buf>, !cir.ptr<!s8i>) -> ()
  %mp = cir.get_member %this[2] {name = "p"} : !cir.ptr<!rec_bench> -> !cir.ptr<!cir.ptr<!f32>>
  %pv = cir.load %mp : !cir.ptr<!cir.ptr<!f32>>, !cir.ptr<!f32>
  %f2 = cir.get_member %lam[2] {name = "P"} : !cir.ptr<!rec_lam> -> !cir.ptr<!cir.ptr<!f32>>
  cir.store %pv, %f2 : !cir.ptr<!f32>, !cir.ptr<!cir.ptr<!f32>>
  %mq = cir.get_member %this[3] {name = "q"} : !cir.ptr<!rec_bench> -> !cir.ptr<!cir.ptr<!f32>>
  %qv = cir.load %mq : !cir.ptr<!cir.ptr<!f32>>, !cir.ptr<!f32>
  %f3 = cir.get_member %lam[3] {name = "Q"} : !cir.ptr<!rec_lam> -> !cir.ptr<!cir.ptr<!f32>>
  cir.store %qv, %f3 : !cir.ptr<!f32>, !cir.ptr<!cir.ptr<!f32>>
