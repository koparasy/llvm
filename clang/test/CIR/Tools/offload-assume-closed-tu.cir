// -cir-offload-assume-closed-tu (plan D2, off by default) reaches the
// points-to analysis behind --cir-offload-host-facts=ipo|both: the
// host-facts summary remark names the mode, and the verdicts change. The input
// is sycl-host-facts-both.cir's (two buffers and two USM pointers built by
// @setup into members of a Bench object, launched by @run through `this`).
// --cir-offload-host-facts=ipo|both runs the bottom-up points-to analysis
// with subobject nodes; --cir-offload-host-facts-ci is the escape hatch to
// the context-insensitive one.

// RUN: rm -rf %t && split-file %s %t
// RUN: cir-offload-merge -combine -input=%t/host.cir -input=%t/device.cir \
// RUN:   -targets=host-x86_64-unknown-linux-gnu,sycl-spir64-unknown-unknown \
// RUN:   --cir-offload-host-facts=both -output=%t/open.cir 2>&1 | FileCheck %s --check-prefix=OPEN
// RUN: cir-offload-merge -combine -input=%t/host.cir -input=%t/device.cir \
// RUN:   -targets=host-x86_64-unknown-linux-gnu,sycl-spir64-unknown-unknown \
// RUN:   --cir-offload-host-facts=both -cir-offload-assume-closed-tu -output=%t/closed.cir 2>&1 | FileCheck %s --check-prefix=CLOSED
// RUN: cir-offload-merge -combine -input=%t/host.cir -input=%t/device.cir \
// RUN:   -targets=host-x86_64-unknown-linux-gnu,sycl-spir64-unknown-unknown \
// RUN:   --cir-offload-host-facts=both --cir-offload-host-facts-closed-tu -output=%t/alias.cir 2>&1 | FileCheck %s --check-prefix=CLOSED
// RUN: cir-offload-merge -combine -input=%t/host.cir -input=%t/device.cir \
// RUN:   -targets=host-x86_64-unknown-linux-gnu,sycl-spir64-unknown-unknown \
// RUN:   --cir-offload-host-facts=both -cir-offload-assume-closed-tu --cir-offload-host-facts-ci \
// RUN:   -output=%t/ci.cir 2>&1 | FileCheck %s --check-prefix=CI
// RUN: cir-offload-merge -combine -input=%t/host.cir -input=%t/device.cir \
// RUN:   -targets=host-x86_64-unknown-linux-gnu,sycl-spir64-unknown-unknown \
// RUN:   --cir-offload-host-facts=ipo -cir-offload-assume-closed-tu -output=%t/ipo.cir
// RUN: FileCheck %s --check-prefix=IPO --input-file=%t/ipo.cir
// RUN: cir-offload-merge -combine -input=%t/host.cir -input=%t/device.cir \
// RUN:   -targets=host-x86_64-unknown-linux-gnu,sycl-spir64-unknown-unknown \
// RUN:   --cir-offload-host-facts=ipo -output=%t/ipo-open.cir
// RUN: FileCheck %s --check-prefix=IPO-OPEN --input-file=%t/ipo-open.cir

// Open: @setup and @run may have callers in other TUs; legacy and points-to
// agree (nothing stamped).
// OPEN-NOT: host-facts-disagreement:
// OPEN: remark: host-facts-disagreements: 0 of 4 candidate fields (open, bu, subobjects)

// Closed TU: points-to sees @main's objects, legacy stops at `this`.
// CLOSED-COUNT-4: remark: host-facts-disagreement: kernel _ZTSZ4mainEUlvE_ field {{[ABPQ]}} legacy=not stamped ({{.*}}) ipo=noalias
// CLOSED: remark: host-facts-disagreements: 4 of 4 candidate fields (closed-tu, bu, subobjects)

// CI: host-facts-disagreements: 4 of 4 candidate fields (closed-tu, ci, subobjects)

// ipo stamps the two USM pointer parameters under closed-tu only.
// IPO: cir.func @_ZTSZ4mainEUlvE_({{.*}}field = "P", kind = "pointer", path = ["P"]}, llvm.noalias}, {{.*}}field = "Q", kind = "pointer", path = ["Q"]}, llvm.noalias})
// IPO-OPEN-NOT: llvm.noalias

//--- host.cir
!s8i = !cir.int<s, 8>
!u64i = !cir.int<u, 64>
!f32 = !cir.float
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_buf = !cir.struct<class "sycl::_V1::buffer<float, 1>" {data !cir.ptr<!s8i>, data !u64i}>
!rec_acc = !cir.struct<class "sycl::_V1::accessor<float, 1>" {data !cir.ptr<!s8i>, data !u64i}>
!rec_range = !cir.struct<class "sycl::_V1::range<1>" {data !u64i}>
!rec_bench = !cir.struct<class "Bench" {data !rec_buf, data !rec_buf, data !cir.ptr<!f32>, data !cir.ptr<!f32>}>
!rec_hkrbase = !cir.struct<"hkrbase" {data !u64i}>
!rec_view = !cir.struct<"view" {data !cir.ptr<!u64i>, data !u64i}>
!rec_lam = !cir.struct<"lam" {data !rec_acc, data !rec_acc, data !cir.ptr<!f32>, data !cir.ptr<!f32>}>
!rec_hkr = !cir.struct<"hkr" {data !rec_hkrbase, data !cir.ptr<!rec_lam>}>

