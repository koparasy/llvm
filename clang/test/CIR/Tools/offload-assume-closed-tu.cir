// -cir-offload-assume-closed-tu (plan D2, off by default) reaches the
// points-to analysis behind the SYCL host facts, and the verdicts change. The
// input is Analysis/sycl-host-facts-members.cir's (two buffers and two USM
// pointers built by @setup into members of a Bench object, launched by @run
// through `this`). The host facts run the bottom-up points-to analysis with
// subobject nodes; the hidden --cir-offload-host-facts-bu=false runs the
// context-insensitive one (the --cir-offload-host-facts-ci flag is deleted,
// T28: nothing needed it).

// RUN: rm -rf %t && split-file %s %t
// RUN: cir-offload-merge -combine --remarks-filter="cir-offload.*" -input=%t/host.cir -input=%t/device.cir \
// RUN:   -targets=host-x86_64-unknown-linux-gnu,sycl-spir64-unknown-unknown \
// RUN:   --cir-offload-internalize-launch-paths=false \
// RUN:   -output=%t/open.cir 2>&1 | FileCheck %s --check-prefix=OPEN
// RUN: FileCheck %s --check-prefix=IR-OPEN --input-file=%t/open.cir
// RUN: cir-offload-merge -combine --remarks-filter="cir-offload.*" -input=%t/host.cir -input=%t/device.cir \
// RUN:   -targets=host-x86_64-unknown-linux-gnu,sycl-spir64-unknown-unknown \
// RUN:   -output=%t/open-int.cir 2>&1 | FileCheck %s --check-prefix=OPEN-INT
// RUN: FileCheck %s --check-prefix=IR-OPEN-INT --input-file=%t/open-int.cir
// RUN: cir-offload-merge -combine --remarks-filter="cir-offload.*" -input=%t/host.cir -input=%t/device.cir \
// RUN:   -targets=host-x86_64-unknown-linux-gnu,sycl-spir64-unknown-unknown \
// RUN:   -cir-offload-assume-closed-tu -output=%t/closed.cir 2>&1 | FileCheck %s --check-prefix=CLOSED
// RUN: FileCheck %s --check-prefix=IR-CLOSED --input-file=%t/closed.cir
// RUN: cir-offload-merge -combine --remarks-filter="cir-offload.*" -input=%t/host.cir -input=%t/device.cir \
// RUN:   -targets=host-x86_64-unknown-linux-gnu,sycl-spir64-unknown-unknown \
// RUN:   --cir-offload-host-facts-closed-tu -output=%t/alias.cir 2>&1 | FileCheck %s --check-prefix=CLOSED
// RUN: cir-offload-merge -combine --remarks-filter="cir-offload.*" -input=%t/host.cir -input=%t/device.cir \
// RUN:   -targets=host-x86_64-unknown-linux-gnu,sycl-spir64-unknown-unknown \
// RUN:   -cir-offload-assume-closed-tu --cir-offload-host-facts-bu=false \
// RUN:   -output=%t/ci.cir 2>&1 | FileCheck %s --check-prefix=CLOSED
// RUN: cir-offload-merge -combine --remarks-filter="cir-offload.*" -input=%t/host.cir -input=%t/device.cir \
// RUN:   -targets=host-x86_64-unknown-linux-gnu,sycl-spir64-unknown-unknown \
// RUN:   --cir-offload-host-facts=none -output=%t/none.cir 2>&1 | FileCheck %s --allow-empty --check-prefix=NONE
// RUN: FileCheck %s --check-prefix=IR-OPEN --input-file=%t/none.cir

// Open, without launch-path internalization: @setup and @run may have
// callers in other TUs, so nothing is proven.
// OPEN-COUNT-4: kernel-param-noalias: kernel @_ZTSZ4mainEUlvE_ arg {{[0-9]}} ({{.*}}): not stamped ({{.*}} has no allocation site the analysis sees)
// OPEN-NOT: ): noalias
// IR-OPEN-NOT: llvm.noalias

// Open, internalized (T26, the default): @run is copied as an internal
// @run.int that main calls, and it launches a copy of the kernel; points-to
// proves the copy's four fields from main's objects, and the original
// kernel, which other TUs' calls of @run launch, stays unproven.
// OPEN-INT: launch-path-internalization: kernel @_ZTSZ4mainEUlvE_ -> @_ZTSZ4mainEUlvE_.int.[[ID:[0-9a-f]+]] for 1 launch marker through the internalized launch path from root @main
// OPEN-INT-COUNT-4: kernel-param-noalias: kernel @_ZTSZ4mainEUlvE_ arg {{[0-9]}} ({{.*}}): not stamped
// OPEN-INT-COUNT-4: kernel-param-noalias: kernel @_ZTSZ4mainEUlvE_.int.[[ID]] arg {{[0-9]}} ({{.*}}): noalias ({{.*}}) through the internalized launch path from root @main
// OPEN-INT: launch-path-internalization: kept 1 of 1 kernel copies
// IR-OPEN-INT: cir.func @_ZTSZ4mainEUlvE_(
// IR-OPEN-INT-NOT: llvm.noalias
// IR-OPEN-INT-SAME: {{$}}
// IR-OPEN-INT: cir.func @_ZTSZ4mainEUlvE_.int.{{[0-9a-f]+}}({{.*}}field = "A", init_arg = 0 : i32, kind = "accessor", path = ["A"]}, llvm.noalias}, {{.*}}field = "B", init_arg = 0 : i32, kind = "accessor", path = ["B"]}, llvm.noalias}, {{.*}}field = "P", kind = "pointer", path = ["P"]}, llvm.noalias}, {{.*}}field = "Q", kind = "pointer", path = ["Q"]}, llvm.noalias})

// Closed TU (bottom-up and CI): points-to sees @main's objects; the kernel
// is stamped in place, nothing is internalized.
// CLOSED-NOT: launch-path-internalization
// CLOSED-COUNT-4: kernel-param-noalias: kernel @_ZTSZ4mainEUlvE_ arg {{[0-9]}} ({{.*}}): noalias
// CLOSED-NOT: launch-path-internalization
// IR-CLOSED: cir.func @_ZTSZ4mainEUlvE_({{.*}}field = "A", init_arg = 0 : i32, kind = "accessor", path = ["A"]}, llvm.noalias}, {{.*}}field = "B", init_arg = 0 : i32, kind = "accessor", path = ["B"]}, llvm.noalias}, {{.*}}field = "P", kind = "pointer", path = ["P"]}, llvm.noalias}, {{.*}}field = "Q", kind = "pointer", path = ["Q"]}, llvm.noalias})

// No host facts: no remark, nothing stamped.
// NONE-NOT: kernel-param-noalias

//--- host.cir
!s8i = !cir.int<s, 8>
!u64i = !cir.int<u, 64>
!f32 = !cir.float
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_buf = !cir.struct<class "sycl::_V1::buffer<float, 1>" {data !cir.ptr<!s8i>, data !u64i}>
!rec_acc = !cir.struct<class "sycl::_V1::accessor<float, 1>" {data !cir.ptr<!s8i>, data !u64i}>
!rec_range = !cir.struct<class "sycl::_V1::range<1>" {data !u64i}>
!rec_bench = !cir.struct<class "Bench" {data !rec_buf, data !rec_buf, data !cir.ptr<!f32>, data !cir.ptr<!f32>}>
!rec_hkrbase = !cir.struct<"hkrbase" {data !u64i}>
!rec_view = !cir.struct<"view" {data !cir.ptr<!u64i>, data !u64i}>
!rec_lam = !cir.struct<"lam" {data !rec_acc, data !rec_acc, data !cir.ptr<!f32>, data !cir.ptr<!f32>}>
!rec_hkr = !cir.struct<"hkr" {data !rec_hkrbase, data !cir.ptr<!rec_lam>}>

module {
cir.global "private" constant cir_private @".str" = #cir.const_array<"_ZTSZ4mainEUlvE_" : !cir.array<!s8i x 16>, trailing_zeros> : !cir.array<!s8i x 17>
cir.global "private" constant internal @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE = #cir.const_record<{#cir.const_record<{#cir.global_view<@".str"> : !cir.ptr<!s8i>, #cir.int<16> : !u64i}> : !rec_sv}> : !rec_ctki
cir.func private @_ZN4sycl3_V113malloc_deviceIfEEPv(!u64i) -> !cir.ptr<!f32> attributes {cir.sycl_host_api = "usm.alloc", cir.sycl_host_api_arg = 0 : i32}
cir.func private @buffer_alloc(!cir.ptr<!rec_buf>, !cir.ptr<!rec_range>) func_info<#cir.cxx_ctor<!rec_buf, custom>> attributes {cir.sycl_host_api = "buffer.alloc", cir.sycl_host_api_arg = 0 : i32}
cir.func private @accessor_from_buffer(!cir.ptr<!rec_acc>, !cir.ptr<!rec_buf>, !cir.ptr<!s8i>) func_info<#cir.cxx_ctor<!rec_acc, custom>> attributes {cir.sycl_host_api = "accessor.from_buffer", cir.sycl_host_api_arg = 0 : i32}
cir.func private @_ZN4sycl3_V16detail13HostKernelRefC2E(!cir.ptr<!rec_hkr>, !cir.ptr<!rec_lam>) attributes {cir.sycl_host_api = "hostkernel.ctor", cir.sycl_host_api_arg = 0 : i32}
cir.func private @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_view>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>) attributes {cir.sycl_host_api = "launch.direct_impl", cir.sycl_host_api_arg = 2 : i32}
cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() -> !cir.ptr<!s8i> attributes {cir.sycl_host_api = "kernel.info", cir.sycl_host_api_arg = 0 : i32} {
  %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE : !cir.ptr<!rec_ctki>
  %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
  cir.return %1 : !cir.ptr<!s8i>
}
// Bench::setup(): constructs both member buffers and allocates both
// member USM pointers.
cir.func @setup(%this: !cir.ptr<!rec_bench>, %r: !cir.ptr<!rec_range>, %n: !u64i) {
  %a = cir.get_member %this[0] {name = "a"} : !cir.ptr<!rec_bench> -> !cir.ptr<!rec_buf>
  cir.call @buffer_alloc(%a, %r) : (!cir.ptr<!rec_buf>, !cir.ptr<!rec_range>) -> ()
  %b = cir.get_member %this[1] {name = "b"} : !cir.ptr<!rec_bench> -> !cir.ptr<!rec_buf>
  cir.call @buffer_alloc(%b, %r) : (!cir.ptr<!rec_buf>, !cir.ptr<!rec_range>) -> ()
  %p = cir.get_member %this[2] {name = "p"} : !cir.ptr<!rec_bench> -> !cir.ptr<!cir.ptr<!f32>>
  %pv = cir.call @_ZN4sycl3_V113malloc_deviceIfEEPv(%n) : (!u64i) -> !cir.ptr<!f32>
  cir.store %pv, %p : !cir.ptr<!f32>, !cir.ptr<!cir.ptr<!f32>>
  %q = cir.get_member %this[3] {name = "q"} : !cir.ptr<!rec_bench> -> !cir.ptr<!cir.ptr<!f32>>
  %qv = cir.call @_ZN4sycl3_V113malloc_deviceIfEEPv(%n) : (!u64i) -> !cir.ptr<!f32>
  cir.store %qv, %q : !cir.ptr<!f32>, !cir.ptr<!cir.ptr<!f32>>
  cir.return
}
// Bench::run(): launches the kernel on accessors to this->a and this->b,
// and on this->p and this->q.
cir.func @run(%this: !cir.ptr<!rec_bench>, %ev: !cir.ptr<!s8i>, %q: !cir.ptr<!s8i>, %h: !cir.ptr<!s8i>) {
  %view = cir.alloca "view" align(8) : !cir.ptr<!rec_view>
  %lam = cir.alloca "lam" align(8) : !cir.ptr<!rec_lam>
  %a = cir.get_member %this[0] {name = "a"} : !cir.ptr<!rec_bench> -> !cir.ptr<!rec_buf>
  %b = cir.get_member %this[1] {name = "b"} : !cir.ptr<!rec_bench> -> !cir.ptr<!rec_buf>
  %f0 = cir.get_member %lam[0] {name = "A"} : !cir.ptr<!rec_lam> -> !cir.ptr<!rec_acc>
  cir.call @accessor_from_buffer(%f0, %a, %h) : (!cir.ptr<!rec_acc>, !cir.ptr<!rec_buf>, !cir.ptr<!s8i>) -> ()
  %f1 = cir.get_member %lam[1] {name = "B"} : !cir.ptr<!rec_lam> -> !cir.ptr<!rec_acc>
  cir.call @accessor_from_buffer(%f1, %b, %h) : (!cir.ptr<!rec_acc>, !cir.ptr<!rec_buf>, !cir.ptr<!s8i>) -> ()
  %mp = cir.get_member %this[2] {name = "p"} : !cir.ptr<!rec_bench> -> !cir.ptr<!cir.ptr<!f32>>
  %pv = cir.load %mp : !cir.ptr<!cir.ptr<!f32>>, !cir.ptr<!f32>
  %f2 = cir.get_member %lam[2] {name = "P"} : !cir.ptr<!rec_lam> -> !cir.ptr<!cir.ptr<!f32>>
  cir.store %pv, %f2 : !cir.ptr<!f32>, !cir.ptr<!cir.ptr<!f32>>
  %mq = cir.get_member %this[3] {name = "q"} : !cir.ptr<!rec_bench> -> !cir.ptr<!cir.ptr<!f32>>
  %qv = cir.load %mq : !cir.ptr<!cir.ptr<!f32>>, !cir.ptr<!f32>
  %f3 = cir.get_member %lam[3] {name = "Q"} : !cir.ptr<!rec_lam> -> !cir.ptr<!cir.ptr<!f32>>
  cir.store %qv, %f3 : !cir.ptr<!f32>, !cir.ptr<!cir.ptr<!f32>>
  %hkr = cir.alloca "hkr" align(8) : !cir.ptr<!rec_hkr>
  cir.call @_ZN4sycl3_V16detail13HostKernelRefC2E(%hkr, %lam) : (!cir.ptr<!rec_hkr>, !cir.ptr<!rec_lam>) -> ()
  %base = cir.base_class_addr nonnull %hkr [0] : !cir.ptr<!rec_hkr> -> !cir.ptr<!rec_hkrbase>
  %dki = cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() : () -> !cir.ptr<!s8i>
  cir.call @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(%ev, %q, %view, %base, %dki) : (!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_view>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>) -> ()
  cir.return
}
cir.func @main(%ev: !cir.ptr<!s8i>, %q: !cir.ptr<!s8i>, %h: !cir.ptr<!s8i>, %r: !cir.ptr<!rec_range>, %n: !u64i) {
  %bench = cir.alloca "bench" align(8) : !cir.ptr<!rec_bench>
  cir.call @setup(%bench, %r, %n) : (!cir.ptr<!rec_bench>, !cir.ptr<!rec_range>, !u64i) -> ()
  cir.call @run(%bench, %ev, %q, %h) : (!cir.ptr<!rec_bench>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>) -> ()
  cir.return
}
}

//--- device.cir
!s8i = !cir.int<s, 8>
!u64i = !cir.int<u, 64>
!f32 = !cir.float
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_buf = !cir.struct<class "sycl::_V1::buffer<float, 1>" {data !cir.ptr<!s8i>, data !u64i}>
!rec_acc = !cir.struct<class "sycl::_V1::accessor<float, 1>" {data !cir.ptr<!s8i>, data !u64i}>
!rec_range = !cir.struct<class "sycl::_V1::range<1>" {data !u64i}>
!rec_bench = !cir.struct<class "Bench" {data !rec_buf, data !rec_buf, data !cir.ptr<!f32>, data !cir.ptr<!f32>}>
!rec_hkrbase = !cir.struct<"hkrbase" {data !u64i}>
!rec_view = !cir.struct<"view" {data !cir.ptr<!u64i>, data !u64i}>
!rec_lam = !cir.struct<"lam" {data !rec_acc, data !rec_acc, data !cir.ptr<!f32>, data !cir.ptr<!f32>}>
!rec_hkr = !cir.struct<"hkr" {data !rec_hkrbase, data !cir.ptr<!rec_lam>}>

