  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>} {
    // REMARK: remark: kernel-param-noalias: kernel @_ZTSZ4mainEUlvE_ arg 0 (accessor 'A'): noalias (buffer 'ba'{{.*}})
    // REMARK: remark: kernel-param-noalias: kernel @_ZTSZ4mainEUlvE_ arg 2 (accessor 'B'): noalias (buffer 'bb'{{.*}})
    // REMARK: remark: kernel-param-noalias: kernel @_ZTSZ4mainEUlvE_ arg 4 (accessor 'C'): noalias (buffer 'bc'{{.*}})
    // REMARK-NOT: remark
    // CHECK: cir.func @_ZTSZ4mainEUlvE_(
    // CHECK-SAME: %arg0: !cir.ptr<!cir.float, target_address_space(1)> {cir.sycl_kernel_param = {{{[^}]*}}field = "A"{{[^}]*}}}, llvm.noalias}
    // CHECK-SAME: %arg1: !cir.ptr<{{[^>]*}}> {cir.sycl_kernel_param = {{{[^}]*}}}}
