// RUN: cir-opt %s -split-input-file \
// RUN:   -pass-pipeline="builtin.module(cir-offload-infer-kernel-param-noalias)" \
// RUN:   | FileCheck %s

// A TU-local SYCL kernel whose captured pointers come from DISTINCT USM
// allocations gets `llvm.noalias` on the corresponding device parameters. The
// two USM pointer parameters (bound to closure fields "a" and "b") are marked;
// the local_accessor parameter (address_space(3), not bridged to a capture
// field) is left alone.

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_lam = !cir.struct<"lam" {data !cir.ptr<!s32i>, data !cir.ptr<!s32i>}>
!rec_hkrbase = !cir.struct<"hkrbase" {data !u64i}>
!rec_hkr = !cir.struct<"hkr" {data !rec_hkrbase, data !cir.ptr<!rec_lam>}>
!rec_view = !cir.struct<"view" {data !cir.ptr<!u64i>, data !u64i}>
!rec_dlam = !cir.struct<"dlam" {data !cir.ptr<!s32i, target_address_space(4)>, data !cir.ptr<!s32i, target_address_space(4)>}>
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_ZTSZ4mainEUlvE_" : !cir.array<!s8i x 16>, trailing_zeros> : !cir.array<!s8i x 17>
    cir.global "private" constant internal @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE = #cir.const_record<{#cir.const_record<{#cir.global_view<@".str"> : !cir.ptr<!s8i>, #cir.int<16> : !u64i}> : !rec_sv}> : !rec_ctki
    cir.func private @_ZN4sycl3_V113malloc_deviceIiEEPv() -> !cir.ptr<!s32i>
    cir.func private @_ZN4sycl3_V16detail13HostKernelRefC2E(!cir.ptr<!rec_hkr>, !cir.ptr<!rec_lam>)
    cir.func private @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_view>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>)
    cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() -> !cir.ptr<!s8i> {
      %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE : !cir.ptr<!rec_ctki>
      %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
    cir.func @main(%ev: !cir.ptr<!s8i>, %q: !cir.ptr<!s8i>) {
      %view = cir.alloca "view" align(8) : !cir.ptr<!rec_view>
      %lam = cir.alloca "lam" align(8) : !cir.ptr<!rec_lam>
      %hkr = cir.alloca "hkr" align(8) : !cir.ptr<!rec_hkr>
      %pa = cir.call @_ZN4sycl3_V113malloc_deviceIiEEPv() : () -> !cir.ptr<!s32i>
      %pb = cir.call @_ZN4sycl3_V113malloc_deviceIiEEPv() : () -> !cir.ptr<!s32i>
      %fa = cir.get_member %lam[0] {name = "a"} : !cir.ptr<!rec_lam> -> !cir.ptr<!cir.ptr<!s32i>>
      cir.store %pa, %fa : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
      %fb = cir.get_member %lam[1] {name = "b"} : !cir.ptr<!rec_lam> -> !cir.ptr<!cir.ptr<!s32i>>
      cir.store %pb, %fb : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
      cir.call @_ZN4sycl3_V16detail13HostKernelRefC2E(%hkr, %lam) : (!cir.ptr<!rec_hkr>, !cir.ptr<!rec_lam>) -> ()
      %base = cir.base_class_addr nonnull %hkr [0] : !cir.ptr<!rec_hkr> -> !cir.ptr<!rec_hkrbase>
      %dki = cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() : () -> !cir.ptr<!s8i>
      cir.call @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(%ev, %q, %view, %base, %dki) : (!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_view>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>) -> ()
      cir.return
    }
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>} {
    // CHECK: cir.func @_ZTSZ4mainEUlvE_(
    // CHECK-SAME: %arg0: !cir.ptr<!s32i, target_address_space(1)> {llvm.noalias}
    // CHECK-SAME: %arg1: !cir.ptr<!s32i, target_address_space(1)> {llvm.noalias}
    // CHECK-SAME: %arg2: !cir.ptr<!s32i, target_address_space(3)>)
    // CHECK-NOT: %arg2: {{.*}}llvm.noalias
    cir.func @_ZTSZ4mainEUlvE_(%arg0: !cir.ptr<!s32i, target_address_space(1)>, %arg1: !cir.ptr<!s32i, target_address_space(1)>, %arg2: !cir.ptr<!s32i, target_address_space(3)>) cc(spir_kernel) {
      %0 = cir.alloca "clos" align(8) : !cir.ptr<!rec_dlam>
      %fa = cir.get_member %0[0] {name = "a"} : !cir.ptr<!rec_dlam> -> !cir.ptr<!cir.ptr<!s32i, target_address_space(4)>>
      %ca = cir.cast address_space %arg0 : !cir.ptr<!s32i, target_address_space(1)> -> !cir.ptr<!s32i, target_address_space(4)>
      cir.store %ca, %fa : !cir.ptr<!s32i, target_address_space(4)>, !cir.ptr<!cir.ptr<!s32i, target_address_space(4)>>
      %fb = cir.get_member %0[1] {name = "b"} : !cir.ptr<!rec_dlam> -> !cir.ptr<!cir.ptr<!s32i, target_address_space(4)>>
      %cb = cir.cast address_space %arg1 : !cir.ptr<!s32i, target_address_space(1)> -> !cir.ptr<!s32i, target_address_space(4)>
      cir.store %cb, %fb : !cir.ptr<!s32i, target_address_space(4)>, !cir.ptr<!cir.ptr<!s32i, target_address_space(4)>>
      cir.return
    }
  }
}

// -----

// Shared allocation: both captured pointers come from the SAME malloc_device
// call, so neither parameter can be proven distinct -- nothing is marked.

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_lam = !cir.struct<"lam" {data !cir.ptr<!s32i>, data !cir.ptr<!s32i>}>
!rec_hkrbase = !cir.struct<"hkrbase" {data !u64i}>
!rec_hkr = !cir.struct<"hkr" {data !rec_hkrbase, data !cir.ptr<!rec_lam>}>
!rec_view = !cir.struct<"view" {data !cir.ptr<!u64i>, data !u64i}>
!rec_dlam = !cir.struct<"dlam" {data !cir.ptr<!s32i, target_address_space(4)>, data !cir.ptr<!s32i, target_address_space(4)>}>
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_ZTSZ4mainEUlvE_" : !cir.array<!s8i x 16>, trailing_zeros> : !cir.array<!s8i x 17>
    cir.global "private" constant internal @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE = #cir.const_record<{#cir.const_record<{#cir.global_view<@".str"> : !cir.ptr<!s8i>, #cir.int<16> : !u64i}> : !rec_sv}> : !rec_ctki
    cir.func private @_ZN4sycl3_V113malloc_deviceIiEEPv() -> !cir.ptr<!s32i>
    cir.func private @_ZN4sycl3_V16detail13HostKernelRefC2E(!cir.ptr<!rec_hkr>, !cir.ptr<!rec_lam>)
    cir.func private @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_view>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>)
    cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() -> !cir.ptr<!s8i> {
      %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE : !cir.ptr<!rec_ctki>
      %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
    cir.func @main(%ev: !cir.ptr<!s8i>, %q: !cir.ptr<!s8i>) {
      %view = cir.alloca "view" align(8) : !cir.ptr<!rec_view>
      %lam = cir.alloca "lam" align(8) : !cir.ptr<!rec_lam>
      %hkr = cir.alloca "hkr" align(8) : !cir.ptr<!rec_hkr>
      %pa = cir.call @_ZN4sycl3_V113malloc_deviceIiEEPv() : () -> !cir.ptr<!s32i>
      %fa = cir.get_member %lam[0] {name = "a"} : !cir.ptr<!rec_lam> -> !cir.ptr<!cir.ptr<!s32i>>
      cir.store %pa, %fa : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
      %fb = cir.get_member %lam[1] {name = "b"} : !cir.ptr<!rec_lam> -> !cir.ptr<!cir.ptr<!s32i>>
      cir.store %pa, %fb : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
      cir.call @_ZN4sycl3_V16detail13HostKernelRefC2E(%hkr, %lam) : (!cir.ptr<!rec_hkr>, !cir.ptr<!rec_lam>) -> ()
      %base = cir.base_class_addr nonnull %hkr [0] : !cir.ptr<!rec_hkr> -> !cir.ptr<!rec_hkrbase>
      %dki = cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() : () -> !cir.ptr<!s8i>
      cir.call @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(%ev, %q, %view, %base, %dki) : (!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_view>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>) -> ()
      cir.return
    }
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>} {
    // CHECK-NOT: llvm.noalias
    cir.func @_ZTSZ4mainEUlvE_(%arg0: !cir.ptr<!s32i, target_address_space(1)>, %arg1: !cir.ptr<!s32i, target_address_space(1)>) cc(spir_kernel) {
      %0 = cir.alloca "clos" align(8) : !cir.ptr<!rec_dlam>
      %fa = cir.get_member %0[0] {name = "a"} : !cir.ptr<!rec_dlam> -> !cir.ptr<!cir.ptr<!s32i, target_address_space(4)>>
      %ca = cir.cast address_space %arg0 : !cir.ptr<!s32i, target_address_space(1)> -> !cir.ptr<!s32i, target_address_space(4)>
      cir.store %ca, %fa : !cir.ptr<!s32i, target_address_space(4)>, !cir.ptr<!cir.ptr<!s32i, target_address_space(4)>>
      %fb = cir.get_member %0[1] {name = "b"} : !cir.ptr<!rec_dlam> -> !cir.ptr<!cir.ptr<!s32i, target_address_space(4)>>
      %cb = cir.cast address_space %arg1 : !cir.ptr<!s32i, target_address_space(1)> -> !cir.ptr<!s32i, target_address_space(4)>
      cir.store %cb, %fb : !cir.ptr<!s32i, target_address_space(4)>, !cir.ptr<!cir.ptr<!s32i, target_address_space(4)>>
      cir.return
    }
  }
}

// -----

// Non-TU-local kernel: a named (non-closure) kernel is reachable across TUs, so
// even with distinct USM allocations it stays conservative -- not marked. The
// only change from the first case is the kernel's mangled name.

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_lam = !cir.struct<"lam" {data !cir.ptr<!s32i>, data !cir.ptr<!s32i>}>
!rec_hkrbase = !cir.struct<"hkrbase" {data !u64i}>
!rec_hkr = !cir.struct<"hkr" {data !rec_hkrbase, data !cir.ptr<!rec_lam>}>
!rec_view = !cir.struct<"view" {data !cir.ptr<!u64i>, data !u64i}>
!rec_dlam = !cir.struct<"dlam" {data !cir.ptr<!s32i, target_address_space(4)>, data !cir.ptr<!s32i, target_address_space(4)>}>
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_Z9addKernelv" : !cir.array<!s8i x 13>, trailing_zeros> : !cir.array<!s8i x 14>
    cir.global "private" constant internal @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE = #cir.const_record<{#cir.const_record<{#cir.global_view<@".str"> : !cir.ptr<!s8i>, #cir.int<13> : !u64i}> : !rec_sv}> : !rec_ctki
    cir.func private @_ZN4sycl3_V113malloc_deviceIiEEPv() -> !cir.ptr<!s32i>
    cir.func private @_ZN4sycl3_V16detail13HostKernelRefC2E(!cir.ptr<!rec_hkr>, !cir.ptr<!rec_lam>)
    cir.func private @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_view>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>)
    cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() -> !cir.ptr<!s8i> {
      %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE : !cir.ptr<!rec_ctki>
      %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
    cir.func @main(%ev: !cir.ptr<!s8i>, %q: !cir.ptr<!s8i>) {
      %view = cir.alloca "view" align(8) : !cir.ptr<!rec_view>
      %lam = cir.alloca "lam" align(8) : !cir.ptr<!rec_lam>
      %hkr = cir.alloca "hkr" align(8) : !cir.ptr<!rec_hkr>
      %pa = cir.call @_ZN4sycl3_V113malloc_deviceIiEEPv() : () -> !cir.ptr<!s32i>
      %pb = cir.call @_ZN4sycl3_V113malloc_deviceIiEEPv() : () -> !cir.ptr<!s32i>
      %fa = cir.get_member %lam[0] {name = "a"} : !cir.ptr<!rec_lam> -> !cir.ptr<!cir.ptr<!s32i>>
      cir.store %pa, %fa : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
      %fb = cir.get_member %lam[1] {name = "b"} : !cir.ptr<!rec_lam> -> !cir.ptr<!cir.ptr<!s32i>>
      cir.store %pb, %fb : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
      cir.call @_ZN4sycl3_V16detail13HostKernelRefC2E(%hkr, %lam) : (!cir.ptr<!rec_hkr>, !cir.ptr<!rec_lam>) -> ()
      %base = cir.base_class_addr nonnull %hkr [0] : !cir.ptr<!rec_hkr> -> !cir.ptr<!rec_hkrbase>
      %dki = cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() : () -> !cir.ptr<!s8i>
      cir.call @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(%ev, %q, %view, %base, %dki) : (!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_view>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>) -> ()
      cir.return
    }
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>} {
    // CHECK-NOT: llvm.noalias
    cir.func @_Z9addKernelv(%arg0: !cir.ptr<!s32i, target_address_space(1)>, %arg1: !cir.ptr<!s32i, target_address_space(1)>) cc(spir_kernel) {
      %0 = cir.alloca "clos" align(8) : !cir.ptr<!rec_dlam>
      %fa = cir.get_member %0[0] {name = "a"} : !cir.ptr<!rec_dlam> -> !cir.ptr<!cir.ptr<!s32i, target_address_space(4)>>
      %ca = cir.cast address_space %arg0 : !cir.ptr<!s32i, target_address_space(1)> -> !cir.ptr<!s32i, target_address_space(4)>
      cir.store %ca, %fa : !cir.ptr<!s32i, target_address_space(4)>, !cir.ptr<!cir.ptr<!s32i, target_address_space(4)>>
      %fb = cir.get_member %0[1] {name = "b"} : !cir.ptr<!rec_dlam> -> !cir.ptr<!cir.ptr<!s32i, target_address_space(4)>>
      %cb = cir.cast address_space %arg1 : !cir.ptr<!s32i, target_address_space(1)> -> !cir.ptr<!s32i, target_address_space(4)>
      cir.store %cb, %fb : !cir.ptr<!s32i, target_address_space(4)>, !cir.ptr<!cir.ptr<!s32i, target_address_space(4)>>
