// RUN: cir-opt %s --remarks-filter="cir-offload.*" \
// RUN:   -pass-pipeline="builtin.module(cir-offload-internalize-launch-paths,cir-offload-stamp-reqd-work-group-size{host-facts-internalize=1},cir-offload-infer-kernel-param-noalias{host-facts-internalize=1},cir-offload-propagate-sycl-kernel-args{host-facts-internalize=1},cir-offload-prune-internalized-launch-paths)" \
// RUN:   -o %t.out.cir 2>&1 | FileCheck %s --check-prefix=FACTS
// RUN: FileCheck %s --check-prefix=IR --input-file=%t.out.cir
//
// Open roots (T28). A TU without main (s3d's S3D.cpp): no closed root
// reaches any launch, so the closed-root internalization (T26) copies
// nothing. An externally visible function nothing in the TU uses is an open
// root: its callers are all code we don't see. Kept in place, its paths are
// copied as internal functions launching K.int.<module id>. The points-to
// analysis treats the open root as having callers it does not see (its
// formals are Incomplete, nameable globals are External), so a fact survives
// only if it depends on nothing the root's callers provide, and it then
// holds for every caller: a foreign call bound to our copy of the root runs
// this body with unknown arguments, which the analysis assumed.
//
// The container is the one cir-offload-merge --cir-offload-host-facts=none
// builds (mem2reg and SCCP) from this source, compiled with the canary mock
// of CodeGenSYCL/Inputs/combine-canary-mock.h:
//
//   template <typename T> void RunTest(queue &q) {           // linkonce_odr
//     T *a = malloc_shared<T>(64, q), *b = malloc_shared<T>(64, q);
//     int scale = 3;
//     q.submit([&](handler &h) {
//       h.parallel_for<KR<T>>(nd_range<1>(range<1>(64), range<1>(16)),
//                             [=](nd_item<1> it) { b[..] = scale * a[..]; });
//     });
//   }
//   void RunBenchmark(queue &q) { RunTest<float>(q); RunTest<double>(q); }
//   template <typename T> void RunTestP(queue &q, T *a, T *b, int scale) {
//     ... KP, the same launch over the parameters ... }
//   void RunBenchmarkP(queue &q, float *a, float *b, int scale) {
//     RunTestP(q, a, b, scale); }
//   float *g_a, *g_b; int g_scale = 3;
//   template <typename T> void RunTestG(queue &q) {
//     T *a = g_a, *b = g_b; int scale = g_scale; ... KG ... }
//   void RunBenchmarkG(queue &q) { RunTestG<float>(q); }
//   template <typename T> void RunExplicit(queue &q) {
//     ... KX<T> on two malloc_shared allocations ... }
//   template void RunExplicit<int>(queue &);                // weak_odr
//
//  - KR<float>, KR<double> (P, the s3d shape): the allocations, the
//    constant 3 and the geometry are RunTest's own: noalias, the constant
//    and [16] on the copies, from the open root RunBenchmark;
//  - KP (N): the pointers and the scalar are RunBenchmarkP's formals: no
//    noalias, no constant (the geometry, built in RunTestP, still holds);
//  - KG (N): the globals RunBenchmarkG's callers may write: no noalias, no
//    constant;
//  - KX<int> (P): the open root is an unused weak_odr explicit
//    instantiation; it is analysed although it is an unused ODR function
//    (skipUnusedODRFunctions keeps a body that names a local function: the
//    internal copies it now calls).
// The originals keep launching the unstamped kernels.

// FACTS-DAG: launch-path-internalization: kernel @_ZTS2KRIfE -> @_ZTS2KRIfE.int.[[ID:[0-9a-f]+]] for 1 launch marker through the internalized launch path from root @_Z12RunBenchmarkRN4sycl3_V15queueE
// FACTS-DAG: launch-path-internalization: kernel @_ZTS2KRIdE -> @_ZTS2KRIdE.int.[[ID]] for 1 launch marker through the internalized launch path from root @_Z12RunBenchmarkRN4sycl3_V15queueE
// FACTS-DAG: launch-path-internalization: kernel @_ZTS2KP -> @_ZTS2KP.int.[[ID]] for 1 launch marker through the internalized launch path from root @_Z13RunBenchmarkPRN4sycl3_V15queueEPfS3_i
// FACTS-DAG: launch-path-internalization: kernel @_ZTS2KG -> @_ZTS2KG.int.[[ID]] for 1 launch marker through the internalized launch path from root @_Z13RunBenchmarkGRN4sycl3_V15queueE
// FACTS-DAG: launch-path-internalization: kernel @_ZTS2KXIiE -> @_ZTS2KXIiE.int.[[ID]] for 1 launch marker through the internalized launch path from root @_Z11RunExplicitIiEvRN4sycl3_V15queueE
// FACTS-DAG: reqd-work-group-size: kernel @_ZTS2KRIfE.int.[[ID]] [16] through the internalized launch path from root @_Z12RunBenchmarkRN4sycl3_V15queueE
// FACTS-DAG: kernel-param-noalias: kernel @_ZTS2KRIfE.int.[[ID]] arg 0 (pointer 'b'): noalias (a USM allocation ({{.*}})) through the internalized launch path from root @_Z12RunBenchmarkRN4sycl3_V15queueE
// FACTS-DAG: kernel-param-noalias: kernel @_ZTS2KRIfE.int.[[ID]] arg 2 (pointer 'a'): noalias (a USM allocation ({{.*}})) through the internalized launch path from root @_Z12RunBenchmarkRN4sycl3_V15queueE
// FACTS-DAG: kernel-param-noalias: kernel @_ZTS2KRIdE.int.[[ID]] arg 0 (pointer 'b'): noalias
// FACTS-DAG: kernel-arg-constant: kernel @_ZTS2KRIfE.int.[[ID]] arg 1 ('scale'): #cir.int<3> : !cir.int<s, 32> through the internalized launch path from root @_Z12RunBenchmarkRN4sycl3_V15queueE
// FACTS-DAG: kernel-arg-constant: kernel @_ZTS2KRIdE.int.[[ID]] arg 1 ('scale'): #cir.int<3> : !cir.int<s, 32>
// FACTS-DAG: kernel-param-noalias: kernel @_ZTS2KP.int.[[ID]] arg 0 (pointer 'b'): not stamped (pointer 'b': {{n[0-9]+}} has no allocation site the analysis sees)
// FACTS-DAG: kernel-param-noalias: kernel @_ZTS2KP.int.[[ID]] arg 2 (pointer 'a'): not stamped
// FACTS-DAG: reqd-work-group-size: kernel @_ZTS2KP.int.[[ID]] [16]
// FACTS-DAG: kernel-param-noalias: kernel @_ZTS2KG.int.[[ID]] arg 0 (pointer 'b'): not stamped (pointer 'b': {{n[0-9]+}} has no allocation site the analysis sees)
// FACTS-DAG: kernel-param-noalias: kernel @_ZTS2KG.int.[[ID]] arg 2 (pointer 'a'): not stamped
// FACTS-DAG: kernel-param-noalias: kernel @_ZTS2KXIiE.int.[[ID]] arg 0 (pointer 'b'): noalias (a USM allocation ({{.*}})) through the internalized launch path from root @_Z11RunExplicitIiEvRN4sycl3_V15queueE
// FACTS-DAG: kernel-param-noalias: kernel @_ZTS2KXIiE.int.[[ID]] arg 1 (pointer 'a'): noalias
// FACTS-DAG: launch-path-internalization: kept 5 of 5 kernel copies
// FACTS-NOT: kernel-arg-constant: kernel @_ZTS2KP
// FACTS-NOT: kernel-arg-constant: kernel @_ZTS2KG
// FACTS-NOT: kernel @_ZTS2K{{[A-Z]+(I[a-z]E)?}} arg {{[0-9]}} ({{.*}}): noalias

// The open root stays external and calls the copy of RunTest<float>; the
// original RunTest<float> (linkonce_odr) still launches the original kernel.
// IR-LABEL: cir.func no_inline dso_local @_Z12RunBenchmarkRN4sycl3_V15queueE(
// IR: cir.call @_Z7RunTestIfEvRN4sycl3_V15queueE.int(
// IR: cir.call @_Z7RunTestIdEvRN4sycl3_V15queueE.int(
// IR-LABEL: cir.func no_inline comdat weak_odr @_Z11RunExplicitIiEvRN4sycl3_V15queueE(
// IR: cir.call @_ZN4sycl3_V15queue6submitIZ11RunExplicitIiEvRS1_EUlRNS0_7handlerEE_EENS0_5eventET_.int(
// IR: cir.func no_inline comdat weak_odr @_ZTS2KRIfE(
// IR-NOT: llvm.noalias
// IR-SAME: {{$}}
// IR: cir.func no_inline comdat weak_odr @_ZTS2KRIfE.int.{{[0-9a-f]+}}({{.*}}llvm.noalias{{.*}}llvm.noalias

