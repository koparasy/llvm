      %clos = cir.alloca "lam" align(8) : !cir.ptr<!rec_lam>
      %fc = cir.get_member %clos[0] {name = "C"} : !cir.ptr<!rec_lam> -> !cir.ptr<!s32i>
      cir.store %argC, %fc : !s32i, !cir.ptr<!s32i>

      %z = cir.const #cir.int<0> : !s32i
      %lid = cir.call @get_local_id(%z) : (!s32i) -> !s32i

      // Divisor is the id builtin itself: per-work-item, not uniform.
