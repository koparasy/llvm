}

// -----

// Negatives: none of these divisors is launch-uniform, so the pass emits NO
// remark (any unexpected remark would fail -verify-diagnostics).
//   - divisor is a work-item id builtin (per-work-item, not uniform);
//   - divisor is a compile-time constant (backend already strength-reduces it);
//   - divisor is loaded from a kernel POINTER parameter (opaque memory / USM),
//     not a captured scalar field.

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_lam = !cir.struct<"lam" {data !s32i}>
!rec_hkrbase = !cir.struct<"hkrbase" {data !u64i}>
