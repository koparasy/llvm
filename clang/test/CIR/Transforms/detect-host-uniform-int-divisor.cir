}

// -----

// Generalized to floating-point division and transcendental math. A device
// computation whose operands are launch-uniform (derived from captured scalars
// through pure arithmetic and pure `const` math calls) is worth host-hoisting;
// the pass reports both a uniform DIVISOR (strength-reduce) and a fully-uniform
// expensive result (host-precompute the scalar). Uses the real device symbols
// (`__spirv_ocl_*` math, `__spirv_BuiltIn*` invocation state, `side_effect(const)`).

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
