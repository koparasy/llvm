// RUN: cir-opt %s -split-input-file -verify-diagnostics \
// RUN:   -pass-pipeline="builtin.module(cir-offload-detect-host-uniform-int-divisor)"

// A SYCL device integer division whose DIVISOR is kernel-scope-uniform -- it is
// derived only from a captured SCALAR closure field (classified with the same
// param->field mapping the scalar-capture propagation pass uses) and constants,
// through pure arithmetic -- gets a remark suggesting the reciprocal be
// host-precomputed as a magic-multiply (CMPLRLLVM-76652). The dividend `lid`
// (a work-item id builtin) is per-work-item, but the divisor `C` is invariant
// across the launch. Analysis only: the pass never mutates the module. This
// mirrors propagate-sycl-kernel-args.cir's container scaffolding, whose lambda
// kernel name (`_ZTSZ4mainEUlvE_`) makes the binding TU-local/optimizable.

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_lam = !cir.struct<"lam" {data !s32i}>
!rec_hkrbase = !cir.struct<"hkrbase" {data !u64i}>
!rec_hkr = !cir.struct<"hkr" {data !rec_hkrbase, data !cir.ptr<!rec_lam>}>
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_ZTSZ4mainEUlvE_" : !cir.array<!s8i x 16>, trailing_zeros> : !cir.array<!s8i x 17>
    cir.global "private" constant internal @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE = #cir.const_record<{#cir.const_record<{#cir.global_view<@".str"> : !cir.ptr<!s8i>, #cir.int<16> : !u64i}> : !rec_sv}> : !rec_ctki
    cir.func private @_ZN4sycl3_V16detail13HostKernelRefC2E(!cir.ptr<!rec_hkr>, !cir.ptr<!rec_lam>)
    cir.func private @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>)
    cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() -> !cir.ptr<!s8i> {
      %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE : !cir.ptr<!rec_ctki>
      %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
    cir.func @main(%ev: !cir.ptr<!s8i>, %q: !cir.ptr<!s8i>, %geom: !cir.ptr<!s8i>, %c: !s32i) {
      %lam = cir.alloca "lam" align(8) : !cir.ptr<!rec_lam>
      %hkr = cir.alloca "hkr" align(8) : !cir.ptr<!rec_hkr>
      %fc = cir.get_member %lam[0] {name = "C"} : !cir.ptr<!rec_lam> -> !cir.ptr<!s32i>
      cir.store %c, %fc : !s32i, !cir.ptr<!s32i>
      cir.call @_ZN4sycl3_V16detail13HostKernelRefC2E(%hkr, %lam) : (!cir.ptr<!rec_hkr>, !cir.ptr<!rec_lam>) -> ()
      %base = cir.base_class_addr nonnull %hkr [0] : !cir.ptr<!rec_hkr> -> !cir.ptr<!rec_hkrbase>
      %dki = cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() : () -> !cir.ptr<!s8i>
      cir.call @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(%ev, %q, %geom, %base, %dki) : (!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>) -> ()
      cir.return
    }
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func private @get_local_id(!s32i) -> !s32i
    // The scalar parameter %argC is spilled and stored into the closure field
    // "C" (the prologue the scalar-capture mapper recognizes), so it is a
    // captured scalar -- uniform. %lid comes from a work-item builtin call --
    // not uniform.
    cir.func @_ZTSZ4mainEUlvE_(%argC: !s32i, %out: !cir.ptr<!s32i, target_address_space(1)>) cc(spir_kernel) {
      %clos = cir.alloca "lam" align(8) : !cir.ptr<!rec_lam>
      %sc = cir.alloca "C.addr" align(4) : !cir.ptr<!s32i>
      cir.store %argC, %sc : !s32i, !cir.ptr<!s32i>
      %vc = cir.load %sc : !cir.ptr<!s32i>, !s32i
      %fc = cir.get_member %clos[0] {name = "C"} : !cir.ptr<!rec_lam> -> !cir.ptr<!s32i>
      cir.store %vc, %fc : !s32i, !cir.ptr<!s32i>

      %z = cir.const #cir.int<0> : !s32i
      %lid = cir.call @get_local_id(%z) : (!s32i) -> !s32i

      // Divisor is the captured-scalar parameter directly (post-promotion
      // shape): remark, naming C.
      // expected-remark@+1 {{device kernel '_ZTSZ4mainEUlvE_': integer division by launch-uniform capture 'C'; consider host-precomputing a reciprocal magic-multiply (CMPLRLLVM-76652)}}
      %d0 = cir.div %lid, %argC : !s32i
      cir.store %d0, %out : !s32i, !cir.ptr<!s32i, target_address_space(1)>

      // Divisor is a pure-arithmetic function of the capture and a constant
      // (C + 1): still uniform -> remark.
      %one = cir.const #cir.int<1> : !s32i
      %cp1 = cir.add %argC, %one : !s32i
      // expected-remark@+1 {{launch-uniform capture 'C'}}
      %d1 = cir.rem %lid, %cp1 : !s32i
      cir.store %d1, %out : !s32i, !cir.ptr<!s32i, target_address_space(1)>

      cir.return
    }
  }
}

// -----

// The real (post-inline) shape: the divisor is a LOAD of the captured-scalar
// closure field, not the block argument. `operator()` reads `C_` via
// cir.load(cir.get_member(closure, "C")); once inlined into the kernel that
// load is matched to the very closure the parameter populates, so it is
// uniform and the remark fires.

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_lam = !cir.struct<"lam" {data !s32i}>
!rec_hkrbase = !cir.struct<"hkrbase" {data !u64i}>
!rec_hkr = !cir.struct<"hkr" {data !rec_hkrbase, data !cir.ptr<!rec_lam>}>
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_ZTSZ4mainEUlvE_" : !cir.array<!s8i x 16>, trailing_zeros> : !cir.array<!s8i x 17>
    cir.global "private" constant internal @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE = #cir.const_record<{#cir.const_record<{#cir.global_view<@".str"> : !cir.ptr<!s8i>, #cir.int<16> : !u64i}> : !rec_sv}> : !rec_ctki
    cir.func private @_ZN4sycl3_V16detail13HostKernelRefC2E(!cir.ptr<!rec_hkr>, !cir.ptr<!rec_lam>)
    cir.func private @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>)
    cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() -> !cir.ptr<!s8i> {
      %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE : !cir.ptr<!rec_ctki>
      %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
    cir.func @main(%ev: !cir.ptr<!s8i>, %q: !cir.ptr<!s8i>, %geom: !cir.ptr<!s8i>, %c: !s32i) {
      %lam = cir.alloca "lam" align(8) : !cir.ptr<!rec_lam>
      %hkr = cir.alloca "hkr" align(8) : !cir.ptr<!rec_hkr>
      %fc = cir.get_member %lam[0] {name = "C"} : !cir.ptr<!rec_lam> -> !cir.ptr<!s32i>
      cir.store %c, %fc : !s32i, !cir.ptr<!s32i>
      cir.call @_ZN4sycl3_V16detail13HostKernelRefC2E(%hkr, %lam) : (!cir.ptr<!rec_hkr>, !cir.ptr<!rec_lam>) -> ()
      %base = cir.base_class_addr nonnull %hkr [0] : !cir.ptr<!rec_hkr> -> !cir.ptr<!rec_hkrbase>
      %dki = cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() : () -> !cir.ptr<!s8i>
      cir.call @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(%ev, %q, %geom, %base, %dki) : (!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>) -> ()
      cir.return
    }
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func private @get_local_id(!s32i) -> !s32i
    cir.func @_ZTSZ4mainEUlvE_(%argC: !s32i, %out: !cir.ptr<!s32i, target_address_space(1)>) cc(spir_kernel) {
      %clos = cir.alloca "lam" align(8) : !cir.ptr<!rec_lam>
      %fc = cir.get_member %clos[0] {name = "C"} : !cir.ptr<!rec_lam> -> !cir.ptr<!s32i>
      cir.store %argC, %fc : !s32i, !cir.ptr<!s32i>

      %z = cir.const #cir.int<0> : !s32i
      %lid = cir.call @get_local_id(%z) : (!s32i) -> !s32i

      // Divisor loaded from the closure field the parameter populates
      // (the shape after operator() is inlined): uniform -> remark.
      %cast = cir.cast address_space %clos : !cir.ptr<!rec_lam> -> !cir.ptr<!rec_lam, target_address_space(4)>
      %fc2 = cir.get_member %cast[0] {name = "C"} : !cir.ptr<!rec_lam, target_address_space(4)> -> !cir.ptr<!s32i, target_address_space(4)>
