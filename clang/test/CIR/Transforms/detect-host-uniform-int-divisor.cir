// -----

// The ticket's actual case (CMPLRLLVM-76652): a named FUNCTOR, `c = lid / C_`
// with `C_` a captured `unsigned`. A named functor closure is NOT
// TU-local/optimizable (it is launchable from other TUs), yet the remark still
// fires -- a diagnostic is sound cross-TU. Modeled in the post-inline /
// post-mem2reg shape CIRGen + the combine produce: the divisor is a load of the
// closure field `C_` (an address-space-cast closure pointer, as after
// operator() is inlined and the `this` slot promoted).

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!u64i = !cir.int<u, 64>
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_fun = !cir.struct<"MyFunctor" {data !u32i, data !cir.ptr<!s32i, target_address_space(4)>}>
!rec_hkrbase = !cir.struct<"hkrbase" {data !u64i}>
!rec_hkr = !cir.struct<"hkr" {data !rec_hkrbase, data !cir.ptr<!rec_fun>}>
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global "private" constant cir_private @".str" = #cir.const_array<"_ZTS9MyFunctor" : !cir.array<!s8i x 14>, trailing_zeros> : !cir.array<!s8i x 15>
    cir.global "private" constant internal @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE = #cir.const_record<{#cir.const_record<{#cir.global_view<@".str"> : !cir.ptr<!s8i>, #cir.int<14> : !u64i}> : !rec_sv}> : !rec_ctki
    cir.func private @_ZN4sycl3_V16detail13HostKernelRefC2E(!cir.ptr<!rec_hkr>, !cir.ptr<!rec_fun>)
    cir.func private @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>)
    cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() -> !cir.ptr<!s8i> {
      %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE : !cir.ptr<!rec_ctki>
      %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
    cir.func @main(%ev: !cir.ptr<!s8i>, %q: !cir.ptr<!s8i>, %geom: !cir.ptr<!s8i>, %c: !u32i) {
      %fun = cir.alloca "MyFunctor" align(8) : !cir.ptr<!rec_fun>
      %hkr = cir.alloca "hkr" align(8) : !cir.ptr<!rec_hkr>
      %fc = cir.get_member %fun[0] {name = "C_"} : !cir.ptr<!rec_fun> -> !cir.ptr<!u32i>
      cir.store %c, %fc : !u32i, !cir.ptr<!u32i>
      cir.call @_ZN4sycl3_V16detail13HostKernelRefC2E(%hkr, %fun) : (!cir.ptr<!rec_hkr>, !cir.ptr<!rec_fun>) -> ()
      %base = cir.base_class_addr nonnull %hkr [0] : !cir.ptr<!rec_hkr> -> !cir.ptr<!rec_hkrbase>
      %dki = cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() : () -> !cir.ptr<!s8i>
      cir.call @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(%ev, %q, %geom, %base, %dki) : (!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>) -> ()
      cir.return
    }
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func private @get_local_id(!s32i) -> !u64i
