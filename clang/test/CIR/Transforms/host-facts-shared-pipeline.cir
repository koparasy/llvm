// The container passes share one points-to analysis and one
// KernelBindingTable (SYCLHostFactsCache), kept across the passes that change
// the container: the noalias pass stamps the kernels, then the constant pass
// and the noalias pass run again on the table and the facts built before the
// stamps. They must give what each pass gives on a fresh analysis and table
// of the changed IR. (Until T28 the noalias pass also specialized a kernel by
// clone here, a copy of a copy on the second run; that path is deleted.)
//
// RUN: cir-opt %S/infer-kernel-param-noalias-accessor.cir --remarks-filter="cir-offload.*" -split-input-file \
// RUN:   -pass-pipeline="builtin.module(cir-offload-infer-kernel-param-noalias{host-facts=ipo host-facts-closed-tu=1},cir-offload-propagate-sycl-kernel-args{host-facts=ipo host-facts-closed-tu=1},cir-offload-infer-kernel-param-noalias{host-facts=ipo host-facts-closed-tu=1})" \
// RUN:   -o %t.shared.cir 2> %t.shared.log
// RUN: cir-opt %S/infer-kernel-param-noalias-accessor.cir --remarks-filter="cir-offload.*" -split-input-file \
// RUN:   -cir-offload-infer-kernel-param-noalias='host-facts=ipo host-facts-closed-tu=1' -o %t.1.cir 2> %t.1.log
// RUN: cir-opt %t.1.cir --remarks-filter="cir-offload.*" -split-input-file -cir-offload-propagate-sycl-kernel-args='host-facts=ipo host-facts-closed-tu=1' \
// RUN:   -o %t.2.cir 2> %t.2.log
// RUN: cir-opt %t.2.cir --remarks-filter="cir-offload.*" -split-input-file -cir-offload-infer-kernel-param-noalias='host-facts=ipo host-facts-closed-tu=1' \
// RUN:   -o %t.fresh.cir 2> %t.3.log
// RUN: diff %t.shared.cir %t.fresh.cir
// RUN: cat %t.1.log %t.2.log %t.3.log | grep 'remark:' | sed 's/^.*remark:/remark:/; s/, RemarkId=[0-9]*//' | sort > %t.fresh.log
// RUN: grep 'remark:' %t.shared.log | sed 's/^.*remark:/remark:/; s/, RemarkId=[0-9]*//' | sort | diff - %t.fresh.log
// RUN: FileCheck %s --input-file=%t.shared.log
// The second noalias run sees the stamps of the first (so the checks above
// are not vacuous).
// CHECK: kernel @_Z9accKernelv arg 0 (accessor 'A'): noalias (buffer 'ba'
// CHECK: kernel @_Z9accKernelv arg 0 (accessor 'A'): already noalias
//
// One analysis and one table for the three passes (the statistics of the
// first split chunk with a container).
// RUN: cir-opt %S/infer-kernel-param-noalias-accessor.cir -split-input-file -mlir-pass-statistics \
// RUN:   -pass-pipeline="builtin.module(cir-offload-infer-kernel-param-noalias{host-facts=ipo host-facts-closed-tu=1},cir-offload-propagate-sycl-kernel-args{host-facts=ipo host-facts-closed-tu=1},cir-offload-infer-kernel-param-noalias{host-facts=ipo host-facts-closed-tu=1})" \
// RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=STATS
// STATS: (S) 1 host-facts-analyses-built
// STATS-NEXT: (S) 1 host-facts-tables-built
// STATS-NEXT: OffloadPropagateSYCLKernelArgs
// STATS-NEXT: (S) 0 host-facts-analyses-built
// STATS-NEXT: (S) 0 host-facts-tables-built
// STATS-NEXT: OffloadInferKernelParamNoAlias
// STATS-NEXT: (S) 0 host-facts-analyses-built
// STATS-NEXT: (S) 0 host-facts-tables-built
