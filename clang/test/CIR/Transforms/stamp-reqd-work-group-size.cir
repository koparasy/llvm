// RUN: cir-opt %s -split-input-file \
// RUN:   -pass-pipeline="builtin.module(cir-offload-stamp-reqd-work-group-size)" \
// RUN:   | FileCheck %s

// A TU-local SYCL kernel launched only through a constant nd_range gets its
// local work-group size stamped onto the device spir_kernel as a natural-order
// `cir.reqd_work_group_size` attribute. The SYCL-shaped reversal/padding is
// applied later at LLVM lowering, so the attribute stays in {X,Y,Z} order.

!s8i = !cir.int<s, 8>
!u64i = !cir.int<u, 64>
!rec_arr = !cir.struct<"arr" {data !cir.array<!u64i x 1>}>
!rec_range = !cir.struct<"range" {data !rec_arr}>
!rec_ndr = !cir.struct<"ndr" {data !rec_range, data !rec_range, data !rec_range}>
!rec_view = !cir.struct<"view" {data !cir.ptr<!u64i>, data !cir.ptr<!u64i>, data !cir.ptr<!u64i>, data !u64i}>
