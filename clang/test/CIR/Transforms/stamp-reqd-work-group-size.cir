// RUN: cir-opt %s --remarks-filter=cir-offload-reqd-wg \
// RUN:   -cir-offload-stamp-reqd-work-group-size -o %t.open.cir 2>&1 \
// RUN:   | FileCheck %s --check-prefix=OPEN
// RUN: FileCheck %s --check-prefixes=IR,IR-OPEN --input-file=%t.open.cir
// RUN: cir-opt %s --remarks-filter=cir-offload-reqd-wg \
// RUN:   -cir-offload-stamp-reqd-work-group-size='host-facts-closed-tu=1' \
// RUN:   -o %t.closed.cir 2>&1 | FileCheck %s --check-prefix=CLOSED
// RUN: FileCheck %s --check-prefixes=IR,IR-CLOSED --input-file=%t.closed.cir
// RUN: cir-opt %s -cir-offload-stamp-reqd-work-group-size='host-facts=none' \
// RUN:   | FileCheck %s --check-prefix=NONE
//
// A SYCL kernel whose launches all use one compile-time-constant nd_range
// local size gets it stamped onto the device spir_kernel as a natural-order
// `cir.reqd_work_group_size` attribute (the SYCL-shaped reversal/padding is
// applied later at LLVM lowering). The geometry is SYCLHostFacts' (the
// stored-value queries of the points-to analysis). The container is the one
// cir-offload-merge --cir-offload-host-facts=none builds (mem2reg and SCCP,
// no fact applied) from this source, compiled with the canary mock of
// CodeGenSYCL/Inputs/combine-canary-mock.h (T28; until then this test's
// hand-written fixtures were read by the deleted legacy trace):
//
//   inline void shared(queue &q, int *p) {        // KS: one closure type
//     q.submit([&](handler &h) {                  // for every TU
//       h.parallel_for<KS>(nd_range<1>(range<1>(1024), range<1>(256)), ...);
//     });
//   }
//   int main(int argc, char **) {
//     ... parallel_for<KC>(nd_range<1>(range<1>(1024), range<1>(256)), ...);
//     ... parallel_for<KR>(range<1>(1024), ...);    // no local size
//     unsigned long l = argc;
//     ... parallel_for<KV>(nd_range<1>(range<1>(1024), range<1>(l)), ...);
//     shared(q, p);
//   }
//
//  - KC (a lambda in main: TU-unique): [256], in place;
//  - KR (a plain range launch) and KV (a runtime local size): nothing;
//  - KS (a lambda in an inline function, one weak_odr kernel for every TU):
//    not stamped without closed-TU (another TU may launch it with another
//    local size; the internalized launch path's copy would get it), stamped
//    in place under closed-TU (every launch of a kernel that is not
//    registered is this TU's).
//
// OPEN-DAG: reqd-work-group-size: kernel @_ZTS2KS [256] not stamped (the kernel is visible to other TUs; facts this TU derives hold only through an internalized launch path, and launch-path internalization is off)
// OPEN-DAG: Remark="reqd-work-group-size: kernel @_ZTS2KC [256]"
// OPEN-NOT: kernel @_ZTS2KR
// OPEN-NOT: kernel @_ZTS2KV
// CLOSED-DAG: Remark="reqd-work-group-size: kernel @_ZTS2KS [256]"
// CLOSED-DAG: Remark="reqd-work-group-size: kernel @_ZTS2KC [256]"
// CLOSED-NOT: not stamped
//
// IR-OPEN: cir.func {{.*}}@_ZTS2KS({{.*}}) cc(spir_kernel)
// IR-OPEN-NOT: cir.reqd_work_group_size
// IR-OPEN-SAME: {
// IR-CLOSED: cir.func {{.*}}@_ZTS2KS({{.*}}) cc(spir_kernel) attributes {{{.*}}cir.reqd_work_group_size = [256 : i32]
// IR: cir.func {{.*}}@_ZTS2KC({{.*}}) cc(spir_kernel) attributes {{{.*}}cir.reqd_work_group_size = [256 : i32]
// IR: cir.func {{.*}}@_ZTS2KR({{.*}}) cc(spir_kernel)
// IR-NOT: cir.reqd_work_group_size
// IR-SAME: {
// IR: cir.func {{.*}}@_ZTS2KV({{.*}}) cc(spir_kernel)
// IR-NOT: cir.reqd_work_group_size
// IR-SAME: {
//
// NONE-NOT: cir.reqd_work_group_size

