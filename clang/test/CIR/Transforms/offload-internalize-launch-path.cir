// IR: cir.func no_inline internal private @_Z4run1RN4sycl3_V15queueEPfS3_S3_.int({{.*}}cir.offload.internalized = "_Z4run1RN4sycl3_V15queueEPfS3_S3_"
// IR: cir.call @_ZN4sycl3_V15queue6submitIZ4run1RS1_PfS4_S4_EUlRNS0_7handlerEE_EENS0_5eventET_.int(
// The cgfo.ctor copy stores the address of the invoker copy.
// IR: cir.func no_inline alignment(2) internal private @_ZN4sycl3_V16detail19type_erased_cgfo_tyC2IZ4run1RNS0_5queueEPfS6_S6_EUlRNS0_7handlerEE_EERT_.int(
// IR: cir.get_global @_ZN4sycl3_V16detail19type_erased_cgfo_ty7invokerIZ4run1RNS0_5queueEPfS6_S6_EUlRNS0_7handlerEE_E4callEPKvS8_.int {{.*}}cir.offload.internalized_edge
