// IR: cir.func no_inline alignment(2) internal private @_ZN4sycl3_V17handler19setDeviceKernelInfoI2K1EEvPv.int(
// IR: cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoI2K1EERNS1_16DeviceKernelInfoEv.int() {cir.offload.internalized_edge = "_ZN4sycl3_V16detail19getDeviceKernelInfoI2K1EERNS1_16DeviceKernelInfoEv"}
