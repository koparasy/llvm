// IR: cir.call @_Z4run1RN4sycl3_V15queueEPfS3_S3_.int({{.*}}cir.offload.internalized_edge = "_Z4run1RN4sycl3_V15queueEPfS3_S3_"
// IR: %[[FN:[0-9]+]] = cir.load align(8) %{{[0-9]+}} : !cir.ptr<!cir.ptr<!cir.func<(!cir.ptr<!rec_Runner>
// IR: %[[GO:[0-9]+]] = cir.get_global @_ZN2R32goERN4sycl3_V15queueE
// IR: %[[GOCAST:[0-9]+]] = cir.cast bitcast %[[GO]]
// IR: %[[SAME:[0-9]+]] = cir.cmp eq %[[FN]], %[[GOCAST]]
// IR: cir.if %[[SAME]] {
// IR: cir.call @_ZN2R32goERN4sycl3_V15queueE.int(
// IR: } else {
// IR: cir.call %[[FN]](
// IR: } {cir.offload.internalized_guard = "_ZN2R32goERN4sycl3_V15queueE"}
// IR: cir.call @_Z4run4RN4sycl3_V15queueEPfS3_.int(
// IR: cir.call @_Z4run6RN4sycl3_V15queueEPfS3_.int({{.*}}cir.offload.internalized_edge = "_Z4run6RN4sycl3_V15queueEPfS3_"
// IR: cir.get_global @_Z5body5Pv
// IR: cir.call @_Z12pool_enqueuePFvPvES_(

// The originals stay (other TUs may call them) and keep their callees; the
// copies are internal, next to them, and call copies.
