// RUN: cir-opt %s -cir-offload-internalize-launch-paths='host-facts=ipo' \
// RUN:   -o %t.int.cir 2>&1 | FileCheck %s --check-prefix=REMARK
// RUN: FileCheck %s --check-prefix=IR --input-file=%t.int.cir
// RUN: FileCheck %s --check-prefix=SYMS --input-file=%t.int.cir
// RUN: FileCheck %s --check-prefix=NOCOPY --input-file=%t.int.cir
//
// The host-facts passes on the internalized container, then the prune.
// RUN: cir-opt %s -pass-pipeline="builtin.module(cir-offload-internalize-launch-paths{host-facts=ipo},cir-offload-stamp-reqd-work-group-size{host-facts=ipo host-facts-internalize=1},cir-offload-infer-kernel-param-noalias{host-facts=ipo host-facts-internalize=1},cir-offload-propagate-sycl-kernel-args{host-facts=ipo host-facts-internalize=1},cir-offload-prune-internalized-launch-paths)" \
// RUN:   -o %t.out.cir 2>&1 | FileCheck %s --check-prefix=FACTS
// RUN: FileCheck %s --check-prefix=PRUNED --input-file=%t.out.cir
//
// Without internalization (open mode as before T26) nothing is proven; the
// budget; closed-TU (the pass does nothing); legacy host facts (T26b: only
// kernels with a launch the legacy trace gives a fact for, none here: the
// fixture's reduced headers do not have the shapes the trace reads).
// RUN: cir-opt %s -cir-offload-infer-kernel-param-noalias='host-facts=ipo' \
// RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=OPEN
// RUN: cir-opt %s -pass-pipeline="builtin.module(cir-offload-internalize-launch-paths{host-facts=ipo max-functions=5},cir-offload-infer-kernel-param-noalias{host-facts=ipo host-facts-internalize=1},cir-offload-prune-internalized-launch-paths)" \
// RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=BUDGET
// RUN: cir-opt %s -cir-offload-internalize-launch-paths='host-facts=ipo host-facts-closed-tu=1' \
// RUN:   2>&1 | FileCheck %s --check-prefix=NONE
// RUN: cir-opt %s -cir-offload-internalize-launch-paths 2>&1 \
// RUN:   | FileCheck %s --check-prefixes=LEGACY,NONE

// Launch-path internalization (T26, plan 2.8). Every launch below sits in a
// function another TU can call (inline, so linkonce_odr: run1, R3::go,
// run4, run6, queue::submit<L>, the CGF lambda, the cgfo invoker,
// handler::parallel_for<K, KL>, ...), so in open mode the points-to
// analysis gives their formals Incomplete (UnknownCaller) and no fact holds.
// The pass copies, from main (a closed root: C++20 [basic.start.main]p3),
// every such function on a path to a kernel.info marker as an internal copy,
// redirects the path to the copies, and specializes the kernel the copies'
// markers name as K.int.<module id> with internal host artifacts. The
// analysis then sees the copies' callers (localFunctionsClosed), so the
// facts derived from main's objects hold for the copy of the kernel, and the
// original kernel, which other TUs' calls of the originals launch, keeps
// none.
//  - K1 (P): run1(q, a1, b1, c1) from main, through queue::submit's cgfo
//    invoker: the cgfo.ctor copy stores the invoker copy's address (vouched:
//    the runtime only calls it). Three distinct USM allocations: noalias.
//  - K2 (N, corpus T27 N): run2 is called only by the external entry2: no
//    closed root reaches it. Not internalized, nothing proven.
//  - K3 (virtual call): `Runner *p = &r; p->go(q)` in main becomes a guarded
//    direct call `fn == &R3::go ? R3::go.int(p, q) : fn(p, q)`. Internalized,
//    but the facts stay blocked: the else branch reaches the original
//    R3::go, whose CGF invoker call is unresolved (its Function node is
//    Incomplete through the original cgfo.ctor's own graph, an open function
//    with an Incomplete `this`), and its unknown-call rule reaches main's
//    allocations. The original is not proven under closed-TU either.
//  - K4 (P, std::thread): run4 starts a thread whose lambda submits the
//    kernel; the copy of the std::thread constructor calls copies of the
//    _State_impl constructors, the base one storing a copy of the vtable
//    whose _M_run slot is the copy of _M_run. Buffers over main's host
//    allocations: noalias (closed-TU alone does not prove it: there the
//    state's vtable node is Incomplete through the open constructor).
//  - K5 (N): body5's address goes to pool_enqueue, code we don't see that
//    calls it: an unredirectable edge, not internalized.
//  - K6 (P): `void (*fp)(...) = &run6; fp(...)`: after mem2reg the callee is
//    the address of run6, so the call becomes a direct call of its copy.
// The budget run (max-functions=5) internalizes nothing, with a remark.
// Closed-TU or legacy: the pass does nothing.
//
// The input is generated by /localdisk3/kparasyr/ipo-aa/t26/tests/gen.sh from
// internalize.cpp (clang -cc1 -fclangir host and device CIR of the reduced
// SYCL API of CodeGenSYCL/Inputs/combine-canary-mock.h and a reduced
// libstdc++ std::thread, combined by cir-offload-merge in legacy mode, which
// recovers nothing here: mem2reg and sccp only):
//
//   inline void run1(queue &q, float *a, float *b, float *c) {
//     q.submit([&](handler &h) { h.parallel_for<K1>(range<1>(64), [=](id<1> i) { c[i[0]] = a[i[0]] + b[i[0]]; }); });
//   }
//   inline void run2(queue &q, float *a, float *b) { ... K2 ... }
//   void entry2(queue &q) { run2(q, malloc_shared<float>(64, q), malloc_shared<float>(64, q)); }
//   struct Runner { virtual void go(queue &q) = 0; };
//   struct R3 : Runner { float *a, *b; void go(queue &q) override { ... K3 on a, b ... } };
//   inline void run4(queue &q, float *ha, float *hb) {
//     buffer<float, 1> A(ha, range<1>(64)), B(hb, range<1>(64));
//     std::thread t([&] { q.submit([&](handler &h) { ... K4 on A, B accessors ... }); });
//     t.join();
//   }
//   inline void run6(queue &q, float *a, float *b) { ... K6 ... }
//   struct Task5 { queue *q; float *a, *b; };
//   void pool_enqueue(void (*task)(void *), void *arg);
//   inline void body5(void *p) { ... K5 on ((Task5 *)p)->a, b ... }
//   int main() {
//     queue q;
//     run1(q, malloc_shared<float>(64, q) x3);
//     R3 r; r.a = ...; r.b = ...; Runner *p = &r; p->go(q);
//     run4(q, malloc_host<float>(64, q), malloc_host<float>(64, q));
//     void (*fp)(queue &, float *, float *) = &run6; fp(q, ...);
//     Task5 t5{&q, ...}; pool_enqueue(&body5, &t5);
//   }

// REMARK-DAG: remark: launch-path-internalization: kernel @_ZTS2K2 not internalized (no closed root (main, a dynamic initializer) reaches it)
// REMARK-DAG: remark: launch-path-internalization: kernel @_ZTS2K5 not internalized (it is reached from a closed root only through the address of @_Z5body5Pv taken in @main, which code we don't see may call or compare)
// REMARK-DAG: remark: launch-path-internalization: kernel @_ZTS2K1 -> @_ZTS2K1.int.[[ID:[0-9a-f]+]] for 1 launch marker through the internalized launch path from root @main
// REMARK-DAG: remark: launch-path-internalization: kernel @_ZTS2K3 -> @_ZTS2K3.int.[[ID]] for 1 launch marker through the internalized launch path from root @main
// REMARK-DAG: remark: launch-path-internalization: kernel @_ZTS2K4 -> @_ZTS2K4.int.[[ID]] for 1 launch marker through the internalized launch path from root @main
// REMARK-DAG: remark: launch-path-internalization: kernel @_ZTS2K6 -> @_ZTS2K6.int.[[ID]] for 1 launch marker through the internalized launch path from root @main
// REMARK-DAG: remark: launch-path-internalization: 4 kernels specialized, 42 function copies ({{[0-9]+}} ops), 0 clean in place, 1 guarded calls, 1 vtable copies; 0 kernels over budget

// main calls the copies: run1, the guarded virtual call, run4 and run6 (the
// function pointer call made direct); body5's address still goes to the
// pool.
