      cir.store %vf, %ff : !s32i, !cir.ptr<!s32i>
      %vc = cir.load %scoeff : !cir.ptr<!s32i>, !s32i
      %fc = cir.get_member %clos[1] {name = "coeff"} : !cir.ptr<!rec_lam> -> !cir.ptr<!s32i>
