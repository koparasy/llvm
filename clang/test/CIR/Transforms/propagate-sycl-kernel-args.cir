// Disagreeing launch sites: the coefficient is 7 at both sites (agreed ->
// propagated), but the flag is 1 at one site and 2 at the other (disagreement
// -> dropped from the agreed set). The pass therefore substitutes coeff but
// leaves flag as the block argument.

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
