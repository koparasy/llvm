// -----

// Non-TU-local kernel: a genuine named functor closure (spellable type,
// launchable from other TUs) stays conservative even though the same-shaped
// lambda case would propagate. The captures are compile-time constants on the
// host, but the binding is not TU-local, so NOTHING is propagated: every
// parameter is still the block argument. The only change from the first case is
// the kernel's mangled name and closure type.

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!rec_sv = !cir.struct<"sv" {data !cir.ptr<!s8i>, data !u64i}>
!rec_ctki = !cir.struct<"ctki" {data !rec_sv}>
!rec_lam = !cir.struct<"lam" {data !s32i, data !s32i, data !s32i}>
!rec_hkrbase = !cir.struct<"hkrbase" {data !u64i}>
