    }
    cir.func @site_a(%ev: !cir.ptr<!s8i>, %q: !cir.ptr<!s8i>, %geom: !cir.ptr<!s8i>) {
      %lam = cir.alloca "lam" align(8) : !cir.ptr<!rec_lam>
