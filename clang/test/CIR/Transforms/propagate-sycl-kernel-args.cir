    cir.func private @_ZN4sycl3_V16detail13HostKernelRefC2E(!cir.ptr<!rec_hkr>, !cir.ptr<!rec_lam>)
    cir.func private @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>)
    cir.func internal @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() -> !cir.ptr<!s8i> {
      %0 = cir.get_global @_ZN4sycl3_V16detail21CompileTimeKernelInfoIZ4mainEUlvE_EE : !cir.ptr<!rec_ctki>
      %1 = cir.const #cir.ptr<null> : !cir.ptr<!s8i>
      cir.return %1 : !cir.ptr<!s8i>
    }
    cir.func @main(%ev: !cir.ptr<!s8i>, %q: !cir.ptr<!s8i>, %geom: !cir.ptr<!s8i>, %flag: !s32i, %coeff: !s32i, %n: !s32i) {
      %lam = cir.alloca "lam" align(8) : !cir.ptr<!rec_lam>
      %hkr = cir.alloca "hkr" align(8) : !cir.ptr<!rec_hkr>
      %fflag = cir.get_member %lam[0] {name = "flag"} : !cir.ptr<!rec_lam> -> !cir.ptr<!s32i>
      cir.store %flag, %fflag : !s32i, !cir.ptr<!s32i>
      %fcoeff = cir.get_member %lam[1] {name = "coeff"} : !cir.ptr<!rec_lam> -> !cir.ptr<!s32i>
      cir.store %coeff, %fcoeff : !s32i, !cir.ptr<!s32i>
      %fn = cir.get_member %lam[2] {name = "n"} : !cir.ptr<!rec_lam> -> !cir.ptr<!s32i>
      cir.store %n, %fn : !s32i, !cir.ptr<!s32i>
      cir.call @_ZN4sycl3_V16detail13HostKernelRefC2E(%hkr, %lam) : (!cir.ptr<!rec_hkr>, !cir.ptr<!rec_lam>) -> ()
      %base = cir.base_class_addr nonnull %hkr [0] : !cir.ptr<!rec_hkr> -> !cir.ptr<!rec_hkrbase>
      %dki = cir.call @_ZN4sycl3_V16detail19getDeviceKernelInfoIZ4mainEUlvE_EEPv() : () -> !cir.ptr<!s8i>
      cir.call @_ZN4sycl3_V136submit_kernel_direct_with_event_implPvS_S_S_S_(%ev, %q, %geom, %base, %dki) : (!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!rec_hkrbase>, !cir.ptr<!s8i>) -> ()
      cir.return
    }
  }
  module @device_sycl_spir64 attributes {cir.offload.kind = #cir.offload<device>} {
    // CHECK-LABEL: cir.func @_ZTSZ4mainEUlvE_
    // CHECK: cir.cast int_to_bool %arg0
    // CHECK: cir.store %arg1, %arg3
