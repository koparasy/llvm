      %hkr = cir.alloca "hkr" align(8) : !cir.ptr<!rec_hkr>
      %f = cir.const #cir.int<2> : !s32i
      %c = cir.const #cir.int<7> : !s32i
      %ff = cir.get_member %lam[0] {name = "flag"} : !cir.ptr<!rec_lam> -> !cir.ptr<!s32i>
      cir.store %f, %ff : !s32i, !cir.ptr<!s32i>
